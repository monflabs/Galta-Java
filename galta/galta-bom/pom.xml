<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Bill of materials of the published Galta artifacts. Import it and declare
		the Galta modules without a version:

			<dependencyManagement>
				<dependencies>
					<dependency>
						<groupId>org.monflabs.galta</groupId>
						<artifactId>galta-bom</artifactId>
						<version>0.8.0</version>
						<type>pom</type>
						<scope>import</scope>
					</dependency>
				</dependencies>
			</dependencyManagement>

		It deliberately has NO parent: importing a BOM also imports the
		dependencyManagement of its parents, so inheriting monflabs-parent would
		push Monflabs' third-party version choices onto every consumer. Only the
		Galta artifacts are managed here; their own dependencies come with them.
		Keep the list in sync with the published modules (the ones not excluded by
		the central profile of the root pom).
	-->
	<groupId>org.monflabs.galta</groupId>
	<artifactId>galta-bom</artifactId>
	<version>${revision}</version>
	<packaging>pom</packaging>

	<name>Galta BOM</name>
	<description>Bill of materials of the Galta libraries: import it to use the Galta modules without declaring their versions.</description>
	<url>https://github.com/monflabs/Galta-Java</url>
	<inceptionYear>2019</inceptionYear>

	<organization>
		<name>Monflabs</name>
		<url>https://github.com/monflabs</url>
	</organization>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>priand</id>
			<name>Philippe Riand</name>
			<email>phil@riand.com</email>
			<organization>Monflabs</organization>
			<organizationUrl>https://github.com/monflabs</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/monflabs/Galta-Java.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/monflabs/Galta-Java.git</developerConnection>
		<url>https://github.com/monflabs/Galta-Java</url>
		<tag>HEAD</tag>
	</scm>

	<properties>
		<!-- Keep equal to the root pom's revision -->
		<revision>0.8.0</revision>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Utilities -->
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>utilities</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>test</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>filesystem</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>javacompiler</artifactId>
				<version>${revision}</version>
			</dependency>

			<!-- JSON -->
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>json</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>json-config</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>json-impexp</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>json-impexp-fastcsv</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>json-jsonpath-jayway</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>json-jsonschema-jsonschemafriend</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>json-memdb</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>json-jackson</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>json-yaml-snakeyaml</artifactId>
				<version>${revision}</version>
			</dependency>

			<!-- UI and playground -->
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>ui-commons</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>ui-swing</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>ui-swing-ide</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>playground-core</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>playground-ui-swing</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>playground-java</artifactId>
				<version>${revision}</version>
			</dependency>

			<!-- GaltaJS -->
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-debugger</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-template</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-precompiled-beautify-css</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-precompiled-beautify-html</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-precompiled-beautify-js</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-precompiled-typescript</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-vb</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-playground</artifactId>
				<version>${revision}</version>
			</dependency>

			<!-- Test support classes published as test-jars -->
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>filesystem</artifactId>
				<version>${revision}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js</artifactId>
				<version>${revision}</version>
				<type>test-jar</type>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- Without a parent, the flatten plugin (which resolves ${revision} in
			     the installed/deployed pom) is declared here with its version. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>1.8.0</version>
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Maven Central release (mvn clean deploy -P central from the root). This
		     BOM has no parent, so the profile of monflabs-parent is repeated here
		     with explicit plugin versions: keep them in sync with monflabs-parent. -->
		<profile>
			<id>central</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>false</autoPublish>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
