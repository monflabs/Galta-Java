<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.monflabs.galta</groupId>
		<artifactId>parent-utilities</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>utilities-tests</artifactId>
	<name>Galta Utilities Tests</name>
	<description>Test suites for the Galta utilities. Not published.</description>

	<properties>
		<!-- Not published: excluded from the Maven Central bundle (see the root pom central profile) -->
		<maven.deploy.skip>true</maven.deploy.skip>
		<maven.javadoc.skip>true</maven.javadoc.skip>
		<gpg.skip>true</gpg.skip>
	</properties>


	<!-- The tested libraries are compile dependencies (this module has no main code and is
	     not published) so the JaCoCo aggregate report covers them: report-aggregate ignores
	     the test-scoped dependencies -->
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>utilities</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<!-- The test classes as a test-jar: utilities-performance benchmarks the reference
			     double-to-text implementations of src/test/java (Rhino, Ryu, Harmony, cookjson) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/AllUtilTests.class</include>
						<include>**/AllUtilDocExamplesTests.class</include>
					</includes>
				</configuration>
			</plugin>
			<!-- This module only has tests: its own JaCoCo report would be empty ("No class
			     files specified"). Report the coverage of the library modules it tests instead,
			     in target/site/jacoco-aggregate (needs them in the reactor: -am or a full build). -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>report</id>
						<phase>none</phase>
					</execution>
					<execution>
						<id>report-aggregate</id>
						<phase>verify</phase>
						<goals>
							<goal>report-aggregate</goal>
						</goals>
						<configuration>
							<includeCurrentProject>true</includeCurrentProject>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>