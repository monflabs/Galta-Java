<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.monflabs.galta</groupId>
		<artifactId>parent-utilities</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>test</artifactId>
	<name>Galta Test Support</name>
	<description>Unit test support: golden-file (template) assertions, resource leak tracking and reflective access helpers for JUnit tests.</description>

	<dependencies>
		<!-- Compile-time null annotations (used in the sources): optional, so
		     they are not passed on to consumers -->
		<dependency>
			<groupId>org.eclipse.jdt</groupId>
			<artifactId>org.eclipse.jdt.annotation</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>json</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>json-config</artifactId>
		</dependency>

		<dependency>
			<groupId>net.bytebuddy</groupId>
			<artifactId>byte-buddy</artifactId>
		</dependency>
		<dependency>
			<groupId>net.bytebuddy</groupId>
			<artifactId>byte-buddy-agent</artifactId>
		</dependency>

	
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>provided</scope>
		</dependency>
		
		<!-- https://mvnrepository.com/artifact/com.h2database/h2 -->
		<dependency>
		    <groupId>com.h2database</groupId>
		    <artifactId>h2</artifactId>
		    <scope>test</scope>
		</dependency>
		
		<!-- Used directly by this module (was only present transitively) -->
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>utilities</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/AllTests.class</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>