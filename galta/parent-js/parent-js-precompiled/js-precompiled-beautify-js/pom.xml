<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.monflabs.galta</groupId>
		<artifactId>parent-js-precompiled</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>js-precompiled-beautify-js</artifactId>
	<name>GaltaJS Precompiled js-beautify</name>
	<description>js-beautify JavaScript formatter, transpiled to Java with GaltaJS.</description>



	<dependencies>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>js</artifactId>
		</dependency>
		
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>test</artifactId>
			<scope>test</scope>
		</dependency>		
		
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>js-debugger</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>filesystem</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Used directly by this module (was only present transitively) -->
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>utilities</artifactId>
		</dependency>
	</dependencies>
	
	<build>
		<plugins>
			<plugin>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-transpiler-maven</artifactId>
				<executions>
					<execution>
						<id>generate</id>
						<goals>
							<goal>generate-sources</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<sourceDirectory>${basedir}/js</sourceDirectory>
					<jsPackage>org.monflabs.galtajs.precompiled.beautifyjs</jsPackage>
					<includes>
					    <include>**/*.js</include>
					</includes>
				</configuration>
				<!-- The plugin adds its output directory to the compile source roots
				     itself: no build-helper add-source needed -->
			</plugin>
		</plugins>
	</build>	
</project>

