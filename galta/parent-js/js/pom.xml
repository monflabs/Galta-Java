            <!-- https://stackoverflow.com/questions/14722873/sharing-src-test-classes-between-modules-in-a-multi-module-maven-project --> 
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Generates JSParser.java (+ support classes) from
			     src/main/javacc/.../JSParser.jj into
			     target/generated-sources/javacc, bound to the standard
			     generate-sources phase - editing the .jj and running
			     `mvn install` now regenerates the parser automatically, no
			     manual step. https://mvnrepository.com/artifact/org.codehaus.mojo/javacc-maven-plugin -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>javacc-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>javacc</goal>
						</goals>
					</execution>
				</executions>
				<!-- The javacc engine version is pinned in monflabs-parent's
				     pluginManagement (javacc.version): the plugin's own default
				     may differ and could change the generated parser subtly. -->
			</plugin>

			<!-- javacc-maven-plugin registers target/generated-sources/javacc
			     as a compile source root itself, which the Maven CLI honours
			     automatically - but m2e has no bundled connector for this
			     plugin, so Eclipse never runs it (or learns about that
			     folder) on its own, leaving generated types like Token
			     unresolved in the IDE even though `mvn install` is fine.
			     build-helper-maven-plugin's add-source goal is one m2e
			     supports natively, so this registers the same folder
			     explicitly for Eclipse's benefit (harmless, redundant with
			     javacc-maven-plugin's own registration, for the CLI build). -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-source-javacc</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/javacc</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- TokenMgrError.java is the ONE javacc-generated support file
			     GaltaJS hand-customizes (adds public errorLine/errorColumn
			     fields) - kept as a normal, hand-maintained source file in
			     src/main/java/.../parser/ instead of being regenerated.
			     javacc-maven-plugin has no per-file exclusion, so it always
			     emits ITS OWN vanilla TokenMgrError.java alongside
			     JSParser.java above; left alone, that would collide with
			     the hand-maintained one as a duplicate class. Deleting the
			     generated copy here (after javacc's own generate-sources
			     execution above, before compile) leaves exactly one copy -
			     the hand-maintained one - for javac to see. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>remove-generated-tokenmgrerror</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<delete file="${project.build.directory}/generated-sources/javacc/org/monflabs/galtajs/parser/TokenMgrError.java"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>