	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<configuration>
					<filesets>
						<fileset>
							<directory>${project.basedir}/src/test/java/compiled</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/AllGaltaJSTests.class</include>
						<include>**/AllDocExamplesTests.class</include>
					</includes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
	            <configuration>
	                <excludes>
	                    <exclude>**/compiled/*</exclude>
	                </excludes>
	                <!-- Transpiled test output saved under src/test/java/compiled/ for
	                     inspection only: never compiled by the build itself -->
	                <testExcludes>
	                    <testExclude>**/compiled/*</testExclude>
	                </testExcludes>
	             </configuration>
            </plugin>
            
