/*****************************************
 * ECMA SYNTACTIC GRAMMARS  STARTS HERE  *
 *****************************************/   

/* Section 11.1: Primary Expressions */

ASTNode PrimaryExpression():
{
	Token t;
 	ASTNode node;
}
{
      t="this"
      	{
      		return nodeFactory.createThis(t);
      	}
    | LOOKAHEAD(2) node=LiteralValue() 
    	{
    		return node;
      	}
    // A hand-written semantic LOOKAHEAD, not the production-reference
    // LOOKAHEAD(FunctionArrowHead()) this used to be: FunctionArrowHead()
    // was only ever a syntactic-trial mirror of these same two predicates,
    // and once the arrow's own return-type-tolerant scan inside
    // isArrowFunctionWithParens() needed to skip a "type" (a JAVACODE
    // production, per skipType()'s own doc comment), a production-reference
    // trial can no longer represent it - see insertSemiColon()'s identical,
    // already-documented gap. Removing the indirection sidesteps that
    // entirely: FunctionArrowHead() is now unused and deleted.
    |  LOOKAHEAD({isArrowFunctionWithIdentifier() || isArrowFunctionWithParens()}) node=FunctionArrowDeclaration()
     	{
     	  return node;
     	}
    // "async [no LineTerminator here] function" restriction (spec's
    // AsyncFunctionExpression production): with a LineTerminator between
    // "async" and "function", "async" must parse as a plain identifier
    // (Identifier() below) instead of the start of an
    // AsyncFunctionExpression - this is THE actual choice point where
    // "async function"/"async\nfunction" gets disambiguated (reached via
    // ExpressionStatement()->...->PrimaryExpression() for a bare
    // ExpressionStatement starting with "async": ExpressionStatement()'s
    // own default per-token dispatch always tries first whenever the
    // current token is ASYNC, since ASYNC legitimately starts some
    // expression either way, so a guard on the Statement()-level
    // FunctionDeclaration() alternative alone is never reached and can't
    // fix this - it must live here). Reuses the existing
    // noLineTerminatorAfterAsync() helper already used for the
    // async-arrow-function forms above.
    | LOOKAHEAD(("async")? "function", {getToken(1).kind!=ASYNC || noLineTerminatorAfterAsync()}) node=FunctionDeclaration()
    	{
    	  return node;
    	}
    | node=ArrayLiteral()
    	{
    		return node;
      	}
    | node=ObjectLiteral()
    	{
    		return node;
      	}
    | t="(" node=Expression() ")"
    	{
   	      	return nodeFactory.createParen(t,node);
      	}
    | node=TemplateLiteral(null)
        {
            return node;
        }
    // Both this alternative and Identifier() below can start with "@" - a
    // decorated class expression ("@decorator class {}") vs. the bare "@"
    // filter-context identifier (which - per its own established usage - is
    // always immediately followed by "." for a member access, never able to
    // syntactically continue as a DecoratorList()). Syntactic lookahead
    // resolves this: try DecoratorList() followed by "class" first: it fails
    // fast for bare "@." (LeftHandSideExpression can't start with "."),
    // correctly falling through to plain Identifier() for the filter-context
    // case, and succeeds for an actual decorated class expression - this
    // alternative must come BEFORE Identifier() so its more specific lookahead
    // gets first refusal (JavaCC otherwise takes the first alternative whose
    // default single-token check matches, without trying later ones).
    | LOOKAHEAD(DecoratorList() "class") node=ClassDeclaration()
        {
            return node;
        }
    | node=Identifier()
    	{
    		return node;
      	}
}


/* Section 7.8: Literals */

ASTNode LiteralValue(): {
    ASTNode node=null;
 	Token t;
}
{
   t=<DECIMAL_LITERAL> 
    	{
    	  	try { 
    			return nodeFactory.createLiteral(t,ASTLiteral.parseDecimal(env,t.image));
    		} catch(JSException e) {
    		  throw generateParseException(e);
    		} 
    	}
  |  (t=<DEC_INTEGER_LITERAL>
  	 |t=<HEX_INTEGER_LITERAL>
  	 |t=<OCT_INTEGER_LITERAL>
     |t=<BIN_INTEGER_LITERAL>)
    	{
    	  	try {
    			boolean[] legacyOctal = new boolean[1];
    			ASTLiteral lit = nodeFactory.createLiteral(t,ASTLiteral.parseInteger(env,t.image,legacyOctal));
    			lit.setLegacyOctalLiteral(legacyOctal[0]);
    			return lit;
    		} catch(JSException e) {
    		  throw generateParseException(e);
    		}
    	}
  |	t=<STRING_LITERAL>
  		{
    		ASTLiteral lit = nodeFactory.createLiteral(t,ASTLiteral.parseString(t.image));
    		lit.setLegacyOctalLiteral(ASTLiteral.hasLegacyEscape(t.image));
    		return lit;
		}
  | t=<BOOLEAN_LITERAL> 
    	{ 
      		return nodeFactory.createLiteral(t,ASTLiteral.parseBoolean(t.image)); 
      	}
  | t=<NULL_LITERAL>
		{ 
    		return nodeFactory.createLiteral(t,null); 
    	}
  | t=<REGULAR_EXPRESSION_LITERAL>
		{
    		return nodeFactory.createRegExpLiteral(t,t.image); 
		}
}


ASTStringTemplate TemplateLiteral(ASTNode tagFunction): {
    Token t,t1,t2;
    ASTNode node;
    List<Object> parts = new ArrayList<>();
}
{
    t1=<TEMPLATE_START>
    (
          t=<TEMPLATE_CHARS> {
            if(parts.isEmpty() || !(parts.get(parts.size()-1) instanceof String)) {
              parts.add(t.image);
            } else {
              String last = (String) parts.get(parts.size()-1);
              parts.set(parts.size()-1, last + t.image);
            }
          }
        | t=<TEMPLATE_DOLLAR_NOT_LBRACE> {
            if(parts.isEmpty() || !(parts.get(parts.size()-1) instanceof String)) {
              parts.add(t.image);
            } else {
              String last = (String) parts.get(parts.size()-1);
              parts.set(parts.size()-1, last + t.image);
            }
          }
        | <TEMPLATE_EXPR_START> node=Expression() <RBRACE> { parts.add(node); }
    )*
    t2=<TEMPLATE_END>
    {
        return nodeFactory.createStringTemplate(t1,t2,tagFunction,parts);
    }
}

ASTNode Identifier(): {
  Token t;
}
{
  	// A bare "@" (the GaltaJS "current filter context" reference, e.g.
  	// `@.xxx` inside a `?[]` filter expression) used to be lexed as a
  	// one-character IDENTIFIER_NAME - now that "@" is its own token (needed
  	// so `@decorator` can be recognized as decorator syntax rather than a
  	// single identifier), it's matched directly here instead.
  	t=<AT>
  		{
      		return nodeFactory.createIdentifierFilter(t);
  		}
  | 	t=Identifier_Name()
  		{
        	return nodeFactory.createIdentifier(t,bindingIdentifier(t));
		}
}


/* Section 11.1.4: Array Initializer */

ASTArrayLiteral ArrayLiteral(): {
	ASTArrayLiteral node;
 	Token t,t2;
}
{
    t="[" {node = nodeFactory.createArrayLiteral(t);} 
		(
		   LOOKAHEAD("]") t2="]" { return node.endToken(t2); }
		 | ElementList(node) t2="]" { return node.endToken(t2); }
		)
}

void ElementList(ASTArrayLiteral node): {
}
{
    ElementEntry(node) ("," {node.markComma();} ElementEntry(node) )* 
}

void ElementEntry(ASTArrayLiteral node): {
    Token t=null;
 	ASTNode n, n2=null;
}
{
     LOOKAHEAD({getToken(1).kind==YIELD && yieldReserved}) n=YieldOnlyExpression()
     	{
      		node.addExpression(n);
    	}
   | n=ConditionalExpression() ( LOOKAHEAD("=") t="=" n2=AssignmentExpression() )?
     	{
     	    if(n2!=null) {
     	       n=nodeFactory.createAssign(t,n,n2);
     	    }
      		node.addExpression(n);
    	}
   | "..." n=AssignmentExpression()
   		{
      		node.addSpread(n);
   		}
   |
  		{
   		  	// Only add empty slot for array holes [1,,3], not trailing commas [1,2,] or (a,b,)
			Token inputToken = getToken(1);
   		  	if(inputToken!=null && inputToken.kind==COMMA) {
      			node.addEmptySlot();
	 		}
  		}
}

// A formal-parameter list: structurally identical to ElementList/
// ElementEntry above (same shared node representation for a parameter
// list), except it also tolerates TypeScript's "?" optional-parameter
// marker and ": Type" annotations. Deliberately NOT folded into
// ElementList/ElementEntry itself (which ArrayLiteral() still uses,
// unchanged) - see FormalParameter()'s own doc comment for why.
void FormalParameterList(ASTArrayLiteral node): {
}
{
    FormalParameter(node) ("," {node.markComma();} FormalParameter(node) )*
}

void FormalParameter(ASTArrayLiteral node): {
    Token t=null;
 	ASTNode n, n2=null;
}
{
     LOOKAHEAD({getToken(1).kind==YIELD && yieldReserved}) n=YieldOnlyExpression()
     	{
      		node.addExpression(n);
    	}
   // TypeScript's optional-parameter marker ("a?"/"a?:") only ever legally
   // follows a PLAIN identifier - matched and consumed here, BEFORE
   // ConditionalExpression() ever runs. ConditionalExpression() would
   // otherwise misparse "a?:T" as GaltaJS's own "?:" ELVIS operator the
   // instant it sees a bare "?"/"?:" immediately following any operand -
   // true for every ConditionalExpression() call site, not just this one
   // (a?:T's "?:" lexes as ONE token, ELVIS, by maximal munch - not "?"
   // then ":" - whenever there's no space between them, which is the
   // idiomatic TypeScript style). A "?" directly after a destructuring
   // pattern ("{a,b}?: T") isn't recognized this way - a narrow, documented
   // gap; "?"-free destructured parameters ("{a,b}: T") still work via the
   // plain ConditionalExpression() alternative below, which has no such
   // ambiguity (a bare ":" with no preceding "?" is never part of
   // ConditionalExpression()'s own grammar).
   | LOOKAHEAD({env.supportTypeHints() && looksLikeBindingIdentifier(1) && (getToken(2).kind==HOOK || getToken(2).kind==ELVIS)})
     t=Identifier_Name()
     {
       n = nodeFactory.createIdentifier(t,bindingIdentifier(t));
     }
     { skipOptionalMarkerAndTypeIfAny(); }
     ( LOOKAHEAD("=") t="=" n2=AssignmentExpression() )?
     	{
     	    if(n2!=null) {
     	       n=nodeFactory.createAssign(t,n,n2);
     	    }
      		node.addExpression(n);
    	}
   | n=ConditionalExpression()
     { skipTypeAnnotationIfAny(); }
     ( LOOKAHEAD("=") t="=" n2=AssignmentExpression() )?
     	{
     	    if(n2!=null) {
     	       n=nodeFactory.createAssign(t,n,n2);
     	    }
      		node.addExpression(n);
    	}
   | "..." n=AssignmentExpression() { skipTypeAnnotationIfAny(); }
   		{
      		node.addSpread(n);
   		}
   |
  		{
   		  	// Only add empty slot for array holes [1,,3], not trailing commas [1,2,] or (a,b,)
			Token inputToken = getToken(1);
   		  	if(inputToken!=null && inputToken.kind==COMMA) {
      			node.addEmptySlot();
	 		}
  		}
}

/*
    leftNode=ConditionalExpression() ( LOOKAHEAD(1)
      (  (t="=" rightNode=AssignmentExpression()
*/

/* Section 11.1.5: Object Initializer */

ASTObjectLiteral ObjectLiteral(): {
	ASTObjectLiteral node;
	Token t,t2;
}
{
    t="{" {node = nodeFactory.createObjectLiteral(t);} PropertyNameAndValueList(node) t2="}"
   		{ 
   			return node.endToken(t2); 
   		}
}


void PropertyNameAndValueList(ASTObjectLiteral node): {
}	
{
	PropertyEntry(node) ("," {node.markComma();} PropertyEntry(node) )*
}


// < expr >
// a: < expr >
void PropertyEntry(ASTObjectLiteral node): {
	Object name;
	ASTNode f;
	ASTNode n=null;
 	ASTArrayLiteral parameters=null;
  	Token t=null;
  	Token tgen=null;
  	Token tasync=null;
  	Token tget=null;
  	Token tset=null;
  	Token tname=null;
  	List<ASTNode> body=null;
  	boolean savedYieldReserved;
  	boolean savedAwaitReserved;
}
{
     LOOKAHEAD(PropertyName() ":") name=PropertyName() ":" n=AssignmentExpression()
		{
      		node.addExpression(name, n);
		}
   | LOOKAHEAD({isMethodEntry()}) [LOOKAHEAD(2) tasync="async"] [tgen="*"]
     {tname=getToken(1);} name=PropertyName()
     {
       // A ComputedPropertyName is evaluated in the SURROUNDING context, not
       // the method's own [[GeneratorKind]] scope (see the analogous runtime
       // fix in RuntimeUtil.nearestYielderContext()) - so PropertyName()
       // above must run under the OUTER yieldReserved/awaitReserved value;
       // only the method's own FormalParameters/FunctionBody (from here on)
       // are yield/await-reserved per its own generator-ness/async-ness,
       // same as FunctionDeclaration().
       savedYieldReserved = yieldReserved;
       yieldReserved = (tgen!=null);
       savedAwaitReserved = awaitReserved; enterFunction();
       awaitReserved = (tasync!=null);
     }
     { skipTypeParametersIfAny(); }
     t="(" {parameters = nodeFactory.createArrayLiteral(t);} FormalParameterList(parameters) ")"
     { skipTypeAnnotationIfAny(); }
     "{" body = FunctionBody() "}"
     { yieldReserved = savedYieldReserved; awaitReserved = savedAwaitReserved; exitFunction(); }
		{
		  	// Use the leftmost token of the whole method definition (not just
		  	// "(") as the node's begin position, so toString()/source
		  	// extraction includes "async"/"*"/the property name instead of
		  	// starting mid-way at the parameter list (test262
		  	// built-ins/Function toString cluster).
		  	Token tbegin = tasync!=null ? tasync : (tgen!=null ? tgen : tname);
		  	ASTFunctionMethod decl = nodeFactory.createFunctionMethod(tbegin,name,parameters,body);
		  	decl.setGenerator(tgen!=null);
		  	decl.setAsync(tasync!=null);
      		node.addFunction(name,decl);
		}
   | LOOKAHEAD(3) tget="get" name=PropertyName() { savedYieldReserved = yieldReserved; yieldReserved = false; savedAwaitReserved = awaitReserved; enterFunction(); awaitReserved = false; } t="(" {parameters = nodeFactory.createArrayLiteral(t);} FormalParameterList(parameters) ")" { skipTypeAnnotationIfAny(); } "{" body = FunctionBody() "}" { yieldReserved = savedYieldReserved; awaitReserved = savedAwaitReserved; exitFunction(); }
		{
		  	ASTFunctionMethod decl = nodeFactory.createFunctionMethod(tget,name,parameters,body);
      		node.addGetter(name,decl);
		}
   | LOOKAHEAD(3) tset="set" name=PropertyName() { savedYieldReserved = yieldReserved; yieldReserved = false; savedAwaitReserved = awaitReserved; enterFunction(); awaitReserved = false; } t="(" {parameters = nodeFactory.createArrayLiteral(t);} FormalParameterList(parameters) ")" { skipTypeAnnotationIfAny(); } "{" body = FunctionBody() "}" { yieldReserved = savedYieldReserved; awaitReserved = savedAwaitReserved; exitFunction(); }
		{
		  	ASTFunctionMethod decl = nodeFactory.createFunctionMethod(tset,name,parameters,body);
      		node.addSetter(name,decl);
		}
   | n=AssignmentExpression() 
   		{
      		node.addExpression(n);
   		}
   | "..." n=AssignmentExpression()
   		{
      		node.addSpread(n);
   		}
   |
   		{
   		  	// Make sure that a single "," is the last one (not after a empty expression)
			Token inputToken = getToken(1);
   		  	if(inputToken==null || inputToken.kind==COMMA) {
	 			throw generateParseException();
	 		}
   		} 
}


Object PropertyName(): {
	Token t;
	Object f;
}
{
	  t=Property_Name()
		{
			// A property name is an IdentifierName (or a reserved word spelled as
			// one); unicode escapes within it must be decoded the same way a plain
			// identifier's are (see Identifier(), ASTLiteral.parseIdentifier()).
			return ASTLiteral.parseIdentifier(t.image);
		}
	| "[" f=AssignmentExpression() "]"
		{
			return f;			
		}
	| t=<STRING_LITERAL>
		{
			return ASTLiteral.parseString(t.image);			
		}
	| (t=<DEC_INTEGER_LITERAL>|t=<HEX_INTEGER_LITERAL>|t=<OCT_INTEGER_LITERAL>|t=<BIN_INTEGER_LITERAL>)
		{
		    /* 3.0 should be formatted like 3 */
			return NumberFormatting.numberToString(ASTLiteral.parseInteger(env,t.image));			
		}
	| t=<DECIMAL_LITERAL>
		{
		    /* 3.0 should be formatted like 3 */
			return NumberFormatting.numberToString(ASTLiteral.parseDecimal(env,t.image));
		}
}

   
/* Section 11.2: Left-Hand-Side Expressions */

ASTNode LeftHandSideExpression(): {
    ASTNode node;
}
{
	  LOOKAHEAD(1) node=MemberExpression() { 
			return node;
		}
    | node=CallExpression(null) {
    		return node; 
      	}
}
/*
ASTNode NewExpression(): {
    ASTNode mode;
}
{
	node=MemberExpression() { 
			return head;
		}
}
*/
ASTNode MemberExpression(): {
    ASTNode head;
}
{
	head=MemberExpressionHead()
		[
      		LOOKAHEAD(1)
    		head=CallExpression(head)
		]
		{
			return head;
		}
}

ASTNode MemberExpressionHead(): {
	ASTNode node;
	ASTNode attrNode=null;
    Token t,t2,tmode,tmeta;
	List<ASTNode> nodes=null;
}
{
  	  LOOKAHEAD("super" "(") t="super"  "(" [nodes=ArgumentList()]  ")"
  		{
  		  	return nodeFactory.createSuperCtor(t,nodes);
  		}
  	| LOOKAHEAD("super" ("." | "[")) t="super" { return nodeFactory.createSuperMember(t); }
    // import.defer(specifier) / import.source(specifier) (deferred/
    // source-phase dynamic import proposals) - same "kept OUT of
    // PrimaryExpression()" rationale as plain ImportCall below (so
    // "new import.defer(x)" stays a SyntaxError, while
    // "import.defer(x).then(...)" works via CallExpressionPart()
    // chaining). "defer"/"source" are contextual, not reserved - any other
    // identifier after "import." falls through to a parse error, same
    // pattern as ForOf's "of" check below. Explicitly excludes "meta" (via
    // the added semantic condition) so "import.meta(" (calling the meta
    // object - e.g. test262's own "import.meta is not callable" check)
    // doesn't get swallowed by this alternative's purely-syntactic "import
    // '.' Identifier_Name() '(' " shape, which "import.meta(" also
    // matches - falls through to the import.meta alternative below
    // instead, same as bare "import.meta" (no trailing "(") already does.
    | LOOKAHEAD("import" "." Identifier_Name() "(", {getToken(1).kind==IMPORT && !getToken(3).image.equals("meta")}) t="import" "." tmode=Identifier_Name() "(" node=AssignmentExpression() [ "," ] ")"
        {
        	if("defer".equals(tmode.image)) {
        		return nodeFactory.createImportCall(t,node,null,org.monflabs.galtajs.node.ASTImportCall.ImportCallMode.DEFER);
        	} else if("source".equals(tmode.image)) {
        		return nodeFactory.createImportCall(t,node,null,org.monflabs.galtajs.node.ASTImportCall.ImportCallMode.SOURCE);
        	} else {
        		throw generateParseException();
        	}
        }
    // import.meta (ImportMeta) - bare, no trailing "(", OR calling/member-
    // accessing the meta object itself (e.g. "import.meta()", "import.meta.url") -
    // reaches this alternative once the "("-requiring one above (import.
    // defer(...)/import.source(...), now explicitly excluding "meta") has
    // already failed its own LOOKAHEAD. "meta" is contextual, same
    // treatment as "defer"/"source" above - validated after the fact, any
    // other identifier falls through to a parse error.
    | LOOKAHEAD("import" "." Identifier_Name()) t="import" "." tmeta=Identifier_Name()
        {
        	if("meta".equals(tmeta.image)) {
        		return nodeFactory.createImportMeta(t);
        	} else {
        		throw generateParseException();
        	}
        }
    // Dynamic import() (spec 13.3.10, ImportCall) - kept OUT of
    // PrimaryExpression()/AllocationExpression() deliberately, so that
    // "new import(x)" correctly stays a SyntaxError (AllocationClass() -
    // reached only via "new" above - never routes through this
    // alternative) while "import(x).then(...)"/"await import(x)" work,
    // since MemberExpression()'s own CallExpressionPart() suffix chaining
    // still applies to whatever this alternative returns. The optional 2nd
    // AssignmentExpression is the import-attributes proposal's options
    // argument ("import(specifier, {with: {...}})"), itself optionally
    // followed by its own trailing comma.
    | LOOKAHEAD("import" "(") t="import" "(" node=AssignmentExpression() [ "," [ attrNode=AssignmentExpression() [ "," ] ] ] ")"
        {
        	return nodeFactory.createImportCall(t,node,attrNode,org.monflabs.galtajs.node.ASTImportCall.ImportCallMode.NORMAL);
        }
    | node=PrimaryExpression() {return node;}
    | LOOKAHEAD(2) t="new" "." t2=Identifier_Name()
        {
          	return nodeFactory.createNewMember(t,t2.image).endToken(t2);
        }
    | t="new" node=AllocationExpression(t)
    	{
    		return node; 
      	}
}

ASTNode AllocationExpression(Token newTk): {
	ASTNode id;
	ASTNode node; 
	int dim=0;
	List<ASTNode> args=null;
}
{
	id=AllocationClass()
		(
			 ( LOOKAHEAD("[" "]") "[" "]" {dim++;} )* "[" node=Expression() "]" 
			 	{
			 		return nodeFactory.createNewArray(newTk,id,dim,node);
			 	}
			|  "(" [args=ArgumentList()] ")"
				{
					return nodeFactory.createNewObject(newTk,id,args);
				}
			|  
				{
					return nodeFactory.createNewObject(newTk,id,Collections.emptyList());
				}
		)
}

/* can this be simplified? Does it cover all use cases? */
ASTNode AllocationClass() : {
	Token t,t2;
	ASTNode n;
}
{
  LOOKAHEAD("(") n=PrimaryExpression()
        {
            return n;
        }
|  t="new" n=AllocationExpression(t)
  	( LOOKAHEAD("." t=Property_Name()) "." t=Property_Name(){n=nodeFactory.createMember(t,n,t.image,false,false);}
  	| LOOKAHEAD(1) n=TemplateLiteral(n)
  	)*
  		{
  			return n;
  		}
|  t="this" { n=nodeFactory.createThis(t); }
  	( LOOKAHEAD("." t=Property_Name()) "." t=Property_Name(){n=nodeFactory.createMember(t,n,t.image,false,false);}
  	| LOOKAHEAD(1) n=TemplateLiteral(n)
  	)*
  		{
  			return n;
  		}
   // import.meta ("new import.meta()"/"new import.meta.foo()" - unlike
   // ImportCall (import(x), import.defer(x)/import.source(x)), ImportMeta
   // IS a genuine PrimaryExpression per spec (13.3.12 MetaProperty), so
   // "new import.meta()" must parse (and, per test262's own "import.meta
   // is not a constructor" check, throw TypeError at RUNTIME, not a
   // SyntaxError here) - mirrors the "this"/Identifier_Name() alternatives
   // immediately above/below, not routed through PrimaryExpression()
   // itself since ImportMeta is parsed in MemberExpressionHead() instead
   // (this AllocationClass() production doesn't reach that).
|  LOOKAHEAD("import" ".") t="import" "." t2=Identifier_Name()
  		{
  			if(!"meta".equals(t2.image)) {
  				throw generateParseException();
  			}
  			n=nodeFactory.createImportMeta(t);
  		}
  	( LOOKAHEAD("." t=Property_Name()) "." t=Property_Name(){n=nodeFactory.createMember(t,n,t.image,false,false);}
  	| LOOKAHEAD(1) n=TemplateLiteral(n)
  	)*
  		{
  			return n;
  		}
|  t=Identifier_Name() { n=nodeFactory.createIdentifier(t,t.image); }
  	( LOOKAHEAD("." t=Property_Name()) "." t=Property_Name(){n=nodeFactory.createMember(t,n,t.image,false,false);}
  	| LOOKAHEAD(1) n=TemplateLiteral(n)
  	)*
  		{
  			return n;
  		}
   // Any other PrimaryExpression form: literals, function/class expressions,
   // array/object literals, etc. Evaluation throws TypeError if not constructible.
|  LOOKAHEAD(1) n=PrimaryExpression()
  	( LOOKAHEAD("." t=Property_Name()) "." t=Property_Name(){n=nodeFactory.createMember(t,n,t.image,false,false);}
  	| LOOKAHEAD(1) n=TemplateLiteral(n)
  	)*
  		{
  			return n;
  		}
}


ASTNode CallExpression(ASTNode leftNode): {
	ASTNode node;
}
{
    node=CallExpressionPart(leftNode)
    [
        LOOKAHEAD(1)
        node=CallExpression(node)
        {
        	return node;
        }
    ]
    	{
    		return node;
    	}
}
ASTNode CallExpressionPart(ASTNode leftMember): {
	Token t=null,t2=null,o=null,s=null;
	ASTNode n;
	ASTArrayMember indexes;
	List<ASTNode> nodes=null;
	ASTStringTemplate template;
}
{
     // Tagged templates chain like any other MemberExpression/CallExpression suffix
     // (e.g. tag`a``b`, obj.tag`a``b`), so this loops back through CallExpression.
     LOOKAHEAD(1) {
            // OptionalChain: a template literal cannot tag an optional chain
            for(ASTNode c=leftMember; c instanceof ChainingNode; c=((ChainingNode)c).getNode()) {
                if(((ChainingNode)c).isNullOp()) {
                    throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError("Tagged template cannot be used in an optional chain");
                }
            }
        }
     template=TemplateLiteral(leftMember)
        {
            return template;
        }
   | LOOKAHEAD(2) t="[" t2="]"
        {
            return nodeFactory.createArrayMemberArray(t,leftMember).endToken(t2);
        }
   | LOOKAHEAD(3) [s=".."] t="[" "*" t2="]"
        {
            return nodeFactory.createArrayMemberFlatten(t,leftMember,s!=null).endToken(t2);
        }
   | LOOKAHEAD(2) [s=".."|o="?."] t="["
   			{indexes = nodeFactory.createArrayMember(t!=null?t:o,leftMember,s!=null,o!=null);}
   		ArrayIndexList(indexes) t2="]"
        	{
				return indexes.endToken(t2);
        	}
   | t="[?" "(" n=Expression() ")" t2="]"
        {
            return nodeFactory.createMemberFilter(t,leftMember,n).endToken(t2);
        }
   | t=".(" n=Expression() t2=")"
        {
            return nodeFactory.createMemberMap(t,leftMember,n).endToken(t2);
        }
   | LOOKAHEAD(2) [o="?."] t="(" [nodes=ArgumentList()] t2=")"
        {
            return nodeFactory.createFunctionCall(t,leftMember,nodes,o!=null).endToken(t2);
        }
   | LOOKAHEAD(2) ".." (t="*" | t="[" "*" t2="]" )
        {
            return nodeFactory.createArrayMemberFlatten(t,leftMember,true).endToken(t2);
        }
   | LOOKAHEAD(2) t=".." t2=Property_Name()
        {
           	return nodeFactory.createMember(t2,leftMember,t2.image,true,false);
        }
   | LOOKAHEAD(2) t=".." t2=<DEC_INTEGER_LITERAL>
        {
           	return nodeFactory.createMember(t2,leftMember,t2.image,true,false);
        }
   | LOOKAHEAD(2) ".."
        {
            return nodeFactory.createArrayMemberDeepScan(t,leftMember);
        }
   | LOOKAHEAD(3) (o="?." | s=".") "#" {privateNameFollows();} t=Property_Name()
        {
          	return nodeFactory.createMember(o,leftMember,"#"+ASTLiteral.parseIdentifier(t.image),false,o!=null).endToken(t);
        }
   | LOOKAHEAD(2) (o="?." | s=".") t=Property_Name()
        {
          	return nodeFactory.createMember(o,leftMember,ASTLiteral.parseIdentifier(t.image),false,o!=null).endToken(t);
        }
   | LOOKAHEAD(2) t=<DECIMAL_LITERAL>
        {
            // .0 is actually a decimal literal token
            String decLiteral = t.image;
            if(ASTMember.isMemberIntegerIndex(env, decLiteral)) { 
            	ASTLiteral ma = nodeFactory.createLiteral(t,ASTLiteral.parseInteger(env,decLiteral.substring(1))); 
          		ASTArrayMember m = nodeFactory.createArrayMember(t, leftMember, false, false);
          		m.addIndex(t,ma);
          		return m;
         	}
	 		throw generateParseException();         	
        }
   | LOOKAHEAD(2) t="." t2="*"
        {
          	return nodeFactory.createArrayMemberFlatten(t,leftMember,false).endToken(t2);
        }

}

void ArrayIndexList(ASTArrayMember node): {
}
{
	ArrayIndex(node) ("," ArrayIndex(node) )*  	  
}

void ArrayIndex(ASTArrayMember node): {
    Token t=null;
 	ASTNode start=null, end=null, step=null;
}
{
     t=":" [end=AssignmentExpression()] [":" [step=AssignmentExpression()]]
     	{
           node.addIndex(t,start,end,step);
    	}
  |  start=AssignmentExpression() [t=":" [end=AssignmentExpression()] [":" [step=AssignmentExpression()]]]
     	{
            if(t!=null) {
              node.addIndex(t,start,end,step);
          	} else { 
              node.addIndex(t,start);
            }
    	}
}


// Hum, can we make the trailing ',' easier to handle here?
// Maybe when refactoring the object literal as well
List<ASTNode> ArgumentList(): {
 	ASTNode node=null;
 	List<ASTNode> nodes=null;
 	Token t=null;
}
{
    (t="...")? node=AssignmentExpression()   
    	{
 			nodes = new ArrayList<ASTNode>();
    	    if(debug) {
    	      node = nodeFactory.createDebugHook(node);
    	    }
 			if(t!=null) {
 			  node = nodeFactory.createFunctionCallSpread(t,node);
 			}
    		nodes.add(node); 
	   		node = null; t = null; // Next loop...
    	}
    (

      "," (t="...")? (node=AssignmentExpression())? 
    	{
    	  	if(node==null) {
	   		  	// Make sure that a single "," is the last one (not after a empty expression)
				Token inputToken = getToken(1);
	   		  	if(inputToken==null || inputToken.kind==COMMA) {
		 			throw generateParseException();
		 		}
    	 	} else { 
	    	    if(debug) {
	    	      node = nodeFactory.createDebugHook(node);
	    	    }
	 			if(t!=null) {
	 			  node = nodeFactory.createFunctionCallSpread(t,node);
	 			}
	    		nodes.add(node);
	   		}
	   		node = null; t = null; // Next loop...
    	} 
    )*
    	{
			return nodes;
	}    	  
}

/* Section 11.3 Postfix Expressions */
/* Condensed the 2 original productions into one */

ASTNode PostfixExpression(): {
	Token t;
    ASTNode leftNode;
}
{
    // Tagged template chaining (tag`a``b`, obj.tag`a`) is handled inside
    // MemberExpression/CallExpressionPart, since it can chain arbitrarily like any
    // other member/call suffix.
    leftNode=MemberExpression()
    	[LOOKAHEAD( {noLineTerminatorBeforeNextToken() && (getToken(1).kind == INCR || getToken(1).kind == DECR)} ) (t="++" | t="--")
     		{
     			if(t.image.equals("++")) {
     				return nodeFactory.createPostInc(t,leftNode);
     			} else {
     				return nodeFactory.createPostDec(t,leftNode);
     			}
     		}
    	]
    	{
     		return leftNode;
    	}
}

 
/* Section 11.4 Unary Operators */
/* Condensed the 2 original productions into one */


ASTNode UnaryExpression(): {
 	ASTNode node;
 	Token t;
}
{
    LOOKAHEAD("await" UnaryExpression(), {awaitReserved}) t="await" node=UnaryExpression()
    	{
    		return nodeFactory.createAwait(t,node);
    	}
    |node=PostfixExpression()
      	{ 
      		return node;
      	}
    |t="delete" node=UnaryExpression()
    	{
    		return nodeFactory.createDelete(t,node);
    	}
    |t="void" node=UnaryExpression()
    	{
    		return nodeFactory.createVoid(t,node);
    	}
    |t="typeof" node=UnaryExpression()
    	{
    		return nodeFactory.createTypeof(t,node);
    	}
    |t="++" node=UnaryExpression()     
    	{
    		return nodeFactory.createPreInc(t,node);
    	}
    |t="--" node=UnaryExpression()
        {
    		return nodeFactory.createPreDec(t,node);
    	}
    |t="+" node=UnaryExpression()
    	{
    	  	// Not sure how to disambiguate, in the grammar, the unary operator from the number literal
    	  	// Note that we need to distinguish +0
    	    if(node instanceof ASTLiteral) {
    	      ASTLiteral lit = (ASTLiteral)node;
    	      if(lit.astPlus()) { 
    	      	return lit;
    	      }
    	  	}
    		return nodeFactory.createPlus(t,node);
    	}
    |t="-" node=UnaryExpression()
    	{
    	  	// Not sure how to disambiguate, in the grammar, the unary operator from the number literal
    	  	// Note that we need to distinguish -0
    	    if(node instanceof ASTLiteral) {
    	      ASTLiteral lit = (ASTLiteral)node;
    	      if(lit.astMinus()) { 
    	      	return lit;
    	      }
    	  	}
    		return nodeFactory.createMinus(t,node);
    	}
    |t="~" node=UnaryExpression()
    	{
    		return nodeFactory.createBitNot(t,node);
    	}
    |t="!" node=UnaryExpression()
    	{
    		return nodeFactory.createNot(t,node);
    	}
}


ASTNode PowerExpression(): {
	Token t;
	Token first;
 	ASTNode leftNode;
 	ASTNode rightNode;
}
{
    // Right-associative: 2 ** 3 ** 2 === 2 ** (3 ** 2), unlike every other binary operator.
    { first = getToken(1); }
    leftNode=UnaryExpression() [ LOOKAHEAD(1) t="**" rightNode=PowerExpression()
        {
            // The base is an UpdateExpression: "-x ** 2" needs parentheses
            // (checked on the token, since "-3" may already be folded)
            if(first.kind==MINUS || first.kind==PLUS || first.kind==BANG || first.kind==TILDE
                || first.kind==TYPEOF || first.kind==VOID || first.kind==DELETE
                || (first.kind==AWAIT && awaitReserved && !(leftNode instanceof ASTIdentifier))) {
              throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError("Unary operator used immediately before exponentiation expression, parentheses are required");
            }
            leftNode=nodeFactory.createPower(t,leftNode,rightNode);
        }
    ]
    	{
    		return leftNode;
    	}
}



/* Section 11.5: Multiplicative Operators */
/* Condensed the 2 original productions into one */

ASTNode MultiplicativeExpression(): {
	Token t;
 	ASTNode leftNode;
 	ASTNode rightNode;
}
{
    leftNode=PowerExpression() ( LOOKAHEAD(1)
      (  (t="*" rightNode=PowerExpression()
           {
               leftNode=nodeFactory.createMul(t,leftNode,rightNode);
           })
      |  (t=<SLASH> rightNode=PowerExpression()
           {
                leftNode=nodeFactory.createDiv(t,leftNode,rightNode);
           })
      |  (t="%" rightNode=PowerExpression()
           {
                leftNode=nodeFactory.createMod(t,leftNode,rightNode);
           })
    ))*
    	{
    		return leftNode;
    	}
}


/* Section 11.6: Additive Operators */
/* Condensed the 2 original productions into one */

ASTNode AdditiveExpression(): {
	Token t;
    ASTNode leftNode;
    ASTNode rightNode;
}
{
    leftNode=MultiplicativeExpression() ( LOOKAHEAD(1)
      (  (t="+" rightNode=MultiplicativeExpression()
           {
               leftNode=nodeFactory.createAdd(t,leftNode,rightNode);
           })
      |  (t="-" rightNode=MultiplicativeExpression()
           {
                leftNode=nodeFactory.createSub(t,leftNode,rightNode);
           })
    ))*
    	{
    		return leftNode;
    	}
}


/* Section 11.7: Bitwise Shift Operators */
/* Condensed the 2 original productions into one */

ASTNode ShiftExpression(): {
	Token t;
	ASTNode leftNode,rightNode;
}
{
	    leftNode=AdditiveExpression() ( LOOKAHEAD(1)
      (  (t="<<" rightNode=AdditiveExpression()
           {
               leftNode=nodeFactory.createLShift(t,leftNode,rightNode);
           })
      |  (t=">>" rightNode=AdditiveExpression()
           {
               leftNode=nodeFactory.createRShift(t,leftNode,rightNode);
           })
      |  (t=">>>" rightNode=AdditiveExpression()
           {
               leftNode=nodeFactory.createRunShift(t,leftNode,rightNode);
           })
    ))*
    	{
    		return leftNode;
    	}
}


/* Section 11.4: Relational Operators */
/* Condensed the 2 original productions into one */

ASTNode RelationalExpression(): {
	Token t, tpriv, tname;
 	ASTNode leftNode,rightNode;
}
{
	    LOOKAHEAD(2) tpriv="#" {privateNameFollows();} tname=Property_Name() t="in" rightNode=ShiftExpression()
	    	{
	    		// Ergonomic brand check (#name in obj): the private name is a fixed,
	    		// lexically-known key, not a general expression - reuse the plain "in"
	    		// runtime check (including its RHS-must-be-object TypeError) against the
	    		// same "#"+name convention already used for private member access.
	    		// ASTPrivateNameLiteral (not a plain ASTLiteral) marks this as a genuine
	    		// private-name reference, distinct from a coincidental ordinary string
	    		// literal like "#name" that happens to start with "#" - ASTIn needs to
	    		// tell the two apart.
	    		leftNode = nodeFactory.createPrivateNameLiteral(tpriv, "#"+tname.image);
	    		return nodeFactory.createIn(t,MODE.ONE,leftNode,rightNode);
	    	}
	  | leftNode=ShiftExpression() ( LOOKAHEAD(1)
      (  (t="<" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createLt(t,MODE.ONE,leftNode,rightNode);
           })
      |  (t=">" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createGt(t,MODE.ONE,leftNode,rightNode);
           })
      |  (t="<=" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createLe(t,MODE.ONE,leftNode,rightNode);
           })
      |  (t=">=" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createGe(t,MODE.ONE,leftNode,rightNode);
           })
      |  (t="*<" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createLt(t,MODE.ALL,leftNode,rightNode);
           })
      |  (t="*>" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createGt(t,MODE.ALL,leftNode,rightNode);
           })
      |  (t="*<=" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createLe(t,MODE.ALL,leftNode,rightNode);
           })
      |  (t="*>=" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createGe(t,MODE.ALL,leftNode,rightNode);
           })
      |  (t="instanceof" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createInstanceOf(t,MODE.ONE,leftNode,rightNode);
           })
      |  (t="*instanceof" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createInstanceOf(t,MODE.ALL,leftNode,rightNode);
           })
      |  (t="in" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createIn(t,MODE.ONE,leftNode,rightNode);
           })
      |  (t="*in" rightNode=ShiftExpression()
           {
               leftNode=nodeFactory.createIn(t,MODE.ALL,leftNode,rightNode);
           })
           
    ))*
    	{
    		return leftNode;
    	}
}


/* Section 11.9: Equality Operators */
/* Condensed the 2 original productions into one */

ASTNode EqualityExpression(): {
	Token t;
 	ASTNode leftNode,rightNode;
}
{
			    leftNode=RelationalExpression() ( LOOKAHEAD(1)
      (  (t="==" rightNode=RelationalExpression()
           {
               leftNode=nodeFactory.createEq(t,MODE.ONE,leftNode,rightNode);
           })
      |  (t="!=" rightNode=RelationalExpression()
           {
               leftNode=nodeFactory.createNe(t,MODE.ONE,leftNode,rightNode);
           })
      |  (t="===" rightNode=RelationalExpression()
           {
               leftNode=nodeFactory.createEqStrict(t,MODE.ONE,leftNode,rightNode);
           })
      |  (t="!==" rightNode=RelationalExpression()
           {
               leftNode=nodeFactory.createNeStrict(t,MODE.ONE,leftNode,rightNode);
           })
      |  (t="*==" rightNode=RelationalExpression()
           {
               leftNode=nodeFactory.createEq(t,MODE.ALL,leftNode,rightNode);
           })
      |  (t="*!=" rightNode=RelationalExpression()
           {
               leftNode=nodeFactory.createNe(t,MODE.ALL,leftNode,rightNode);
           })
      |  (t="*===" rightNode=RelationalExpression()
           {
               leftNode=nodeFactory.createEqStrict(t,MODE.ALL,leftNode,rightNode);
           })
      |  (t="*!==" rightNode=RelationalExpression()
           {
               leftNode=nodeFactory.createNeStrict(t,MODE.ALL,leftNode,rightNode);
           })
           
    ))*
    	{
    		return leftNode;
    	}
}


/* Section 11.10: Binary Bitwise Operators */
/* Condensed the 2 original productions into one */

ASTNode BitwiseANDExpression(): {
	Token t;
    ASTNode leftNode,rightNode;
}
{
    leftNode=EqualityExpression() (LOOKAHEAD(1) t="&" rightNode=EqualityExpression()
       {
            leftNode=nodeFactory.createBitAnd(t,leftNode,rightNode);
       }

    )*
    	{
    		return leftNode;
    	}
}

ASTNode BitwiseXORExpression(): {
	Token t;
    ASTNode leftNode,rightNode;
}
{
    leftNode=BitwiseANDExpression() (LOOKAHEAD(1) t="^" rightNode=BitwiseANDExpression()
       {
            leftNode=nodeFactory.createBitXor(t,leftNode,rightNode);
       }

    )*
    	{
    		return leftNode;
    	}
}

ASTNode BitwiseORExpression(): {
	Token t;
    ASTNode leftNode,rightNode;
}
{
    leftNode=BitwiseXORExpression() (LOOKAHEAD(1) t="|" rightNode=BitwiseXORExpression()
       {
            leftNode=nodeFactory.createBitOr(t,leftNode,rightNode);
       }

    )*
    	{
    		return leftNode;
    	}
}


/* Section 11.11: Binary Logical Operators */
/* Condensed the 2 original productions into one */

ASTNode LogicalANDExpression():
{
	Token t;
    ASTNode leftNode,rightNode;
}
{
	leftNode=BitwiseORExpression() ( LOOKAHEAD(1)
      (  (t="&&" rightNode=BitwiseORExpression()
           {
               leftNode=nodeFactory.createAnd(t,leftNode,rightNode);
           })
    ))*
    	{
    		return leftNode;
    	}
}

ASTNode LogicalORExpression():
{Token t;
    ASTNode leftNode,rightNode;
}
{
	leftNode=LogicalANDExpression() ( LOOKAHEAD(1)
      (  (t="||" rightNode=LogicalANDExpression()
           {
               leftNode=nodeFactory.createOr(t,leftNode,rightNode);
           })
       | (t="??" rightNode=LogicalANDExpression()
           {
               leftNode=nodeFactory.createNullCoalescing(t,leftNode,rightNode);
           })
     ))*
    	{
    		return leftNode;
    	}
}


/* Section 11.12: Conditional Operator */
/* Condensed the 2 original productions into one */
/* Added Elvis support */

ASTNode ConditionalExpression(): {
      ASTNode trueNode=null;
      ASTNode falseNode;
      ASTNode conditionNode;
      Token t;
}
{
    conditionNode=LogicalORExpression()
      [ LOOKAHEAD(1)
         ((t="?" trueNode=AssignmentExpression() ":") | (t="?:")) falseNode=AssignmentExpression()
    	{
    		return nodeFactory.createTernaryTest(t,conditionNode,trueNode,falseNode);
    	}
      ]
    	{
     		return conditionNode;
    	}
}


/* Section 11.13: Assignment Operators */

ASTNode AssignmentExpression(): {
	Token t;
 	ASTNode leftNode=null;
 	ASTNode rightNode;
}
{
    // When the next token is "yield" and we're directly inside a generator's
    // own body (yieldReserved), it must be the YieldExpression keyword, not
    // an identifier-starting ConditionalExpression - see yieldReserved's
    // declaration above for why this can't just be Identifier_Name()'s
    // ordinary (per-token) LOOKAHEAD like the other contextual keywords.
    LOOKAHEAD({!(getToken(1).kind==YIELD && yieldReserved)})
    leftNode=ConditionalExpression() ( LOOKAHEAD(1)
      (  (t="=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssign(t,leftNode,rightNode);
           })
      |  (t="*=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignMul(t,leftNode,rightNode);
           })
      |  (t="**=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignPower(t,leftNode,rightNode);
           })
      |  (t=<SLASHASSIGN> rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignDiv(t,leftNode,rightNode);
           })
      |  (t="%=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignMod(t,leftNode,rightNode);
           })
      |  (t="+=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignAdd(t,leftNode,rightNode);
           })
      |  (t="-=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignSub(t,leftNode,rightNode);
           })
      |  (t="&=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignBitAnd(t,leftNode,rightNode);
           })
      |  (t="^=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignBitXor(t,leftNode,rightNode);
           })
      |  (t="|=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignBitOr(t,leftNode,rightNode);
           })
      |  (t="||=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignOr(t,leftNode,rightNode);
           })
      |  (t="&&=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignAnd(t,leftNode,rightNode);
           })
      |  (t="<<=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignLShift(t,leftNode,rightNode);
           })
      |  (t=">>=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignRShift(t,leftNode,rightNode);
           })
      |  (t=">>>=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignRunShift(t,leftNode,rightNode);
           })
      |  (t="??=" rightNode=AssignmentExpression()
           {
               leftNode=nodeFactory.createAssignNullCoalescing(t,leftNode,rightNode);
           })
      |  (t="|>" rightNode=ConditionalExpression() 
           {
               // ^^^ we use a condition expression here as the associativity is left->right
               leftNode=nodeFactory.createPipelineCall(t,leftNode,rightNode);
           })
    ))*
    	{
    		return leftNode;
    	}
    |  leftNode=YieldOnlyExpression()
       {
           return leftNode;
       }

}

// Factored out of AssignmentExpression() so ElementEntry() (array literal elements)
// can also accept a bare "yield"/"yield*" - it's an AssignmentExpression alternative,
// but ElementEntry() otherwise only descends to ConditionalExpression() precedence
// (to leave "=" available for destructuring defaults).
ASTNode YieldOnlyExpression(): {
  Token t;
  ASTNode leftNode = null;
}
{
    t="yield"
      ( LOOKAHEAD({isYieldStar()}) "*" leftNode=AssignmentExpression()
          {
              return nodeFactory.createYieldStar(t,leftNode);
          }
      // "yield [no LineTerminator here] AssignmentExpression": same
      // LineTerminator restriction as the yield* form above.
      | [ LOOKAHEAD({noLineTerminatorBeforeYieldOperand()}) leftNode=AssignmentExpression() ]
          {
              return nodeFactory.createYield(t,leftNode);
          }
      )
}


/* Section 11.14: Comma Operator */

ASTNode Expression(): {
	List<ASTNode> nodes=null;
 	ASTNode n1;
 	Token t=null;
}
{(
    n1=AssignmentExpression()
     ( LOOKAHEAD(",") t=","
      	{
       		// don't create  the list unless ',' exist
        	if (nodes==null){
        	  	nodes = new ArrayList<ASTNode>();
          		nodes.add(n1);
        	}
      	}
      n1=AssignmentExpression()
      	{
     	  	if(debug) { // the expresion node carries it for the first expression
     	  	    n1 = nodeFactory.createDebugHook(n1);
     		}
        	nodes.add(n1);
       	}
     )*)
     	{
         	if(nodes!=null) {
         		return nodeFactory.createExpression(nodes);
         	}
         	return n1;
     	}
}


/* Section 12: STATEMENTS */

// The Statement of an if/loop/with/labelled statement (see isLetDeclaration()),
// marked with its position for EarlyErrorsValidator (no declaration there)
ASTNode SubStatement(int position): {
	ASTNode node;
}
{
	{ pendingSubStatement = true; }
	node=Statement()
	{
	  ASTNode.skipTransparent(node).markStatementPosition(position);
	  return node;
	}
}

// The body of an iteration statement: a SubStatement where break and
// continue have a target
ASTNode LoopBody(): {
	ASTNode node;
}
{
	{ jumps.breakable++; jumps.iterations++; }
	node=SubStatement(ASTNode.POSITION_BODY)
	{
	  jumps.breakable--; jumps.iterations--;
	  return node;
	}
}

ASTNode Statement(): {
	ASTNode node;
	boolean sub = pendingSubStatement;
}
{
try {
     { pendingSubStatement = false; subStatement = sub; }
     (
         LOOKAHEAD("{") node=Block()
        |node=VariableStatement()
        |node=EmptyStatement()
        |LOOKAHEAD(Identifier_Name() ":")node=LabeledStatement()
        // "synchronized" is also a valid plain identifier (see
        // Identifier_Name()'s own <SYNCHRONIZED> alternative), so
        // "synchronized(x)" alone is ambiguous with a call expression on a
        // variable/function named "synchronized". The synchronized-block
        // form is only ever followed by "{" - the syntactic lookahead below
        // is the only thing that distinguishes the two; without it,
        // ExpressionStatement() below always wins first and a genuine
        // synchronized(x) { ... } block fails to parse ("Encountered {").
        |LOOKAHEAD("synchronized" "(" Expression() ")" "{") node=Synchronized()
        // TypeScript-style type hints (JSConfiguration.supportTypeHints()):
        // parsed for syntax only, then discarded entirely - all three
        // return createEmpty(), which StatementList() above already drops
        // from the resulting statement list, same as a stray ";". Must be
        // tried before ExpressionStatement() below, which would otherwise
        // happily parse "type"/"interface"/"declare" as plain identifiers.
        |LOOKAHEAD({isDeclareStart()}) node=DeclareStatement()
        |LOOKAHEAD({isTypeAliasStart()}) node=TypeAliasStatement()
        |LOOKAHEAD({isInterfaceStart()}) node=InterfaceStatement()
        |node=ExpressionStatement()
        |node=IfStatement()
        |node=IterationStatement()
        |node=ContinueStatement()
        |node=BreakStatement()
        |node=ReturnStatement()
		|node=WithStatement()
        |node=SwitchStatement()
        |node=ThrowStatement()
        |node=TryStatement()
        |node=Debugger()
        |node=FunctionDeclaration()
        |node=ClassDeclaration()
     )
     	{
     		if(node instanceof ASTFunctionDecl) { // Is there a better way?
     		  ((ASTFunctionDecl)node).setStatement(true);
     		  // FunctionDeclaration() is shared with the expression-position
     		  // FunctionExpression alternative (PrimaryExpression), whose
     		  // RBRACE correctly leaves the lexer in NO_REGEX (a following
     		  // "/" is division). Only override here, once we know this
     		  // parse was reached via Statement() - i.e. the "}" ends a
     		  // Declaration and a following "/" starts a new
     		  // StatementListItem (test262
     		  // language/statementList/fn-regexp-literal.js: "function fn() {}/1/;").
     		  token_source.SwitchTo(DEFAULT);
     		}
     		if(node instanceof ASTClassDecl) { // Is there a better way?
     		  ((ASTClassDecl)node).setStatement(true);
     		  // Same reasoning as the FunctionDeclaration case above (test262
     		  // language/statementList/class-regexp-literal.js: "class C {}/1/;").
     		  token_source.SwitchTo(DEFAULT);
     		}
     	  	if(debug) {
     	  	  node = nodeFactory.createDebugHookStatement(node);
     		}
       		return node;
     	}
 } catch( ParseException ex ) {
     if(errorList!=null) {
     	errorList.addError(new ScriptError(ScriptError.ERROR,-1,ex.getMessage(),ex.currentToken.next.beginLine,ex.currentToken.next.beginColumn));
     	recoverFromError(true);
     	return null;
     }
     throw ex;
 }
}


/* 12.1 Block Statement */

ASTBlock Block(): {
	List<ASTNode> statements=null;
 	Token t,t2;
}
{
    t="{"
     [ statements=StatementList() ] t2="}"
     	{
      		// Block() is only ever reached in statement position (see its call
      		// sites: Statement(), TryStatement(), Synchronized()), never as
      		// part of an expression. Its RBRACE's TOKEN action defaults the
      		// lexer to NO_REGEX (correct for the far more common case of a
      		// "}" closing an ObjectLiteral, where a following "/" must be
      		// division), but here a following "/" starts a new
      		// StatementListItem and must be read as a RegularExpressionLiteral
      		// instead (test262 language/statementList/block-regexp-literal.js:
      		// "{}/1/;", block-with-statment-regexp-literal.js: "{length: 3000}/1/;").
      		token_source.SwitchTo(DEFAULT);
      		return nodeFactory.createBlock(t,statements).endToken(t2);
     	}
}

List<ASTNode> StatementList(): {
	ASTNode node;
	List<ASTNode> nodes=null;
}
{
    (
      node=Statement()
      	{
      	  	if(!(node instanceof ASTEmpty))
      	  	{
      	  		if(nodes==null) {
					nodes = new ArrayList<ASTNode>();
				}
        		nodes.add(node);
			}
      	}
    )+
    	{
    	  return nodes;
   		}
}


/* Section 12.2: Variable statement */

ASTNode VariableStatement(): {
	ASTVariableDecl vnode;
	Token t;
}
{
      t="var" {vnode=nodeFactory.createVariableDeclLocal(t);} VariableDeclarationList(vnode) insertSemiColon()
    	{
    		return vnode;
    	}
  	| LOOKAHEAD({isLetDeclaration()}) t="let" {vnode=nodeFactory.createVariableDeclScoped(t);} VariableDeclarationList(vnode) insertSemiColon()
    	{
    		return vnode;
    	}
  	| t="const" {vnode=nodeFactory.createVariableDeclConst(t);} VariableDeclarationList(vnode) insertSemiColon()
    	{
    		return vnode;
    	}
  	| LOOKAHEAD({isAwaitUsingDeclaration()}) "await" t="using" {vnode=nodeFactory.createVariableDeclUsing(t,true);} VariableDeclarationList(vnode) insertSemiColon()
    	{
    		return vnode;
    	}
  	| LOOKAHEAD({isUsingDeclaration()}) t="using" {vnode=nodeFactory.createVariableDeclUsing(t,false);} VariableDeclarationList(vnode) insertSemiColon()
    	{
    		return vnode;
    	}
}

ASTVariableDecl VariableDeclarationList(ASTVariableDecl vnode): {
}
{
    VariableDeclaration(vnode)
    	[ "," VariableDeclarationList(vnode) ]
    	{
    		return vnode;
    	}
}

ASTNode VariableDeclaration(ASTVariableDecl vnode): {
	ASTNode varDecl; 
 	ASTNode initnode=null;
}
{
    varDecl=VariableDeclarationNames() { skipTypeAnnotationIfAny(); } [initnode=Initialiser()]
    	{
     		vnode.add(varDecl,initnode);
     		return vnode;
    	}
}

ASTNode VariableDeclarationNames(): {
  Token t;
  ASTNode varDecl; 
}
{
    t=Identifier_Name()
    	{
    	  return nodeFactory.createIdentifier(t,bindingIdentifier(t));
   		}
  | LOOKAHEAD("[") varDecl=ArrayLiteral()
  		{
  		  return varDecl;
  		}
  | LOOKAHEAD("{") varDecl=ObjectLiteral()
  		{
  		  return varDecl;
  		}
}

ASTNode Initialiser(): {
	ASTNode node;
}
{
    "=" node=AssignmentExpression()
    	{
    		return node;
    	}
}


/* Section 12.3: Empty Statement */

ASTNode EmptyStatement():
{
 	Token t;
}
{
    t=";"
    	{
    		return nodeFactory.createEmpty(t);
   		}
}


/* TypeScript-style type hints (JSConfiguration.supportTypeHints()) - see
   isTypeAliasStart()/isInterfaceStart()/isDeclareStart() above for the
   guarding predicates, and skipType()/skipTypeParameters()/
   skipInterfaceBody()/skipDeclareSignature() for the token-skipping they
   share. All three return createEmpty(): parsed for syntax only, nothing
   here ever becomes a real AST node. */

ASTNode TypeAliasStatement(): {
	Token t;
}
{
    t=Identifier_Name() Identifier_Name()
    { skipTypeParametersIfAny(); }
    "=" { skipType(); } insertSemiColon()
    	{
    		return nodeFactory.createEmpty(t);
   		}
}

ASTNode InterfaceStatement(): {
	Token t;
}
{
    t=Identifier_Name() Identifier_Name()
    { skipTypeParametersIfAny(); skipInterfaceExtendsIfAny(); }
    "{" { skipInterfaceBody(); } "}"
    	{
    		return nodeFactory.createEmpty(t);
   		}
}

// "declare" ambient declarations are compile-time-only shape assertions in
// real TypeScript - they have NO runtime effect whatsoever (the thing being
// "declared" is assumed to already exist via some other means). Since
// GaltaJS never type-checks anything here either, the whole statement
// (whatever it declares - function/class/var/let/const/type/interface) is
// simply parsed for syntax and discarded, exactly like a bare type/interface
// statement - never delegated to the real FunctionDeclaration()/
// ClassDeclaration()/VariableStatement() productions, which (unlike this)
// require a real body/would create a real, executable declaration.
ASTNode DeclareStatement(): {
	Token t;
}
{
    t=Identifier_Name() { skipDeclareSignature(); }
    	{
    		return nodeFactory.createEmpty(t);
   		}
}


/* Section 12.4: Expression Statement */

ASTNode ExpressionStatement(): {
	ASTNode node;
}
{
    // cannot start with "{", "function", "class", or an unambiguous
    // "async [no LineTerminator here] function" - those are handled by
    // Block()/FunctionDeclaration()/ClassDeclaration() as their own
    // Statement() alternatives, which don't require (or want) ASI. A
    // LineTerminator between "async" and "function" (or no "function" at
    // all, e.g. bare "async;") breaks the AsyncFunctionDeclaration shape,
    // so "async" alone is still a valid ExpressionStatement start in that
    // case - noLineTerminatorAfterAsync() alone only checks for the
    // ABSENCE of a LineTerminator, not that token2 is actually "function"
    // (safe in its other, pre-existing call sites, which already
    // confirmed the "function" shape via a syntactic LOOKAHEAD first), so
    // token2's kind must be checked explicitly here too.
    LOOKAHEAD({getToken(1).kind!=LBRACE && getToken(1).kind!=FUNCTION && getToken(1).kind!=CLASS
               && !(getToken(1).kind==ASYNC && getToken(2).kind==FUNCTION && noLineTerminatorAfterAsync())})
    node=Expression() insertSemiColon()
    	{
    		return node;
    	}
}


/* Section 12.5: The if Statement */

ASTNode IfStatement(): {
 	ASTNode n1;
 	ASTNode n2;
 	ASTNode n3=null;
 	Token t;
}
{
    t="if" "(" n1=Expression() ")" n2=SubStatement(ASTNode.POSITION_IF_CLAUSE)
    [ LOOKAHEAD("else") "else" n3=SubStatement(ASTNode.POSITION_IF_CLAUSE) ]
    	{
    	    if(debug) {
    	      n1 = nodeFactory.createDebugHook(n1);
    	    }
    		return nodeFactory.createIf(t,n1,n2,n3);
    	}
}


/* Section 12.6: Iteration Statements */

ASTNode IterationStatement():
{
 	ASTNode n1=null;
 	ASTNode n2=null;
 	ASTNode n3=null;
 	ASTNode body=null;
 	Token t, t2, tv;
}
{
    t="do" body=LoopBody() "while" "(" n1=Expression() ")" insertSemiColonDoWhile()
    	{
    	    if(debug) {
    	      n1 = nodeFactory.createDebugHook(n1);
    	    }
     		return nodeFactory.createDoWhile(t,n1,body);
    	}

    | t="while" "(" n1=Expression()")" body=LoopBody()
    	{
    	    if(debug) {
    	      n1 = nodeFactory.createDebugHook(n1);
    	    }
     		return nodeFactory.createWhile(t,n1,body);
    	}
    // for await ( ForDeclaration/LeftHandSideExpression of AssignmentExpression ) Statement
    // (13.7.5's [+Await] alternative) - "await" as the token immediately
    // after "for" (no "(" yet) is unambiguous with every other
    // IterationStatement() alternative below (all of which require "(" to
    // come right after "for"), so no further lookahead is needed to
    // distinguish this shape once "await" is seen there - only whether
    // "await" is CURRENTLY the reserved keyword (awaitReserved, the exact
    // same flag UnaryExpression()'s own "await" alternative is gated on)
    // matters: GaltaJS allows top-level await (and so top-level `for await`)
    // everywhere by design (see awaitReserved's own doc), but a `for await`
    // inside a genuinely non-async function/generator - where awaitReserved
    // is explicitly false - has no matching alternative at all here, so it
    // falls through to a plain ParseException, same as the spec's own
    // [+Await]-gated grammar rejects it (a SyntaxError either way, just not
    // one with this construct's own dedicated message).
    | LOOKAHEAD("for" "await", {awaitReserved})
      t="for" "await" "(" n1=LoopVariable() tv=Identifier_Name() n2=AssignmentExpression() t2=")" body=LoopBody()
      	{
      	    if(!"of".equals(tv.image)) {
	 			throw generateParseException();
      	    }
    	    if(debug) {
    	      n2 = nodeFactory.createDebugHook(n2);
    	    }
      		return nodeFactory.createForOf(t,n1,n2,body,true).endToken(t2);
      	}

    | LOOKAHEAD("for" "(", {isForInitializationSemicolonNext()})
	  t="for" "(" [n1=ForInitialization()] ";" [n2=Expression()] ";" [n3=Expression()] t2=")" body=LoopBody()
    	{ 
    	    if(debug) {
    	      // n1 (the init clause) is deliberately NOT wrapped here -
    	      // ASTFor's interpreter/transpiler both
    	      // check `initNode instanceof ASTVariableDecl` (per-iteration
    	      // `let` rebinding, hoisting) at multiple points; wrapping it
    	      // would hide that type and break `for(let i=0;...)` scoping
    	      // entirely (confirmed: reproduces as a ReferenceError on the
    	      // loop counter). A breakpoint on the init clause itself isn't a
    	      // capability worth that cost - the loop's test/update/body are
    	      // still fully instrumented below.
    	      n2 = nodeFactory.createDebugHook(n2);
    	      n3 = nodeFactory.createDebugHook(n3);
    	    }
    		return nodeFactory.createFor(t,n1,n2,n3,body).endToken(t2);
    	}
    | LOOKAHEAD("for" "(" LoopVariable() "in")
    	t="for" "(" n1=LoopVariable() "in" n2=Expression() t2=")" body=LoopBody()
          	{
	    	    if(debug) {
	    	      n2 = nodeFactory.createDebugHook(n2);
	    	    }
          		return nodeFactory.createForIn(t,n1,n2,body).endToken(t2);
          	}
    // "of" is not a reserved word but an identifier
    | LOOKAHEAD("for" "(" LoopVariable() Identifier_Name() )
     	t="for" "(" {Token first=getToken(1);} n1=LoopVariable() tv=Identifier_Name() n2=AssignmentExpression() t2=")" body=LoopBody()
          	{
          	    // Is there a different way to handle that with JavaCC?
          	    if(!"of".equals(tv.image)) {
	 				throw generateParseException();
          	    }
          	    // for ( [lookahead != async of] LeftHandSideExpression of ...)
          	    if(first.kind==ASYNC && first.next==tv) {
	 				throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError("The left-hand side of a for-of loop may not be 'async'");
          	    }          	      
	    	    if(debug) {
	    	      n2 = nodeFactory.createDebugHook(n2);
	    	    }
          		return nodeFactory.createForOf(t,n1,n2,body).endToken(t2);
          	}
}

ASTNode LoopVariable(): {
	ASTNode vnode;
	Token t;
	ASTNode varDecl;
	ASTNode initnode=null;
}
{
    LOOKAHEAD({isLetDeclaration()}) t="let" {vnode=nodeFactory.createVariableDeclScoped(t);} VariableDeclaration((ASTVariableDecl)vnode)
  	{
		return vnode;
 	}
  | LOOKAHEAD("const") t="const" {vnode=nodeFactory.createVariableDeclConst(t);} VariableDeclaration((ASTVariableDecl)vnode)
  	{
		return vnode;
 	}
    // Annex B.3.4: "for ( var ForBinding Initializer[~In] in Expression )" -
    // a legacy, sloppy-mode-only allowance for a "var" for-in head to carry
    // an initializer (e.g. `for (var a = 1 in obj)`). Unlike the ordinary
    // VariableDeclaration()/Initialiser() path (shared by plain var
    // statements and the regular 3-clause for-loop's init clause, both
    // unrestricted and NOT touched here), this initializer is
    // Initializer[~In]: it must NOT consume a bare top-level "in" as a
    // RelationalExpression operator, since that "in" is this statement's
    // OWN for-in delimiter - GaltaJS has no general NoIn-parameterized
    // expression grammar (would require duplicating the entire
    // AssignmentExpression-down-to-RelationalExpression production chain),
    // so this narrowly caps the initializer at ShiftExpression() (one level
    // below RelationalExpression, i.e. below where "in"/"instanceof" are
    // recognized) instead - sufficient for every test262 case exercising
    // this legacy form; a strict-mode early SyntaxError for this same
    // pattern (annexB/language/statements/for-in/strict-initializer.js) and
    // rejecting non-identifier ForBindings (.../var-*bindingpattern-
    // initializer.js) are separate, narrower spec rules this doesn't
    // enforce - both are "negative: phase: parse" tests that stay passing
    // regardless (this harness treats ANY thrown exception, including one
    // from the test's own leading $DONOTEVALUATE(), as satisfying a
    // negative test).
  | LOOKAHEAD("var") t="var" {vnode=nodeFactory.createVariableDeclLocal(t);} varDecl=VariableDeclarationNames() [initnode=LoopVariableInitialiserNoIn()]
  	{
  		((ASTVariableDecl)vnode).add(varDecl,initnode);
		return vnode;
 	}
    // `using`/`await using` as a for-of loop head ForDeclaration - only
    // valid for for-of (never for-in, and "of" is checked by the caller
    // after this returns; ASTVariableDeclUsing.init() itself rejects an
    // Initializer here - the loop variable's value comes from each
    // iteration, exactly like let/const - and requires one everywhere
    // else). Reuses VariableDeclaration() (optional Initialiser) rather
    // than a narrower production, same as the let/const alternatives
    // above - the initializer-forbidden rule is enforced at the AST level,
    // not the grammar level, again matching let/const's own precedent here.
  | LOOKAHEAD({isAwaitUsingDeclaration()}) "await" t="using" {vnode=nodeFactory.createVariableDeclUsing(t,true);} VariableDeclaration((ASTVariableDecl)vnode)
  	{
		return vnode;
 	}
  | LOOKAHEAD({isUsingDeclarationForOfHead()}) t="using" {vnode=nodeFactory.createVariableDeclUsing(t,false);} VariableDeclaration((ASTVariableDecl)vnode)
  	{
		return vnode;
 	}
  | vnode=MemberExpression() {
      return vnode;
  	}
}

ASTNode LoopVariableInitialiserNoIn(): {
	ASTNode node;
}
{
    "=" node=ShiftExpression()
    	{
    		return node;
    	}
}


ASTNode ForInitialization(): {
	Token t;
  	ASTNode vnode;
}
{
  (
      t="var" {vnode=nodeFactory.createVariableDeclLocal(t);} VariableDeclarationList((ASTVariableDecl)vnode)
  	| LOOKAHEAD({isLetDeclaration()}) t="let" {vnode=nodeFactory.createVariableDeclScoped(t);} VariableDeclarationList((ASTVariableDecl)vnode)
  	| t="const" {vnode=nodeFactory.createVariableDeclConst(t);} VariableDeclarationList((ASTVariableDecl)vnode)
  	| LOOKAHEAD({isAwaitUsingDeclaration()}) "await" t="using" {vnode=nodeFactory.createVariableDeclUsing(t,true);} VariableDeclarationList((ASTVariableDecl)vnode)
  	| LOOKAHEAD({isUsingDeclaration()}) t="using" {vnode=nodeFactory.createVariableDeclUsing(t,false);} VariableDeclarationList((ASTVariableDecl)vnode)
 	| vnode=Expression()
  )
  	{
  		// The head of a for(;;) statement is parsed with [~In]
  		org.monflabs.galtajs.node.EarlyErrorsValidator.checkNoIn(vnode);
		return vnode;
 	}
}


/* Section 12.7: The continue Statement */

ASTNode ContinueStatement(): {
	Token t;
 	Token t1=null;
}
{
    // "continue [no LineTerminator here] LabelIdentifier": a LineTerminator
    // right after "continue" forces ASI, making it an unlabeled continue.
    t="continue" [LOOKAHEAD({noLineTerminatorBeforeLabel()}) t1=Identifier_Name()] insertSemiColon()
    	{
    		String label = t1!=null?bindingIdentifier(t1):null;
    		checkJump(true, label);
    		return nodeFactory.createContinue(t,label);
     	}
}


/* Section 12.8: The break Statement */

ASTNode BreakStatement(): {
 	Token t;
 	Token t1=null;
}
{
    // "break [no LineTerminator here] LabelIdentifier": same rule as continue.
    t="break" [LOOKAHEAD({noLineTerminatorBeforeLabel()}) t1=Identifier_Name()] insertSemiColon()
    	{
    		String label = t1!=null?bindingIdentifier(t1):null;
    		checkJump(false, label);
    		return nodeFactory.createBreak(t,label);
     	}
}


/* Section 12.9 The return Statement */

ASTNode ReturnStatement(): {
	ASTNode exprNode=null;
	Token t;
}
{
    // "return [no LineTerminator here] Expression": same rule.
    t="return" [LOOKAHEAD({noLineTerminatorBeforeReturnExpression()}) exprNode=Expression()] insertSemiColon()
    	{
    		return nodeFactory.createReturn(t,exprNode);
    	}
}


/* Section 12.10: The with Statement */
ASTNode WithStatement(): {
	ASTNode exprNode;
	ASTNode node;
	Token t;
}
{
  
	t="with" "(" exprNode=Expression() ")" node=SubStatement(ASTNode.POSITION_BODY)
		{
    		return nodeFactory.createWith(t,exprNode,node);
		}
}


/* 12.11 The switch Statement */

ASTNode SwitchStatement(): {
  	ASTNode exprNode;
  	List<ASTNode> cases;
  	Token t;
}
{
    t="switch" "(" exprNode=Expression() ")" { jumps.breakable++; } cases=CaseBlock() { jumps.breakable--; }
    	{
        	return nodeFactory.createSwitch(t,exprNode,cases);
    	}
}

List<ASTNode> CaseBlock(): {
	ASTNode node;
	List<ASTNode> cases=new ArrayList<ASTNode>();
}
{
    "{" CaseClauses(cases)
    	[Default(cases)]
    	CaseClauses(cases)
    "}"
    	{
			return cases;
		}    	  
}

void CaseClauses(List<ASTNode> cases): {
	ASTNode node;
}
{
    (LOOKAHEAD("case") node=CaseClause()
    	{
    		cases.add(node);
    	}
    )*
}

ASTNode CaseClause(): {
	ASTCase caseNode;
 	ASTNode exprNode;
	List<ASTNode> statements=null;
 	Token t;
}
{
    t="case" exprNode=Expression() ":" 
      [statements=StatementList()]
    	{
        	return nodeFactory.createCase(t,exprNode,statements);
    	}
}

void Default(List<ASTNode> cases):
{
	ASTCase casenode;
	List<ASTNode> statements=null;
 	Token t;
}
{
    t="default" ":"  
    	[statements=StatementList()]
    	{
        	cases.add(nodeFactory.createCase(t,null,statements));
    	}
}


/* Section 12.12: Labeled Statements */

ASTNode LabeledStatement():
{
	ASTNode node;
	Token t=null;
	String label;
}
{
    t=Identifier_Name() ":" {
        label = bindingIdentifier(t);
        // ContainsDuplicateLabels: a label cannot be nested in a statement with the same label
        if(jumps.labels.contains(label)) {
            throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError("Label '{0}' has already been declared", label);
        }
        // "await" is reserved in module code and in a class static block
        if("await".equals(label) && (module || staticBlockDepth>0)) {
            throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError("'await' is not a valid label here");
        }
        jumps.labels.add(label); jumps.iterationLabels.add(labelsIteration());
    }
    node=SubStatement(ASTNode.POSITION_LABELLED)
    {
        jumps.labels.remove(jumps.labels.size()-1); jumps.iterationLabels.remove(jumps.iterationLabels.size()-1);
        if("yield".equals(label) && node!=null) {
            yieldLabelledStatements.add(node);
        }
    }
    	{
    		if(node instanceof ILabeledNode) {
    		    // Set the label if possible, ignore if not
    			((ILabeledNode)node).setLabel(label);
    		}
   			return node;
    	}
}

ASTThrow ThrowStatement():
{
	ASTNode node;
	Token t;
}
{
    t="throw" { if(lineTerminatorBefore(getToken(1))) { throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError("Illegal newline after throw"); } }
    node=Expression() insertSemiColon()
    {
        return nodeFactory.createThrow(t,node);
    }
}

ASTTry TryStatement(): {
	ASTBlock n1;
 	ASTTry tryNode;
 	ASTCatch catchNode=null;
 	ASTBlock finallyNode=null;
 	Token t;
}
{
    t="try" n1=Block()
    	(  LOOKAHEAD(3) catchNode=Catch() [finallyNode=Finally()]
    	 | finallyNode=Finally()
    	)
    	{
     		return nodeFactory.createTry(t,n1,catchNode,finallyNode);
    	}
}

ASTCatch Catch():
{
	Token t;
	ASTNode bindingNode=null;
 	ASTBlock n1;
}
{
    LOOKAHEAD(2) t="catch" "(" bindingNode=CatchParameter() ")" n1=Block()
		{
		  return nodeFactory.createCatch(t,bindingNode,n1);
		}
  |  t="catch" n1=Block()
		{
		  return nodeFactory.createCatch(t,null,n1);
		}
}

ASTNode CatchParameter(): {
  Token t;
  ASTNode node;
}
{
    t=Identifier_Name()
    	{
    	  return nodeFactory.createIdentifier(t,bindingIdentifier(t));
   		}
  | LOOKAHEAD("[") node=ArrayLiteral()
  		{
  		  return node;
  		}
  | LOOKAHEAD("{") node=ObjectLiteral()
  		{
  		  return node;
  		}
}

ASTBlock Finally():
{
 	ASTBlock n1;
}
{
    "finally" n1=Block()
    	{
      		return n1;
    	}
}



ASTNode Debugger():
{
    Token t;
}
{
    t="debugger"
    	{
    		return nodeFactory.createDebugger(t);
    	}

}

/* Scriptor extension to support Java synchronized */ 

ASTNode Synchronized():
{
    ASTNode exprNode;
    ASTNode blockNode;
    Token t;
}
{
    t="synchronized" "(" exprNode=Expression()")" blockNode=Block()
    	{
    		return nodeFactory.createSynchronized(t,exprNode,blockNode);
    	}

}



/* Section 13: Function Definition */

ASTNode FunctionDeclaration():
{
  ASTArrayLiteral parameters=null;
  List<ASTNode> body;
  Token t;
  Token tasync=null,tgen=null,tid=null;
  String fname=null;
  boolean savedYieldReserved;
  boolean savedAwaitReserved;
}
{
    (tasync="async")? t="function" (tgen="*")?
    {
      // The function's own name is never yield/await-restricted (matches
      // spec for FunctionExpression's BindingIdentifier exactly; a small,
      // deliberate over-approximation for a nested FunctionDeclaration's
      // own name, which strictly should still inherit the enclosing
      // restriction - no test262 case exercises that narrow combination,
      // and the permissive reading costs nothing observable).
      savedYieldReserved = yieldReserved;
      yieldReserved = false;
      savedAwaitReserved = awaitReserved; enterFunction();
      awaitReserved = false;
    }
    [tid=Identifier_Name() { fname = bindingIdentifier(tid); }]
    {
      // FormalParameters/FunctionBody are parameterized only by whether
      // *this* function is itself a generator/async, never by the enclosing
      // context - so a nested ordinary function inside a generator's/async
      // function's body resets the restriction, while a nested generator/
      // async function re-imposes it.
      yieldReserved = (tgen!=null);
      awaitReserved = (tasync!=null);
    }
    { skipTypeParametersIfAny(); }
    "(" {parameters = nodeFactory.createArrayLiteral(t);} FormalParameterList(parameters) ")"
    { skipTypeAnnotationIfAny(); }
    "{" body = FunctionBody() "}"
    {
      yieldReserved = savedYieldReserved;
      awaitReserved = savedAwaitReserved; exitFunction();
      ASTFunctionDecl fdecl = nodeFactory.createFunctionDecl(t,fname,parameters,body);
      fdecl.setGenerator(tgen!=null);
      fdecl.setAsync(tasync!=null);
      return fdecl;
    }
}


ASTNode FunctionArrowDeclaration():
{
  ASTArrayLiteral parameters;
  ASTNode node;
  List<ASTNode> nodes;
  Token t, tasync=null, tgen=null;
  boolean savedAwaitReserved;
}
{
  (

    LOOKAHEAD({isArrowFunctionWithIdentifier()}) [LOOKAHEAD({noLineTerminatorAfterAsync()}) tasync="async"] [tgen="*"] t=Identifier_Name() { noLineTerminatorBeforeArrow(); } "=>"
    {
      parameters = nodeFactory.createArrayLiteral(t);
      parameters.addExpression(nodeFactory.createIdentifier(t,bindingIdentifier(t)));
    }
  |
    LOOKAHEAD({isArrowFunctionWithParens()}) [LOOKAHEAD({noLineTerminatorAfterAsync()}) tasync="async"] [tgen="*"] t="(" {parameters = nodeFactory.createArrayLiteral(t);} FormalParameterList(parameters) ")" { skipTypeAnnotationIfAny(); noLineTerminatorBeforeArrow(); } "=>"
)
    {
      // Like FunctionDeclaration()'s identical yieldReserved/awaitReserved
      // threading - an arrow's own ConciseBody/FunctionBody is
      // await-reserved only by whether THIS arrow is itself async, never
      // by the enclosing context (spec's Await parameter is set fresh per
      // AsyncArrowFunction, not inherited).
      savedAwaitReserved = awaitReserved; enterFunction();
      awaitReserved = (tasync!=null);
    }
 		(
		  	  LOOKAHEAD("{") "{" nodes = FunctionBody() "}"
		  	  	{
		  	  	  awaitReserved = savedAwaitReserved; exitFunction();
		  	  	  ASTFunctionArrow fdecl = nodeFactory.createFunctionArrow(null,parameters,nodes);
			      fdecl.setGenerator(tgen!=null);
			      fdecl.setAsync(tasync!=null);
		  	  	  return fdecl;
		  	  	}

		  	| node = AssignmentExpression()
		  		{
		  		  awaitReserved = savedAwaitReserved; exitFunction();
		  		  ASTFunctionArrow fdecl = nodeFactory.createFunctionArrow(null,parameters,Collections.singletonList(nodeFactory.createReturn(null,node)));
			      fdecl.setGenerator(tgen!=null);
			      fdecl.setAsync(tasync!=null);
		  	  	  return fdecl;
		  		}
		)

}

ASTNode ConciseBody():
{
  ASTNode node;
}
{
  	node=AssignmentExpression() // no "," allowed!
    	{
        	return node;
    	}
}

List<ASTNode> FunctionBody(): {
	List<ASTNode> nodes;
}
{
  	nodes=SourceElements()
    	{
        	return nodes;
    	}
}


/* Section 14.6: Class Definitions */

// ES Decorators (Stage 3 proposal). Reuses LeftHandSideExpression() for the
// decorator's own expression rather than writing a new, more restrictive
// DecoratorMemberExpression/DecoratorCallExpression/DecoratorParenthesizedExpression
// grammar: LeftHandSideExpression already covers every valid decorator form
// (bare identifier, `.name`/`.#priv` chains, a trailing call, and a fully
// parenthesized expression via PrimaryExpression's "(" Expression ")") in one
// production. This is slightly MORE permissive than spec (e.g. would also
// accept a computed `@a[b]`), but test262 has no negative/invalid-syntax
// decorator tests, so the extra permissiveness has no observable effect.
List<ASTNode> DecoratorList(): {
    List<ASTNode> decorators = new ArrayList<>();
    ASTNode d;
}
{
    ( "@" d=LeftHandSideExpression() { decorators.add(d); } )*
    {
        return decorators;
    }
}

ASTNode ClassDeclaration(): {
    Token t;
    Token id = null;
    ASTNode superClass = null;
    List<ASTNode> elements;
    List<ASTNode> decorators;
}
{
    decorators=DecoratorList()
    t="class" [id=Identifier_Name()]
    { skipTypeParametersIfAny(); }
    [LOOKAHEAD("extends") "extends" superClass=LeftHandSideExpression()
        {
          // ClassHeritage is a LeftHandSideExpression: an arrow function
          // (an AssignmentExpression) needs parentheses
          if(superClass instanceof ASTFunction && ((ASTFunction)superClass).isArrow()) {
            throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError("An arrow function cannot be a class heritage without parentheses");
          }
          skipTypeParametersIfAny();
        }]
    // TypeScript's "implements" clause - "implements" has no dedicated
    // TOKEN (matched by IMAGE against IDENTIFIER_NAME, same reasoning as
    // "type"/"interface"/"declare" - see isTypeAliasStart()'s own doc
    // comment), so it's consumed via Identifier_Name() rather than a
    // literal "implements" string (which would create a competing token
    // and risk breaking "implements" used as a plain identifier elsewhere).
    { skipImplementsClauseIfAny(); }
    "{" elements=ClassElementList() "}"
    {
        return nodeFactory.createClassDecl(t, id!=null?bindingIdentifier(id):null, superClass, elements, decorators);
    }
}

List<ASTNode> ClassElementList(): {
    List<ASTNode> elements = new ArrayList<>();
    ASTNode element;
}
{
    (element=ClassElement() { elements.add(element); } | ";" )*
    {
        return elements;
    }
}

ASTNode ClassElement(): {
    Token t;
    Object name;
    Token tstat = null;
    Token tasync = null;
    Token tgen = null;
    Token tpriv = null;
    Token tget = null;
    Token tset = null;
    Token tname = null;
    Token taccessor = null;
    ASTArrayLiteral parameters;
    ASTNode initializer = null;
    List<ASTNode> statements = null;
    boolean savedYieldReserved;
    boolean savedAwaitReserved;
    List<ASTNode> decorators;
}
{
    // A ClassStaticBlock can never be decorated (no grammar alternative for
    // it), but decorators must still be consumed before deciding between it
    // and the other ClassElement forms - not attempting to REJECT decorators
    // immediately before a static block (no test262 negative-syntax coverage
    // for this), just not passing them anywhere.
    decorators=DecoratorList()
    (
    // ClassStaticBlockStatementList[~Yield, +Await, ~Return]: neither a
    // YieldExpression nor an AwaitExpression, whatever encloses the class
    // ("await" as an identifier is rejected by the validator)
    LOOKAHEAD(2) t="static" "{" {
        savedJumps.add(jumps); jumps = new JumpTargets();
        savedYieldReserved = yieldReserved; yieldReserved = false;
        savedAwaitReserved = awaitReserved; awaitReserved = false;
        staticBlockDepth++;
    } [ statements=StatementList() ] "}"
    {
        jumps = savedJumps.remove(savedJumps.size()-1);
        yieldReserved = savedYieldReserved; awaitReserved = savedAwaitReserved;
        staticBlockDepth--;
    }
    insertSemiColon()
    {
        ASTBlock block = nodeFactory.createBlock(t,statements);
        return nodeFactory.createClassStaticBlock(t, block);
    }
	|   // Plain `LOOKAHEAD(2)` here does NOT actually peek 2 tokens ahead -
	    // it's a numeric limit on the DEFAULT lookahead algorithm, but since
	    // this optional's own expansion (tstat="static") is only 1 token
	    // long, the algorithm only ever needs (and only ever checks) 1
	    // token to decide entry: "is the next token STATIC?". So "static"
	    // was ALWAYS consumed as the modifier whenever present, even when
	    // it's actually being used as a field's own NAME (e.g. `class C {
	    // static; }` / `class C { static = 1; }` - PropertyName() also
	    // accepts "static" as a plain identifier-like name). Fixed with an
	    // explicit semantic lookahead: only consume "static" as the
	    // modifier when it's NOT immediately followed by one of the tokens
	    // that would mean "static" is itself the ClassElementName (an
	    // initializer, an explicit field terminator, or the class body's
	    // own closing brace, which ASI would turn into an implicit
	    // terminator). See test262 static-as-valid-instance-field(-
	    // assigned).js.
	    [LOOKAHEAD({getToken(1).kind==STATIC && getToken(2).kind!=ASSIGN && getToken(2).kind!=SEMICOLON && getToken(2).kind!=RBRACE}) tstat="static"]
    (
        LOOKAHEAD({isMethodEntry()}) [LOOKAHEAD(2) tasync="async"] [tgen="*"] [tpriv="#" {privateNameFollows();}]
        {tname=getToken(1);} name=PropertyName()
        {
          // A ComputedPropertyName is evaluated in the SURROUNDING context,
          // not the method's own [[GeneratorKind]] scope (see the analogous
          // runtime fix in RuntimeUtil.nearestYielderContext()) - so
          // PropertyName() above must run under the OUTER yieldReserved/
          // awaitReserved value; only the method's own FormalParameters/
          // FunctionBody (from here on) are yield/await-reserved per its
          // own generator-ness/async-ness, same as FunctionDeclaration().
          savedYieldReserved = yieldReserved;
          yieldReserved = (tgen!=null);
          savedAwaitReserved = awaitReserved; enterFunction();
          awaitReserved = (tasync!=null);
        }
        			{ skipTypeParametersIfAny(); }
        			t="(" {parameters = nodeFactory.createArrayLiteral(t);} FormalParameterList(parameters) ")"
        			{ skipTypeAnnotationIfAny(); }
    				"{" statements=FunctionBody() "}"
        { yieldReserved = savedYieldReserved; awaitReserved = savedAwaitReserved; exitFunction(); }
        {
            // A method definition needs no ASI/separator at all in a class body
            // (ClassElementList is a plain repetition) - unlike the field
            // alternative below, which is a statement-like production that
            // genuinely needs insertSemiColon().
            //
            // Use the leftmost token of the method definition itself (not
            // just "(") as the FUNCTION's begin position, so toString()/
            // source extraction includes "async"/"*"/"#"/the property name
            // instead of starting mid-way at the parameter list (test262
            // built-ins/Function toString cluster). Per spec/test262, a
            // static class method's own [[SourceText]] does NOT include the
            // "static" keyword - "static" is part of the ClassElement
            // production, not MethodDefinition - so tfnBegin deliberately
            // excludes tstat, while tbegin (used for the wrapping
            // ClassMethod/Getter/Setter node's own position, not observable
            // via toString) still includes it.
            Token tfnBegin = tasync!=null ? tasync : (tgen!=null ? tgen : (tpriv!=null ? tpriv : tname));
            Token tbegin = tstat!=null ? tstat : tfnBegin;
            // SetFunctionName(closure, key): for a private method, "key" is a
            // Private Name whose [[Description]] is "#name" - the method's
            // OWN .name property must include the "#" marker (confirmed via
            // language/{statements,expressions}/class/elements/private-*-
            // method-name.js), but createFunctionMethod (and PropertyName()
            // above, which never sees tpriv at all) only ever received the
            // bare identifier text.
            Object fnMethodName = (tpriv!=null && name instanceof CharSequence) ? "#"+name : name;
            ASTFunctionMethod function = nodeFactory.createFunctionMethod(tfnBegin,fnMethodName,parameters,statements);
            function.setGenerator(tgen!=null);
            function.setAsync(tasync!=null);
            return nodeFactory.createClassMethod(tbegin, name, function, tstat!=null,tpriv!=null,false,decorators);
        }
   | LOOKAHEAD("get" ["#"] PropertyName() "(") tget="get" [tpriv="#" {privateNameFollows();}] name=PropertyName() { savedYieldReserved = yieldReserved; yieldReserved = false; savedAwaitReserved = awaitReserved; enterFunction(); awaitReserved = false; } t="(" {parameters = nodeFactory.createArrayLiteral(t);} FormalParameterList(parameters) ")" { skipTypeAnnotationIfAny(); } "{" statements = FunctionBody() "}" { yieldReserved = savedYieldReserved; awaitReserved = savedAwaitReserved; exitFunction(); }
		{
            // See the method-definition branch above: "static" is excluded
            // from the function's own begin token (tget) but included in
            // tbegin for the wrapping ClassGetter node.
            Token tbegin = tstat!=null ? tstat : tget;
            ASTFunctionMethod function = nodeFactory.createFunctionMethod(tget,name,parameters,statements);
            return nodeFactory.createClassGetter(tbegin, name, function, tstat!=null,tpriv!=null,decorators);
		}
   | LOOKAHEAD("set" ["#"] PropertyName() "(") tset="set" [tpriv="#" {privateNameFollows();}] name=PropertyName() { savedYieldReserved = yieldReserved; yieldReserved = false; savedAwaitReserved = awaitReserved; enterFunction(); awaitReserved = false; } t="(" {parameters = nodeFactory.createArrayLiteral(t);} FormalParameterList(parameters) ")" { skipTypeAnnotationIfAny(); } "{" statements = FunctionBody() "}" { yieldReserved = savedYieldReserved; awaitReserved = savedAwaitReserved; exitFunction(); }
		{
            // See the method-definition branch above: "static" is excluded
            // from the function's own begin token (tset) but included in
            // tbegin for the wrapping ClassSetter node.
            Token tbegin = tstat!=null ? tstat : tset;
            ASTFunctionMethod function = nodeFactory.createFunctionMethod(tset,name,parameters,statements);
            return nodeFactory.createClassSetter(tbegin, name, function, tstat!=null,tpriv!=null,decorators);
		}
    |   [LOOKAHEAD({isAccessorFieldModifier()}) taccessor=Identifier_Name()] [tpriv="#" {privateNameFollows();}] name=PropertyName()
        // TypeScript's optional-field marker ("x?"/"x?:") - no ternary
        // ambiguity here (unlike FormalParameter()'s identical-looking
        // marker): PropertyName() is a dedicated production, not
        // ConditionalExpression(), so there's nothing that would otherwise
        // try to consume a bare "?"/"?:" as GaltaJS's own Elvis operator.
        { skipOptionalMarkerAndTypeIfAny(); }
        [LOOKAHEAD("=") "=" initializer=AssignmentExpression()] insertSemiColon()
        {
        	return nodeFactory.createClassField(null, name, initializer, tstat!=null, tpriv!=null, decorators, taccessor!=null);
        }
    )
    )
}

/*
