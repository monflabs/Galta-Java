	String name;
	ASTNode f;
	ASTNode n=null;
 	ASTArrayLiteral parameters=null;
  	Token t=null;
  	Token tgen=null;
  	List<ASTNode> body=null;
}	
{
     LOOKAHEAD(2) name=PropertyName() ":" n=AssignmentExpression() 
		{
      		node.addExpression(name, n);
		}
   | LOOKAHEAD(3) (tgen="*")? name=PropertyName() t="(" {parameters = nodeFactory.createArrayLiteral(t);} ElementList(parameters) ")" "{" body = FunctionBody() "}"
