/*
  GaltaJS Parser

  Inspired from
  		http://svn.dojotoolkit.org/src/trunk/tools/jslinker/src/org/dojo/jsl/parser/EcmaScript.jjt
        https://github.com/javacc/javacc/blob/master/docs/grammars/EcmaScript.jjt
        https://github.com/highsource/javascript-codemodel/tree/master/parser/src/main/javacc

		ES 6 grammar
        https://gist.github.com/rbuckton/0d8c1f1c607f52f5ae37
*/

options {
	/*
	 * Default value is true. If true, all methods and class variables 
	 * are specified as static in the generated parser and token manager. This allows only 
	 * one parser object to be present, but it improves the performance of the parser.
	 */
	STATIC = false;

	/*
	 * Default value is false. When set to true, the generated parser 
	 * uses an input stream object that processes Java Unicode escapes before 
	 * sending characters to the token manager.
	 * We set it to false as strings can contain there own escape and we don't want them
	 * to be processed. 
	 */
	JAVA_UNICODE_ESCAPE = false;

	/*
	 * Default value is false. When set to true, the generated parser 
	 * uses uses an input stream object that reads Unicode files. By default, ASCII files 
	 * are assumed. 
	 */
	UNICODE_INPUT = true;

	/*
	 * For debugging
	 */
	DEBUG_PARSER = false;
	DEBUG_TOKEN_MANAGER = false;

	/*
	 * JDK Version
	 */
	//JDK_VERSION = "1.5";
	
	//USER_CHAR_STREAM = true;

}

PARSER_BEGIN(JSParser)


package org.monflabs.galtajs.parser;

import org.monflabs.util.io.FastStringReader;
import org.monflabs.galtajs.*;
import org.monflabs.galtajs.rt.*;
import org.monflabs.galtajs.rt.util.NumberFormatting;
import org.monflabs.galtajs.rt.RuntimeUtil.MODE;
import org.monflabs.galtajs.node.*;
import org.monflabs.galtajs.node.clazz.*;
import org.monflabs.galtajs.node.literal.*;
import org.monflabs.galtajs.node.control.*;
import org.monflabs.galtajs.node.variable.*;
import org.monflabs.galtajs.node.debug.*;


import java.util.*;

@SuppressWarnings({"unused","null"})
public class JSParser {
	// ECMAScript 2023 - Shebang
	// It is easier to impolement it as this level because of space handling
    // Annex B.1.1: at the very start of the source (no LineTerminator before
    // it), "-->" is still a SingleLineHTMLCloseComment when only white space
    // and single-line delimited comments precede it. The lexer only sees
    // "-->" after a LineTerminator or a multi-line comment, so this case is
    // handled here by starting the reader after that first line.
    private static final int skipLeadingHtmlCloseComment(String s, int start) {
        int len = s.length();
        int pos = start;
        while(pos<len) {
            char c = s.charAt(pos);
            if(c==' ' || c=='\t' || c==(char)0x0B || c==(char)0x0C || c==(char)0xA0 || c==(char)0xFEFF) {
                pos++;
            } else if(s.startsWith("/*", pos)) {
                int end = s.indexOf("*/", pos+2);
                if(end<0 || containsLineTerminator(s.substring(pos, end))) {
                    return start;
                }
                pos = end+2;
            } else {
                break;
            }
        }
        if(!s.startsWith("-->", pos)) {
            return start;
        }
        while(pos<len) {
            char c = s.charAt(pos);
            if(c=='\n' || c=='\r' || c==(char)0x2028 || c==(char)0x2029) {
                break;
            }
            pos++;
        }
        return pos;
    }

    private static final int removeShebang(String s) {
        if(s.startsWith("#!")) {
          int len = s.length();
          int pos = 2;
          while(pos<len) {
            char c = s.charAt(pos++);
            if(c=='\n') {
              if(pos<len && s.charAt(pos)=='\r') {
                pos++;
              }
              return pos;
            }
            if(c=='\r') {
              if(pos<len && s.charAt(pos)=='\n') {
                pos++;
              }
              return pos;
            }
            // Line separator (U+2028) and paragraph separator (U+2029) are
            // also LineTerminators per the spec, ending the hashbang comment.
            if(c=='\u2028' || c=='\u2029') {
              return pos;
            }
          }
          return len;
        }
        return 0;
    }

    // Used by checkSemiColon() to detect a MultiLineComment that spans a
    // LineTerminator (spec 12.4: such a comment counts as a LineTerminator
    // for ASI purposes even though its closing "*/" doesn't).
    private static final boolean containsLineTerminator(String s) {
        for(int i=0; i<s.length(); i++) {
            char c = s.charAt(i);
            if(c=='\n' || c=='\r' || c=='\u2028' || c=='\u2029') {
                return true;
            }
        }
        return false;
    }

    // This avoid an exception to be created when it reaches the EOF
	// The JavaCharStream.FillBuff() should be modified accordingly
	static final java.io.IOException EOF_EXCEPTION = new java.io.IOException();  
	 
 	// JSEnvironment used for the compilation
  	public JSEnvironment env;
  	public NodeFactory nodeFactory;
  	// Gates ASTDebugHook insertion (the CDP-oriented instrumentation) - see
  	// ASTDebugHook's own doc comment.
  	public boolean debug;

  	// True while parsing directly within a generator's own FormalParameters/
  	// FunctionBody, where "yield" is the YieldExpression keyword rather than
  	// a usable identifier. Reset to false when descending into a *nested*
  	// ordinary (non-generator) function's own name/params/body - per spec,
  	// FunctionDeclaration/FunctionExpression's own FormalParameters/
  	// FunctionBody are never parameterized by the enclosing context, only by
  	// whether that function is itself a generator. Left UNCHANGED when
  	// descending into an arrow function, since arrows have no own
  	// [[GeneratorKind]] and inherit the enclosing restriction. Strict-mode
  	// reserved-ness of "yield" is a separate, still-unhandled gap (the
  	// parser doesn't track strict-mode-ness at all - see KnownGaps.md).
  	private boolean yieldReserved = false;

  	// Mirrors yieldReserved's exact save/set/restore structure/rationale
  	// (see its own comment above), but for "await": UnaryExpression()'s
  	// "await" alternative (below) is only the actual AwaitExpression
  	// production when this is true - otherwise "await" falls through to
  	// being an ordinary identifier (Identifier_Name() already accepts the
  	// AWAIT token unconditionally as a plain name). Explicitly set FALSE
  	// only inside a NON-async function/method/arrow/getter/setter's own
  	// FormalParameters/FunctionBody (and TRUE again inside a nested async
  	// one) - test262 language/expressions/in/private-field-rhs-await-
  	// absent.js: "await(null)" inside a non-async static class method must
  	// be an ordinary function CALL to a same-named outer identifier, not
  	// the await operator.
  	//
  	// Defaults to TRUE (opposite of yieldReserved's FALSE default) - unlike
  	// "yield", which is NEVER valid outside a generator, GaltaJS treats
  	// top-level "await" as already allowed everywhere by design (matching
  	// its "scripting engine for the JVM", not a strict module-vs-script
  	// distinguishing browser/Node runtime - see AsyncAwait2Test.js's own
  	// top-level "await runAllTests();"). Confirmed via AllGaltaJSTests: a
  	// FALSE default broke that pre-existing, intentional top-level-await
  	// usage - TRUE preserves it while the explicit FALSE at every genuinely
  	// non-async function boundary still fixes the reported bug.
  	private boolean awaitReserved = true;
  	// Number of enclosing functions (their parameters or body) at the
  	// current parse position, maintained together with awaitReserved's
  	// save/restore: 0 is the top level, where "await" stays a valid
  	// identifier even though awaitReserved (top-level await) is true.
  	private int functionDepth;

  	// The break/continue targets visible at the current parse position
  	// (labels, enclosing loops and switches), reset at each function
  	// boundary: a break or continue without a matching target is an early
  	// SyntaxError.
  	private static final class JumpTargets {
  		final ArrayList<String> labels = new ArrayList<String>();
  		final ArrayList<Boolean> iterationLabels = new ArrayList<Boolean>();
  		int breakable;
  		int iterations;
  	}
  	private JumpTargets jumps = new JumpTargets();
  	private final ArrayList<JumpTargets> savedJumps = new ArrayList<JumpTargets>();

  	private void enterFunction() {
  		functionDepth++;
  		savedJumps.add(jumps);
  		jumps = new JumpTargets();
  		savedStaticBlockDepths.add(staticBlockDepth);
  		staticBlockDepth = 0;
  	}

  	private void exitFunction() {
  		functionDepth--;
  		if(!savedJumps.isEmpty()) {
  			jumps = savedJumps.remove(savedJumps.size()-1);
  		}
  		if(!savedStaticBlockDepths.isEmpty()) {
  			staticBlockDepth = savedStaticBlockDepths.remove(savedStaticBlockDepths.size()-1);
  		}
  	}

  	private void checkJump(boolean isContinue, String label) {
  		if(label!=null) {
  			for(int i=jumps.labels.size()-1; i>=0; i--) {
  				if(jumps.labels.get(i).equals(label) && (!isContinue || jumps.iterationLabels.get(i))) {
  					return;
  				}
  			}
  			throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError(isContinue ? "Undefined continue target '{0}'" : "Undefined label '{0}'", label);
  		}
  		if(isContinue ? jumps.iterations==0 : jumps.breakable==0) {
  			throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError(isContinue ? "Illegal continue statement: no surrounding iteration statement" : "Illegal break statement");
  		}
  	}

  	// Whether the statement after the current label(s) is an iteration statement
  	private boolean labelsIteration() {
  		int i = 1;
  		while(getToken(i).kind!=EOF && getToken(i+1).kind==COLON) {
  			i += 2;
  		}
  		int k = getToken(i).kind;
  		return k==FOR || k==WHILE || k==DO;
  	}

  	// A BindingIdentifier/IdentifierReference/LabelIdentifier: decoded, and
  	// rejected when it spells a reserved word - including "await" in an async
  	// function and "yield" in a generator, escaped or not (the lexer turns
  	// an escaped keyword into a plain IDENTIFIER_NAME).
  	private String bindingIdentifier(Token t) {
  		String id = ASTLiteral.parseBindingIdentifier(t.image);
  		if(functionDepth>0 && awaitReserved && "await".equals(id)) {
  			throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError("'await' is not a valid identifier in an async function");
  		}
  		if(yieldReserved && "yield".equals(id)) {
  			throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError("'yield' is not a valid identifier in a generator");
  		}
  		return id;
  	}

  	// Global import statements used by the compilation
  	public ArrayList<String> imports = new ArrayList<String>();

  	// Placeholder for error recovery
  	public ErrorList errorList;

  	public JSParser(JSEnvironment env, String text, boolean debug) {
  		this(env, text, debug, false);
  	}

  	// module: the source is module code, which has no HTML-like comments
  	// (Annex B.1.1 only extends the script grammar) - see checkModuleCode()
  	public JSParser(JSEnvironment env, String text, boolean debug, boolean module) {
  		this(new FastStringReader(text,module ? removeShebang(text) : skipLeadingHtmlCloseComment(text,removeShebang(text))));
  		this.env = env;
  		this.nodeFactory = NodeFactory.DEFAULT;
  		this.debug = debug;
  		this.module = module;
  		this.firstToken = token;
  	}

  	private Token firstToken;
  	private boolean module;

  	// Class static blocks enclosing the current parse position, within the
  	// current function (saved and reset by enterFunction()/exitFunction())
  	private int staticBlockDepth;
  	private final ArrayList<Integer> savedStaticBlockDepths = new ArrayList<Integer>();

  	// Statements labelled "yield": an early error in strict code, which only
  	// the validator knows (the parser does not track strictness)
  	private final ArrayList<ASTNode> yieldLabelledStatements = new ArrayList<ASTNode>();
  	public List<ASTNode> getYieldLabelledStatements() {
  		return yieldLabelledStatements;
  	}

  	// Module code: an HTML-like comment ("<!--", or "-->" at the start of a
  	// line) is not a comment, so the source cannot be valid as lexed. Called
  	// after a successful parse; the tokens keep their comments as special tokens.
  	public void checkModuleCode() {
  		for(Token t=firstToken; t!=null; t=t.next) {
  			for(Token s=t.specialToken; s!=null; s=s.specialToken) {
  				if(s.kind==HTML_CLOSE_COMMENT
  						|| (s.kind==SINGLE_LINE_COMMENT && s.image.startsWith("<!--"))
  						|| (s.kind==MULTI_LINE_COMMENT && !s.image.endsWith("*/"))) {
  					throw new JSParseException(null, null, "HTML-like comments are not allowed in module code (line {0}, column {1})", s.beginLine, s.beginColumn);
  				}
  			}
  		}
  	}

  	// ArrowParameters [no LineTerminator here] =>
  	private void noLineTerminatorBeforeArrow() {
  		if(lineTerminatorBefore(getToken(1))) {
  			throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError("Illegal newline before =>");
  		}
  	}

  	// Helper when forwarding an exception
  	private ParseException generateParseException(Throwable t) {
  	  ParseException e = generateParseException();
  	  e.initCause(t);
  	  return e;
 	}

 	// [no LineTerminator here] check for postfix ++/--
 	private boolean noLineTerminatorBeforeNextToken() {
 	  return noLineTerminatorBefore(1);
 	}

 	// [no LineTerminator here] check between "async" and the following token,
 	// e.g. AsyncArrowFunction's "async [no LineTerminator here] ...".
 	private boolean noLineTerminatorAfterAsync() {
 	  return getToken(1).kind==ASYNC && noLineTerminatorBefore(2);
 	}

 	// True when token `index` could be consumed by Identifier_Name() - i.e.
 	// looks like the start of a BindingIdentifier. Used to disambiguate
 	// "using"/"await using" (a contextual-keyword declaration form) from
 	// "using" used as an ordinary identifier (e.g. "using = 1", "using.foo()",
 	// "using;") - a plain expression statement can't have an identifier
 	// directly follow another identifier with no operator between them, so
 	// checking the NEXT token looks like a binding identifier is enough to
 	// tell the two apart without a full syntactic lookahead.
 	private boolean looksLikeBindingIdentifier(int index) {
 	  int k = getToken(index).kind;
 	  return k==IDENTIFIER_NAME || k==GET || k==SET || k==ASYNC || k==AWAIT
 	      || k==SYNCHRONIZED || k==USING || k==STATIC || (k==YIELD && !yieldReserved);
 	}

 	// "using [no LineTerminator here] BindingIdentifier"
 	private boolean isUsingDeclaration() {
 	  return getToken(1).kind==USING && noLineTerminatorBefore(2) && looksLikeBindingIdentifier(2);
 	}

 	// "await [no LineTerminator here] using [no LineTerminator here] BindingIdentifier" -
 	// the LineTerminator restriction is spec'd only between "using" and the
 	// identifier (matching plain "using"); requiring none between "await" and
 	// "using" either is a deliberate, harmless over-restriction (real code
 	// never splits "await using" across lines) that keeps this check simple
 	// and avoids a separate ASI edge case.
 	private boolean isAwaitUsingDeclaration() {
 	  return getToken(1).kind==AWAIT && getToken(2).kind==USING
 	      && noLineTerminatorBefore(2) && noLineTerminatorBefore(3) && looksLikeBindingIdentifier(3);
 	}

 	// A for-of loop head's own carve-out: "using" is excluded from starting a
 	// ForDeclaration when the identifier immediately after it is literally
 	// "of" - otherwise "for (using of of items)" would be genuinely
 	// ambiguous with "using" as a plain ForBinding identifier followed by
 	// the for-of separator "of" (then "of items" as the collection
 	// expression). Confirmed against test262's
 	// language/statements/using/syntax/using-for-using-of-of.js, which
 	// requires the latter reading unconditionally. "await using" has no
 	// equivalent ambiguity - there's no reading where "await" alone is the
 	// ForBinding and "using" doubles as the for-of separator, since "using"
 	// is never literally "of" or "in".
 	private boolean isUsingDeclarationForOfHead() {
 	  return isUsingDeclaration() && !"of".equals(getToken(2).image);
 	}

 	// "let" starts a LexicalDeclaration only when immediately followed by a
 	// BindingIdentifier, "[" (ArrayBindingPattern) or "{" (ObjectBindingPattern) -
 	// the spec's "[lookahead ∉ { let [ }]" disambiguation (generalized here to
 	// also cover the "{" pattern case, which needs the same treatment).
 	// Otherwise "let" is just a plain Identifier: "for (let in obj)",
 	// "for (let;;)", "let: 1;" (label), "var let = 2;", "let = 1;" all rely on
 	// this. No LineTerminator restriction applies (unlike "using" above) -
 	// per spec, a LexicalDeclaration may span a line break after "let".
 	private boolean isLetDeclaration() {
 	  return getToken(1).kind==LET &&
 	      (looksLikeBindingIdentifier(2) || getToken(2).kind==LBRACKET || getToken(2).kind==LBRACE
 	       // "let let"/"let yield" (in a generator) start a declaration,
 	       // rejected afterwards: no ASI after "let" even across a line break
 	       || getToken(2).kind==LET || getToken(2).kind==YIELD)
 	      // In a single-statement position (if/loop/with body, labelled
 	      // statement) a declaration is not allowed, so "let" followed by a
 	      // line break is the identifier "let" ended by ASI ("if (x) let" then
 	      // "{}" on the next line), except before "[", which ExpressionStatement's
 	      // own lookahead restriction excludes (left to the declaration, then rejected).
 	      && !(subStatement && getToken(2).kind!=LBRACKET && lineTerminatorBefore(getToken(2)));
 	}

 	// A PrivateIdentifier is a single token: no white space or comment
 	// between "#" and the IdentifierName ("# x" is a SyntaxError).
 	private void privateNameFollows() {
 	  if(getToken(1).specialToken!=null) {
 	    throw org.monflabs.galtajs.rt.RuntimeUtil.syntaxError("Unexpected white space after '#' in a private name");
 	  }
 	}

 	// Set by SubStatement() for the Statement() about to be parsed, which
 	// moves it to subStatement while choosing its own alternative.
 	private boolean pendingSubStatement;
 	private boolean subStatement;

 	private static boolean lineTerminatorBefore(Token t) {
 	  for(Token s=t.specialToken; s!=null; s=s.specialToken) {
 	    if(s.kind==LINE_TERMINATOR || s.kind==SINGLE_LINE_COMMENT || s.kind==HTML_CLOSE_COMMENT
 	        || (s.kind==MULTI_LINE_COMMENT && containsLineTerminator(s.image))) {
 	      return true;
 	    }
 	  }
 	  return false;
 	}

 	// IterationStatement()'s 3-clause-for alternative uses
 	// LOOKAHEAD("for" "(" [ForInitialization()] ";"), a full syntactic trial-
 	// parse that recursively descends into ForInitialization()'s grammar -
 	// including into a nested function/generator body's own statement list.
 	// insertSemiColon()/checkSemiColon() (ASI) are JAVACODE productions, which
 	// JavaCC's trial-lookahead generator has no way to represent, so it
 	// silently omits them from the generated jj_3R_* trial-scan methods -
 	// confirmed by grepping the generated JSParser.java: insertSemiColon is
 	// never referenced in any jj_3R_* method. This makes the trial's token-
 	// consumption count diverge from the real parse specifically when a
 	// nested function body's LAST statement relies on ASI via the closing "}"
 	// (no explicit ";"), wrongly failing the whole lookahead and misparsing
 	// what should be an ordinary 3-clause for-loop (test262
 	// language/statements/for/S12.6.3_A2.1.js/S12.6.3_A2.2.js -
 	// "for((function(){var x=1})();;){break;}" - and
 	// language/statements/let/syntax/let-closure-inside-initialization.js,
 	// same shape: a closure literal with no trailing ";" inside the loop
 	// head).
 	//
 	// Fixed by NOT extending the broken JavaCC trial machinery - instead, a
 	// hand-written token scan (same style as isLetDeclaration()/
 	// isUsingDeclaration() above) answering the ONE question this lookahead
 	// actually needs: does a bare, depth-0 ";" appear somewhere in
 	// ForInitialization() before the for-loop's own closing ")"? This never
 	// invokes any JAVACODE production, so there's no ASI blind spot to hit.
 	// Doesn't need to recognize "in"/"of" at all: a for-in/for-of loop head
 	// never contains a bare ";" anywhere before its own closing ")" (a real
 	// ";" can only appear there inside a NESTED braced body, which stays at
 	// depth>0 and is correctly skipped by the depth tracking below) - so
 	// "found a depth-0 ';'" and "this is a 3-clause for-loop" are
 	// equivalent questions. Tokens 1/2 ("for"/"(") are matched by the
 	// syntactic part of this lookahead's own LOOKAHEAD("for" "(", {...})
 	// clause, so the scan starts at token 3.
 	//
 	// A FIRST attempt at this exact scan (same session) treated ONLY LBRACE/
 	// RBRACE as depth-affecting and broke language.literals's
 	// TemplateStringTest: a template literal interpolation's OPENING "${" is
 	// its own dedicated token kind (TEMPLATE_EXPR_START - see its own TOKEN
 	// declaration above), NOT a plain LBRACE, but the interpolation's CLOSING
 	// "}" IS tokenized as a genuine RBRACE (the lexer's own internal
 	// nestedBlocks counter decides what a "}" closes, but either way it's
 	// still an RBRACE token). Without counting TEMPLATE_EXPR_START as a
 	// depth++ too, the scan's depth went negative at that RBRACE and bailed
 	// out early - not just wrong for THAT one for-loop, but corrupting the
 	// REAL PARSER's own shared token stream for everything scanned past
 	// (this predicate uses getToken(i), not a throwaway token manager - same
 	// general hazard computeSoleObjectLiteralProgram()'s own comment already
 	// documents, just a different trigger). Fixed by treating
 	// TEMPLATE_EXPR_START the same as LBRACE below.
 	private boolean isForInitializationSemicolonNext() {
 	// MUST independently re-check "for" "(" itself (getToken(1)/getToken(2))
 	// before scanning, exactly like the analogous "import" "." ... "("
 	// LOOKAHEAD above redundantly re-checks getToken(1).kind==IMPORT - a
 	// combined LOOKAHEAD(syntactic, {semantic}) clause's semantic predicate
 	// can be evaluated as part of a BROADER speculative lookahead computation
 	// (e.g. MainSourceElements()'s own (...)* loop-continuation check, which
 	// must determine whether ANY alternative anywhere - including deep
 	// inside IterationStatement() - could possibly match) WITHOUT the
 	// syntactic "for" "(" prefix having actually matched first. Without this
 	// guard, calling getToken(i) from i=3 onward for an input that doesn't
 	// even start with "for" scans arbitrary, unrelated later source through
 	// the REAL PARSER's shared token stream - confirmed via test262
 	// language/statementList/*regexp-literal*.js (a bare "{}/1/;", no "for"
 	// anywhere): forced this predicate to lex far enough ahead to disturb
 	// the lexer's post-"}" regex/division disambiguation state before
 	// Block()'s own token_source.SwitchTo(DEFAULT) call ever got a chance to
 	// run - same class of hazard computeSoleObjectLiteralProgram()'s own
 	// comment documents for a different reason.
 	  if(getToken(1).kind!=FOR || getToken(2).kind!=LPAREN) return false;
 	  int depth = 0;
 	  for(int i=3; ; i++) {
 	    int k = getToken(i).kind;
 	    if(k==EOF) return false;
 	    if(depth==0 && k==SEMICOLON) return true;
 	    if(k==LPAREN || k==LBRACKET || k==LBRACE || k==TEMPLATE_EXPR_START) {
 	      depth++;
 	    } else if(k==RPAREN || k==RBRACKET || k==RBRACE) {
 	      depth--;
 	      if(depth<0) return false;
 	    }
 	  }
 	}


 	// ClassElement()'s FieldDefinition alternative has no support at all for
 	// the Stage-3+ decorators proposal's "accessor" auto-accessor keyword
 	// (`accessor x;` / `accessor #x = 1;`) - test262 grammar-field-accessor.js
 	// (both language/statements/class and language/expressions/class) only
 	// exercises the SYNTAX (flags:[generated], no runtime assertions - just
 	// must not throw a SyntaxError), so this predicate only needs to gate
 	// PARSING it, not implement real auto-accessor semantics (no [[Get]]/
 	// [[Set]] backing-field wiring - same "narrow, syntax-only" scope as
 	// class-static-block-related work elsewhere in this file).
 	//
 	// "accessor" has no dedicated token kind (unlike "static"/"get"/"set" -
 	// see their own < STATIC: "static" > etc. declarations above) - matched by
 	// IMAGE against the ordinary IDENTIFIER_NAME token instead, exactly like
 	// "of" (for-of's own separator) is handled elsewhere in this file, so
 	// nothing here can regress "accessor" used as a perfectly ordinary
 	// identifier/property name anywhere else in the language - it only ever
 	// becomes special when consumed via this ONE guarded LOOKAHEAD.
 	// Mirrors "static"'s own disambiguation (getToken(2).kind!=ASSIGN/
 	// SEMICOLON/RBRACE - see ClassElement()'s tstat handling) so `accessor;`/
 	// `accessor = 1;` (accessor used AS the field's own name) still parses as
 	// that, not as this modifier; the spec's own "accessor [no LineTerminator
 	// here] ClassElementName" restriction is enforced via noLineTerminatorBefore.
 	private boolean isAccessorFieldModifier() {
 	  Token t1 = getToken(1);
 	  return t1.kind==IDENTIFIER_NAME && "accessor".equals(t1.image)
 	      && noLineTerminatorBefore(2)
 	      && getToken(2).kind!=ASSIGN && getToken(2).kind!=SEMICOLON && getToken(2).kind!=RBRACE;
 	}


 	// YieldExpression's "yield [no LineTerminator here] * AssignmentExpression" form:
 	// true when the token right after "yield" is "*" with no LineTerminator before it
 	// (a plain space is fine - only a line break disqualifies the yield* form).
 	private boolean isYieldStar() {
 	  return getToken(1).kind==STAR && noLineTerminatorBeforeNextToken();
 	}

 	// "continue/break [no LineTerminator here] LabelIdentifier": true only when
 	// the next token could actually start a label AND has no LineTerminator
 	// before it - a semantic-only LOOKAHEAD would otherwise force JavaCC to
 	// commit to Identifier_Name() even when the next token isn't one (e.g.
 	// plain "continue;"), causing a spurious parse error.
 	private boolean noLineTerminatorBeforeLabel() {
 	  int k = getToken(1).kind;
 	  return noLineTerminatorBeforeNextToken() &&
 	    (k==IDENTIFIER_NAME || k==GET || k==SET || k==ASYNC || k==AWAIT || k==SYNCHRONIZED || k==USING
 	      || (k==YIELD && !yieldReserved));
 	}

 	// "return [no LineTerminator here] Expression": true only when the next
 	// token isn't one of the statement-boundary tokens ASI already treats
 	// specially, and there's no LineTerminator before it. Same reasoning as
 	// noLineTerminatorBeforeLabel() above - enumerating Expression()'s full
 	// FIRST-set isn't practical, so this checks the (small) exclusion set
 	// instead.
 	private boolean noLineTerminatorBeforeReturnExpression() {
 	  int k = getToken(1).kind;
 	  return noLineTerminatorBeforeNextToken() && k!=SEMICOLON && k!=RBRACE && k!=EOF;
 	}

 	// "yield [no LineTerminator here] AssignmentExpression": same exclusion-set
 	// reasoning as noLineTerminatorBeforeReturnExpression() above, but with a
 	// broader exclusion set - unlike "return", a bare "yield" (no operand) can
 	// also appear nested inside a parenthesized expression, array literal,
 	// argument list, or ternary, so RPAREN/RBRACKET/COMMA/COLON must also be
 	// treated as "no operand follows" here.
 	//
 	// Hand-written rather than relying on javacc's own generated LOOKAHEAD(2)
 	// simulation for "can AssignmentExpression start here": this specific
 	// javacc invocation generates a degenerate jj_3_N() body for that check
 	// (just `jj_scan_token(0)` - literally "is the next token EOF" - never
 	// matching any real operand token), for reasons not fully understood;
 	// this explicit check sidesteps that generation defect entirely rather
 	// than depending on it.
 	private boolean noLineTerminatorBeforeYieldOperand() {
 	  int k = getToken(1).kind;
 	  return noLineTerminatorBeforeNextToken() && k!=SEMICOLON && k!=RBRACE && k!=RPAREN && k!=RBRACKET && k!=COMMA && k!=COLON && k!=EOF;
 	}

 	// MainSourceElements()'s GaltaJS "bare object literal at top level" extension
 	// must only fire when the object-literal-shaped "{...}" is the ENTIRE
 	// program/eval'd text - not merely the first "{"-shaped thing seen, since
 	// MainSourceElements()'s alternation lives inside a (...)* loop and is
 	// otherwise re-tried on every iteration (e.g. the SECOND statement in
 	// eval('{}{}'), which must be a real empty Block, not an ObjectLiteral).
 	//
 	// Precomputed ONCE per MainProgram() call (see computeSoleObjectLiteralProgram()
 	// below, invoked from MainProgram() before MainSourceElements() runs) rather
 	// than checked via forward token lookahead from the CURRENT parse position.
 	// A lookahead that peeks token-by-token past the object literal's closing "}"
 	// to confirm EOF follows would force the REAL parser's shared token stream to
 	// lex whatever comes right after that "}" (e.g. a following regexp literal's
 	// leading "/") using the lexer's default NO_REGEX state - permanently
 	// mis-caching it as division BEFORE Block()'s own (correct)
 	// token_source.SwitchTo(DEFAULT) ever gets a chance to run for the real,
 	// non-object-literal interpretation. Using a throwaway JSParserTokenManager
 	// over the same source text - never touching the real parser's token_source/
 	// jj_input_stream - avoids that side effect entirely.
 	private boolean isSoleTopLevelObjectLiteral() {
 	  return isSoleObjectLiteralProgram;
 	}

 	private boolean isSoleObjectLiteralProgram = false;

 	// Same token vocabulary Identifier_Name() itself accepts (see that production) -
 	// used below to mirror the ORIGINAL three lookaheads' narrow shape-recognition
 	// ("{" ident ":", "{" string ":", "{" "}") rather than accepting anything that
 	// merely has balanced braces. GaltaJS's own ObjectLiteral() grammar is more
 	// lenient than strict ECMAScript (e.g. it happily starts parsing "{ function
 	// f() {} }" as some kind of property list, only rejecting it later at
 	// EVALUATE time with a SyntaxError) - so a full trial-parse-based check
 	// (matching ObjectLiteral() then requiring EOF) would wrongly treat a real
 	// Block containing a FunctionDeclaration as the sole-object-literal case.
 	// Confirmed via test262 language/eval-code/direct/block-decl-onlystrict.js
 	// (eval('{ function f() {} }')), which must stay a Block.
 	private static boolean isIdentifierNameLikeToken(int kind) {
 	  return kind==IDENTIFIER_NAME || kind==GET || kind==SET || kind==ASYNC || kind==AWAIT
 	      || kind==SYNCHRONIZED || kind==LET || kind==YIELD || kind==USING || kind==STATIC;
 	}

 	private boolean computeSoleObjectLiteralProgram(String text) {
 	  JSParserTokenManager scanTM = new JSParserTokenManager(new SimpleCharStream(new org.monflabs.util.io.FastStringReader(text, removeShebang(text)), 1, 1));
 	  Token t1 = scanTM.getNextToken();
 	  if (t1.kind != LBRACE) return false;
 	  Token t2 = scanTM.getNextToken();
 	  int depth;
 	  if (t2.kind == RBRACE) {
 	    depth = 0;
 	  } else if (t2.kind == STRING_LITERAL || isIdentifierNameLikeToken(t2.kind)) {
 	    Token t3 = scanTM.getNextToken();
 	    if (t3.kind != COLON) return false;
 	    depth = 1;
 	  } else {
 	    return false;
 	  }
 	  while (depth > 0) {
 	    Token t = scanTM.getNextToken();
 	    if (t.kind == LBRACE) depth++;
 	    else if (t.kind == RBRACE) depth--;
 	    else if (t.kind == EOF) return false;
 	  }
 	  Token last = scanTM.getNextToken();
 	  // Tolerate a single trailing ";" before EOF: the decompiled-test-mode pass
 	  // (AST -> regenerated JS source -> re-parsed) always appends ";" after an
 	  // expression-statement (ASTNode.decompileStatement()'s default), so a bare
 	  // object literal's own decompiled-and-reparsed form is "{ ... };", not
 	  // "{ ... }" - without this, the round-trip would wrongly demote it to a
 	  // Block. Confirmed via AllGaltaJSDecompiledTests / ObjectAsExpressionTest.
 	  if (last.kind == SEMICOLON) {
 	    last = scanTM.getNextToken();
 	  }
 	  return last.kind == EOF;
 	}

 	// True if there is no LineTerminator/comment attached as a special token
 	// immediately before getToken(index).
 	private boolean noLineTerminatorBefore(int index) {
 	  Token next = getToken(index);
 	  if (next.specialToken != null) {
 	    Token specialT = next.specialToken;
 	    while (specialT != null) {
 	      if (specialT.kind == LINE_TERMINATOR || specialT.kind == SINGLE_LINE_COMMENT) {
 	        return false;
 	      }
 	      specialT = specialT.specialToken;
 	    }
 	  }
 	  return true;
 	}

 	// Helper to check if we have an arrow function pattern: scan for => after balanced parens
 	// It allows these use casas:
   	//  f = (_ = 
   	//  	  (
   	//  		function() { throw new Test262Error(); } ()
   	//        ) 
   	//  	) => {}
   	//  ;
 	private boolean isArrowFunctionWithParens() {
 	  int parenDepth = 0;
 	  int i = 1;
 	  // Skip optional async and * ("async" only counts here if not separated
 	  // from what follows by a LineTerminator, per AsyncArrowHead's grammar restriction)
 	  Token t = getToken(i);
 	  if (t.kind == ASYNC && noLineTerminatorBefore(i+1)) {
 	    i++;
 	  }
 	  t = getToken(i);
 	  if (t.kind == STAR) {
 	    i++;
 	  }
 	  // Expect opening paren
 	  t = getToken(i);
 	  if (t.kind != LPAREN) return false;
 	  i++;
 	  parenDepth = 1;
 	  // Scan until we find matching closing paren
 	  while (parenDepth > 0 && i < 1000) {
 	    t = getToken(i++);
 	    if (t.kind == LPAREN) {
 	      parenDepth++;
 	    } else if (t.kind == RPAREN) {
 	      parenDepth--;
 	    } else if (t.kind == 0) {
 	      return false; // EOF
 	    }
 	  }
 	  if (parenDepth != 0) {
 	    return false;
 	  }
 	  // Tolerate an optional TypeScript return-type annotation between the
 	  // closing ")" and the arrow itself - "(a: number): string => ..." -
 	  // using the same peek-only scanner skipType() itself is built on (see
 	  // scanTypeEnd()'s own doc comment). Gated on supportTypeHints(): with
 	  // the flag off, a ":" here is never tolerated, byte-for-byte today's
 	  // behavior (a genuine ": Type" would simply fail this lookahead, same
 	  // as before this method existed).
 	  t = getToken(i);
 	  if (env.supportTypeHints() && t.kind == COLON) {
 	    i = scanTypeEnd(i + 1);
 	    t = getToken(i);
 	  }
 	  // Check if next token is =>
 	  return t.kind == FATARROW;
 	}

 	// Semantic lookahead for FunctionArrowHead's plain-identifier form: optional
 	// "async" (respecting [no LineTerminator here]), optional "*", an identifier, "=>".
 	private boolean isArrowFunctionWithIdentifier() {
 	  int i = 1;
 	  Token t = getToken(i);
 	  if (t.kind == ASYNC && noLineTerminatorBefore(i+1)) {
 	    i++;
 	  }
 	  t = getToken(i);
 	  if (t.kind == STAR) {
 	    i++;
 	  }
 	  // "yield" (outside a generator, i.e. !yieldReserved) is a valid
 	  // ArrowParameters BindingIdentifier just like any other contextual
 	  // keyword - reuse looksLikeBindingIdentifier() (already handles
 	  // YIELD/USING/SYNCHRONIZED/etc. consistently for other constructs)
 	  // instead of the narrower hand-rolled token-kind list this used to
 	  // check, which omitted YIELD entirely and rejected e.g. `yield => 1;`
 	  // in sloppy-mode code (test262
 	  // arrow-function/syntax/arrowparameters-bindingidentifier-yield.js)
 	  // even though Identifier_Name() below already accepts it correctly.
 	  if (!looksLikeBindingIdentifier(i)) {
 	    return false;
 	  }
 	  i++;
 	  return getToken(i).kind == FATARROW;
 	}

 	// True for the TypeScript-only modifier words "keyof"/"infer"/"readonly" -
 	// none of them have a dedicated TOKEN (unlike "typeof", already a real JS
 	// operator token reused as-is below), so matched by IMAGE against the
 	// ordinary IDENTIFIER_NAME token, exactly like "accessor"
 	// (isAccessorFieldModifier() above) or "type"/"interface"/"declare"
 	// below - never touches how these words parse as ordinary identifiers
 	// anywhere outside a type expression.
 	private static boolean isTypeModifierWord(Token t) {
 	  return t.kind==IDENTIFIER_NAME
 	      && ("keyof".equals(t.image) || "infer".equals(t.image) || "readonly".equals(t.image));
 	}

 	// True when token `i` continues a type expression that is otherwise
 	// "complete" at depth 0 - i.e. more type content is expected right after
 	// it. Shared by scanTypeEnd()'s own depth-0 stop/continue decision below.
 	private static boolean isTypeContinuationToken(Token t) {
 	  int k = t.kind;
 	  // "=>" is deliberately NOT included here - whether it continues a type
 	  // depends on lastCloser (only a function type's own parameter list, a
 	  // ")", may precede it), which scanTypeEnd() below checks itself via
 	  // its own dedicated isArrowContinuation condition.
 	  return k==BIT_OR || k==BIT_AND || k==HOOK || k==COLON || k==DOT || k==EXTENDS || k==TYPEOF
 	      || isTypeModifierWord(t);
 	}

 	// Peek-only (uses getToken(i), never consumes/advances the real token
 	// stream): returns the 1-based token index of the first token AFTER a
 	// single type expression starting at token `start`. Callers only ever
 	// invoke this once a leading ":" (or similar) has already been consumed/
 	// confirmed, so the type is never empty - the token at `start` always
 	// belongs to it.
 	//
 	// This is a hand-written depth-tracking scanner in the same style as
 	// isForInitializationSemicolonNext()/isArrowFunctionWithParens() above -
 	// not a real type grammar, since nothing here is ever type-CHECKED (see
 	// skipType()'s own doc comment for the full rationale and its
 	// documented, narrow edge cases: compound ">"-family tokens like ">>"/
 	// ">="/">>="/">>>"/">>>=" the lexer already fuses, and "keyof"/"typeof"/
 	// "infer"/"readonly" always being treated as needing an operand).
 	//
 	// Depth tracks "(","[","{","<" (and TEMPLATE_EXPR_START, matching
 	// isForInitializationSemicolonNext()'s own reasoning for why a template
 	// literal's "${" must count too) as openers; while depth>0, every token
 	// is unconditionally consumed (no stop-check applies inside brackets).
 	// At depth 0, scanning stops at the first token that doesn't continue
 	// the type - EXCEPT "=>", which continues (a function type's own arrow)
 	// only when the token that most recently returned depth to 0 was ")"
 	// (the function type's own parameter list) - otherwise "=>" ends the
 	// type (e.g. an arrow FUNCTION's own body arrow, immediately following a
 	// simple, non-parenthesized return type - see FunctionArrowDeclaration()).
 	private int scanTypeEnd(int start) {
 	  int depth = 0;
 	  boolean expectMore = true;
 	  int lastCloser = 0;
 	  int i = start;
 	  while (true) {
 	    Token t = getToken(i);
 	    int k = t.kind;
 	    if (k == EOF) {
 	      return i;
 	    }
 	    if (depth == 0 && !expectMore) {
 	      // Only "[" (an array/tuple suffix, "T[]") and "<" (generic args,
 	      // "Foo<T>") can validly open directly onto an already-COMPLETE type
 	      // unit with no preceding continuation operator. "(" and "{" (a
 	      // function type's own parameter list, an object type literal) are
 	      // deliberately NOT included here - unlike "T[]"/"Foo<T>", a type
 	      // never legitimately restarts with "(" or "{" except right after a
 	      // continuation operator ("|"/"&"/":"/...) or as the type's own
 	      // FIRST token, both of which already leave expectMore true, so
 	      // they never reach this check at all. Without this narrower set, a
 	      // return type immediately followed by "{" (the function's own
 	      // body, not an object type literal) is wrongly swallowed as if it
 	      // continued into one.
 	      boolean isOpener = (k==LBRACKET || k==LT);
 	      boolean isArrowContinuation = (k==FATARROW && lastCloser==RPAREN);
 	      if (!isOpener && !isTypeContinuationToken(t) && !isArrowContinuation) {
 	        return i;
 	      }
 	    }
 	    switch (k) {
 	      case LPAREN: case LBRACKET: case LBRACE: case LT: case TEMPLATE_EXPR_START:
 	        depth++; expectMore = true; lastCloser = 0; break;
 	      case RPAREN: case RBRACKET: case RBRACE: case GT: case GE:
 	        depth--; expectMore = false; lastCloser = k; break;
 	      case RSHIFT: case RSHIFTASSIGN:
 	        depth -= 2; expectMore = false; lastCloser = k; break;
 	      case RUNSHIFT: case RUNSHIFTASSIGN:
 	        depth -= 3; expectMore = false; lastCloser = k; break;
 	      case FATARROW:
 	        // Only ever reached here via the isArrowContinuation branch above
 	        // (a function type's own "=>") - the return type that must
 	        // follow it still needs at least one more token.
 	        expectMore = true; lastCloser = 0; break;
 	      default:
 	        expectMore = isTypeContinuationToken(t);
 	        lastCloser = 0;
 	        break;
 	    }
 	    if (depth < 0) {
 	      depth = 0;
 	    }
 	    i++;
 	  }
 	}

 	// Peek-only, mirroring scanTypeEnd() above but for a "<...>" type-
 	// parameter/argument list specifically: pure bracket balancing, no
 	// continuation-operator logic at all - unlike a type expression, nothing
 	// that follows a closed generics clause (an "extends"/"implements"
 	// clause, a "(" parameter list, a "{" body, ...) is ever part of the
 	// generics themselves. `start` must point at the leading "<".
 	private int scanTypeParametersEnd(int start) {
 	  int depth = 0;
 	  int i = start;
 	  while (true) {
 	    int k = getToken(i).kind;
 	    if (k == EOF) {
 	      return i;
 	    }
 	    switch (k) {
 	      case LPAREN: case LBRACKET: case LBRACE: case LT: case TEMPLATE_EXPR_START:
 	        depth++; break;
 	      case RPAREN: case RBRACKET: case RBRACE: case GT: case GE:
 	        depth--; break;
 	      case RSHIFT: case RSHIFTASSIGN:
 	        depth -= 2; break;
 	      case RUNSHIFT: case RUNSHIFTASSIGN:
 	        depth -= 3; break;
 	    }
 	    i++;
 	    if (depth <= 0) {
 	      return i;
 	    }
 	  }
 	}

 	// True when a ClassElement()/PropertyEntry() method definition's own
 	// entry point - "[async] [*] [#]? PropertyName [<TypeParams>]? (" - is
 	// ahead, replacing a plain LOOKAHEAD(["async"] ["*"] ["#"] PropertyName()
 	// "(") production-reference lookahead: that syntactic form has no way to
 	// tolerate an optional generic type-parameter clause between the name
 	// and "(" ("map<R>(...)"), since (like skipType() elsewhere) a generic
 	// clause is only ever consumed via the JAVACODE skipTypeParameters(),
 	// which a production-reference trial parse cannot represent (same
 	// documented gap as isForInitializationSemicolonNext()'s own ASI case).
 	// A computed name ("[expr]() {}", e.g. "[Symbol.iterator]() {}") is
 	// recognized structurally by balancing its own "["/"]" pair - tracking
 	// only bracket tokens (not every opener/closer scanTypeEnd() itself
 	// tracks) is enough, since a computed key's own AssignmentExpression
 	// can never contain an UNbalanced "["/"]" of its own.
 	private boolean isMethodEntry() {
 	  int i = 1;
 	  if (getToken(i).kind == ASYNC && noLineTerminatorBefore(i+1)) {
 	    i++;
 	  }
 	  if (getToken(i).kind == STAR) {
 	    i++;
 	  }
 	  if (getToken(i).kind == HASH) {
 	    i++;
 	  }
 	  // A PropertyEntry() spread ("...expr", e.g. "{ a: 'N', ...obj }") is
 	  // never a PropertyName - without this check, the "..." token itself
 	  // gets blindly skipped below as if it WERE the (single-token) name,
 	  // and a spread of an immediately-invoked/called expression
 	  // ("...(() => {...})()") then looks exactly like "name(", a false
 	  // positive method match.
 	  if (getToken(i).kind == SPREAD) {
 	    return false;
 	  }
 	  // The class body's / object literal's own closing "}" (the loop-exit
 	  // check evaluates this predicate too), or any other token that can
 	  // never start an element: bail out WITHOUT peeking past it. Peeking
 	  // at getToken(2) here would make the REAL parser's shared lexer
 	  // tokenize whatever follows the "}" - e.g. a regex literal's leading
 	  // "/" - while still in the post-"}" NO_REGEX state, before
 	  // Statement()'s own token_source.SwitchTo(DEFAULT) for a class
 	  // declaration ever runs (test262 language/statementList/
 	  // class-regexp-literal.js: `class C {}/1/;` - same hazard
 	  // computeSoleObjectLiteralProgram()'s own comment documents).
 	  int nameKind = getToken(i).kind;
 	  if (nameKind == RBRACE || nameKind == SEMICOLON || nameKind == COMMA || nameKind == RPAREN || nameKind == EOF) {
 	    return false;
 	  }
 	  if (nameKind == LBRACKET) {
 	    int depth = 1;
 	    i++;
 	    while (depth > 0) {
 	      int k = getToken(i).kind;
 	      if (k == EOF) {
 	        return false;
 	      }
 	      if (k == LBRACKET) {
 	        depth++;
 	      } else if (k == RBRACKET) {
 	        depth--;
 	      }
 	      i++;
 	    }
 	  } else {
 	    i++;
 	  }
 	  if (env.supportTypeHints() && getToken(i).kind == LT) {
 	    i = scanTypeParametersEnd(i);
 	  }
 	  return getToken(i).kind == LPAREN;
 	}

 	// "type [no LineTerminator implied by ASI concerns - see below]
 	// BindingIdentifier" - true only when this is genuinely the start of a
 	// TypeScript type-alias STATEMENT, not "type" used as a plain
 	// identifier ("type = 5;", "type.foo()", "type;"). Neither "type" nor
 	// "interface" (isInterfaceStart() below) has a dedicated TOKEN - matched
 	// by IMAGE against IDENTIFIER_NAME, exactly like "accessor"/"keyof"/
 	// "infer"/"readonly" above, so this never affects how either word parses
 	// as an ordinary identifier anywhere else. Gated on supportTypeHints():
 	// with the flag off, "type"/"interface" remain plain identifiers
 	// unconditionally, byte-for-byte today's behavior.
 	private boolean isTypeAliasStart() {
 	  Token t1 = getToken(1);
 	  return env.supportTypeHints() && t1.kind==IDENTIFIER_NAME && "type".equals(t1.image)
 	      && looksLikeBindingIdentifier(2);
 	}

 	// See isTypeAliasStart() above - same shape, for "interface X {...}".
 	private boolean isInterfaceStart() {
 	  Token t1 = getToken(1);
 	  return env.supportTypeHints() && t1.kind==IDENTIFIER_NAME && "interface".equals(t1.image)
 	      && looksLikeBindingIdentifier(2);
 	}

 	// "declare" ambient-declaration modifier - true only when immediately
 	// followed by one of the statement forms it can legally prefix. Matched
 	// by IMAGE, same reasoning as isTypeAliasStart() above; "declare" itself
 	// contributes nothing to the resulting AST (see Statement()'s own
 	// handling) - it's swallowed and the underlying statement parses
 	// exactly as it would without it.
 	private boolean isDeclareStart() {
 	  Token t1 = getToken(1);
 	  if (!(env.supportTypeHints() && t1.kind==IDENTIFIER_NAME && "declare".equals(t1.image))) {
 	    return false;
 	  }
 	  Token t2 = getToken(2);
 	  return t2.kind==FUNCTION || t2.kind==CLASS || t2.kind==VAR || t2.kind==LET || t2.kind==CONST
 	      || (t2.kind==IDENTIFIER_NAME && ("type".equals(t2.image) || "interface".equals(t2.image)));
 	}

 	// ---------------------------------------------------------------------
 	// Type-hint consumption helpers - called ONLY from action blocks
 	// ("{ skipTypeAnnotationIfAny(); }"), NEVER referenced as a grammar
 	// expansion. The four JAVACODE token-skippers they delegate to
 	// (skipType()/skipTypeParameters()/skipInterfaceBody()/
 	// skipDeclareSignature(), at the bottom of this file) must not appear
 	// in any BNF expansion either, not even inside an optional guarded by a
 	// LOOKAHEAD({env.supportTypeHints() ...}) predicate: javacc compiles a
 	// JAVACODE reference reached by a SYNTACTIC lookahead trial as
 	//     { jj_la = 0; jj_scanpos = jj_lastpos; return false; }
 	// - an unconditional "lookahead satisfied, stop scanning" - and does NOT
 	// evaluate the guarding semantic predicate at all in that trial. Any
 	// production reachable through a syntactic LOOKAHEAD (FunctionDeclaration
 	// and ClassDeclaration via a computed class-member name, a for-in/of
 	// head's destructuring initializer, ...) was therefore mis-parsed the
 	// moment such a clause was added to it, flag on or off (test262
 	// language/statements/for-of/dstr/*-init-fn-*.js, class
 	// cpn-*-accessors-*-from-function-expression.js). An action block is
 	// invisible to trial parses, so the trial simply scans the raw tokens
 	// (correct with the flag off; with it on, a type annotation sitting in
 	// one of those trial-scanned positions is a documented limitation, not
 	// a mis-parse elsewhere).
 	// ---------------------------------------------------------------------

 	// ": Type"
 	private void skipTypeAnnotationIfAny() throws ParseException {
 	  if(env.supportTypeHints() && getToken(1).kind==COLON) {
 	    getNextToken();
 	    skipType();
 	  }
 	}

 	// "<T, ...>"
 	private void skipTypeParametersIfAny() throws ParseException {
 	  if(env.supportTypeHints() && getToken(1).kind==LT) {
 	    skipTypeParameters();
 	  }
 	}

 	// "?" / "?:" optional-member marker, then an optional ": Type" - "?:"
 	// lexes as ONE token (ELVIS, GaltaJS's own Elvis operator) when written
 	// without a space, the idiomatic TypeScript style.
 	private void skipOptionalMarkerAndTypeIfAny() throws ParseException {
 	  if(!env.supportTypeHints()) {
 	    return;
 	  }
 	  int k = getToken(1).kind;
 	  if(k==ELVIS) {
 	    getNextToken();
 	    skipType();
 	    return;
 	  }
 	  if(k==HOOK) {
 	    getNextToken();
 	  }
 	  skipTypeAnnotationIfAny();
 	}

 	// "implements A, B<T>" - "implements" has no dedicated TOKEN (matched by
 	// image, same reasoning as "type"/"interface"/"declare").
 	private void skipImplementsClauseIfAny() throws ParseException {
 	  Token t = getToken(1);
 	  if(env.supportTypeHints() && t.kind==IDENTIFIER_NAME && "implements".equals(t.image)) {
 	    getNextToken();
 	    skipType();
 	    while(getToken(1).kind==COMMA) {
 	      getNextToken();
 	      skipType();
 	    }
 	  }
 	}

 	// "extends A, B<T>" on an interface (an interface may extend several)
 	private void skipInterfaceExtendsIfAny() throws ParseException {
 	  if(getToken(1).kind==EXTENDS) {
 	    getNextToken();
 	    skipType();
 	    while(getToken(1).kind==COMMA) {
 	      getNextToken();
 	      skipType();
 	    }
 	  }
 	}
}
PARSER_END(JSParser)


TOKEN_MGR_DECLS : {
    // Nested template and blocks
    private Template template;

 	private static class Template {
 	  Template prev;
 	  int nestedBlocks;
 	  Template(Template prev) {
 	    this.prev = prev;
 	  }
	}

	// Approximate IdentifierPart check (letters/digits/connector-punctuation
	// per Character.isUnicodeIdentifierPart, plus "_"/"$") - used by the
	// "*in"/"*instanceof" broadcast-operator tokens' own actions below to
	// tell an ordinary multiplication whose right operand merely STARTS
	// WITH "in"/"instanceof" (e.g. "a*index", "n*instantiate") apart from
	// the real broadcast operator. Deliberately not the grammar's own exact
	// IDENTIFIER_PART production (astral ID_Continue, ZWNJ/ZWJ, combining
	// marks) - this only needs to be right for the ordinary ASCII
	// identifiers such a collision can realistically involve.
	private static boolean containsLineTerminatorChar(String s) {
		for(int i=0; i<s.length(); i++) {
			char c = s.charAt(i);
			if(c=='\n' || c=='\r' || c==(char)0x2028 || c==(char)0x2029) {
				return true;
			}
		}
		return false;
	}

	private static boolean isBroadcastOpIdentifierPart(char c) {
		return c=='_' || c=='$' || Character.isUnicodeIdentifierPart(c);
	}
}


/*****************************************
 * LEXICAL & REGEXP GRAMMARS STARTS HERE *
 *****************************************/ 

/* Section 7.2 : White Space */

<DEFAULT, NO_REGEX>
SPECIAL_TOKEN: { 
   <WHITE_SPACE: <TAB> | <VT> | <FAKEVT> | <FF> | <SP> | <NBSP> | <BOM> | <USP>>
 | < #TAB: "\u0009" | "\t" > /* TAB */
 | < #VT: "\u000B" > /* Vertical Tab */
   /* In JavaCC, you cannot use the escape sequence \v directly because JavaCC is based on Java, and Java itself does not recognize \v
      as a valid escape sequence for a vertical tab.
      #VT catches the actual vertical tab character, while #FAKE_VTAB matches the string \v. Note the double backslashes (\\v),
      which are necessary because in Java strings, the backslash itself must be escaped. */
 | < #FAKEVT: "\\v" > /* Fake Vertical Tab */
 | < #FF: "\u000C" | "\f"> /* Form Feed */
 | < #SP: "\u0020" | " " > /* Space */
 | < #NBSP: "\u00A0" > /* No-break space */
 | < #BOM: "\uFEFF" > /* BOM signature */
 | < #USP: /* Other Unicode space separator */
		["\u1680"] 
	|	["\u2000"] 
	|	["\u2001"] 
	|	["\u2002"] 
	|	["\u2003"] 
	|	["\u2004"] 
	|	["\u2005"] 
	|	["\u2006"] 
	|	["\u2007"]
	|	["\u2008"] 
	|	["\u2009"] 
	|	["\u200A"] 
	|	["\u202F"] 
	|	["\u205F"] 
	|	["\u3000"]
   >
}


/* Section 7.3 : Line Terminators */

<DEFAULT, NO_REGEX>
SPECIAL_TOKEN: {
   <LINE_TERMINATOR: <LF> | <CR> (<LF>)? | <LS> | <PS> >
 | < #LF: "\n" > /* Line Feed */
 | < #CR: "\r" > /* Carriage Return */
 | < #LS: "\u2028" > /* Line separator */
 | < #PS: "\u2029" > /* Paragraph separator */
   /* Annex B.1.3 SingleLineHTMLCloseComment: "-->" only starts a comment
      when only white space and single-line delimited comments ("/* ... * /")
      precede it since a real LineTerminator
      (e.g. test262 annexB/built-ins/Function/createdynfn-html-close-comment-*).
      Matched here as one SPECIAL_TOKEN alternative - starting with the same
      LineTerminator chars as the plain LINE_TERMINATOR rule above - so
      JavaCC's maximal munch naturally prefers this longer match only when
      "-->" actually follows, and otherwise falls back to LINE_TERMINATOR/
      WHITE_SPACE as usual. The trailing LineTerminator is deliberately left
      unconsumed so ASI (checkSemiColon()) still sees a normal LINE_TERMINATOR
      special token right after the comment.
    */
 | <HTML_CLOSE_COMMENT: (<LF> | <CR> (<LF>)? | <LS> | <PS>) (<WHITE_SPACE> | "/*" ( ~["*","\n","\r","\u2028","\u2029"] | ("*")+ ~["*","/","\n","\r","\u2028","\u2029"] )* ("*")+ "/")* "-->" (~["\n","\r","\u2028","\u2029"])* >
}


/* Comments */
/*
  Note: there is a weird issue with single line comment when there are on the last line
  and without any content (just empty) and no cr/lr. In short, // are the last 2 characters
  in the script. This leads to an error as it at least need one character so we push
  it with input_stream.backup(1)
*/
<DEFAULT, NO_REGEX>
MORE: {
   "//" { input_stream.backup(1); } : IN_SINGLE_LINE_COMMENT
 | "/*" : IN_MULTI_LINE_COMMENT
   /* Annex B.1.3 SingleLineHTMLOpenComment: "<!--" always starts a comment
      to end-of-line, unconditionally (no preceding LineTerminator needed) -
      test262 annexB/built-ins/Function/createdynfn-html-open-comment-*. */
 | "<!--" : IN_SINGLE_LINE_COMMENT
}

<IN_SINGLE_LINE_COMMENT>
SPECIAL_TOKEN: {
   <SINGLE_LINE_COMMENT: (~["\n","\r","\u2028","\u2029"])* ("\n"|"\r"|"\r\n")? > : DEFAULT
}

/*
<DEFAULT, NO_REGEX>
MORE: {
   "/*" : IN_MULTI_LINE_COMMENT
}

SPECIAL_TOKEN: {
   <SINGLE_LINE_COMMENT: (~["\n","\r"])* ("\n"|"\r")? > : DEFAULT
}
*/

<IN_MULTI_LINE_COMMENT>
SPECIAL_TOKEN: {
   /* Annex B.1.1 SingleLineHTMLCloseComment after a MultiLineComment that
      contains a line terminator: the comment may be followed, on its last
      line, by white space and single-line delimited comments, then "-->"
      and the rest of the line. Matched as part of the comment itself; when
      the comment turns out to have no line terminator, the lexical action
      gives the extra characters back so they are lexed as ordinary tokens
      (e.g. "a /* c * / --> b" stays a decrement and a comparison). */
   <MULTI_LINE_COMMENT: "*/" (
       ( [" ","\t","\u000B","\u000C","\u00A0","\uFEFF"]
       | "/*" ( ~["*","\n","\r","\u2028","\u2029"] | ("*")+ ~["*","/","\n","\r","\u2028","\u2029"] )* ("*")+ "/"
       )* "-->" (~["\n","\r","\u2028","\u2029"])* )? >
   {
     int commentEnd = matchedToken.image.indexOf("*/", 2) + 2;
     if(commentEnd < matchedToken.image.length() && !containsLineTerminatorChar(matchedToken.image.substring(0, commentEnd))) {
       input_stream.backup(matchedToken.image.length() - commentEnd);
       matchedToken.image = matchedToken.image.substring(0, commentEnd);
     }
   } : DEFAULT
}

<IN_SINGLE_LINE_COMMENT,IN_MULTI_LINE_COMMENT>
MORE: {
   < ~[] >
}


/* Section 7.5.1: Reserved Words */
<DEFAULT, NO_REGEX>
TOKEN: {
  /*  < AS: "as" > : DEFAULT  */
    < BREAK: "break" > : DEFAULT
  | < CASE: "case" > : DEFAULT
  | < CATCH: "catch" > : DEFAULT
  | < CONST: "const" > : DEFAULT
  | < CONTINUE: "continue" > : DEFAULT
  | < DEBUGGER: "debugger"> : DEFAULT
  | < DELETE: "delete"> : DEFAULT
  | < _DEFAULT: "default" > : DEFAULT
  | < DO: "do" > : DEFAULT
  | < ELSE: "else" > : DEFAULT
  | < EXPORT: "export" > : DEFAULT
  | < FINALLY: "finally" > : DEFAULT
  | < FOR: "for" > : DEFAULT
  /*| < FROM: "from" > : DEFAULT*/
  | < FUNCTION: "function" > : DEFAULT
  | < GET: "get" > : DEFAULT
  | < IF: "if" > : DEFAULT
  | < IMPORT: "import" > : DEFAULT
  | < IN: "in" > : DEFAULT
  | < INSTANCE_OF: "instanceof" > : DEFAULT
  | < INSTANCE_OFALL: "*instanceof" > {
	  // GaltaJS's broadcast "instanceof" operator (sequence extension) is
	  // written with NO space between "*" and "instanceof" - which makes it
	  // lexically ambiguous with an ordinary multiplication whose right
	  // operand identifier merely STARTS WITH "instanceof" (no space
	  // either). JavaCC's maximal munch always prefers this longer literal
	  // token over the 1-char STAR token regardless of what identifier
	  // characters follow, silently truncating e.g. "n*instanceofFoo" into
	  // "*instanceof" + a mangled "Foo" identifier. If an identifier-part
	  // character immediately follows, this is ordinary multiplication -
	  // back up past "instanceof" (and the peeked char) and re-report just
	  // "*" (STAR); see INALL below for the identical, more commonly hit
	  // case (test262 language/statements/for/S12.6.3_A11*/A12* etc., via
	  // identifiers like "index_n").
	  try {
		  char c = input_stream.readChar();
		  if (isBroadcastOpIdentifierPart(c)) {
			  input_stream.backup("instanceof".length()+1);
			  matchedToken.kind = STAR;
			  matchedToken.image = "*";
			  matchedToken.endLine = matchedToken.beginLine;
			  matchedToken.endColumn = matchedToken.beginColumn;
		  } else {
			  input_stream.backup(1);
		  }
	  } catch (java.io.IOException e) {
		  // EOF right after "*instanceof" - nothing more to check.
	  }
  } : DEFAULT
  | < LET: "let" > : DEFAULT
  | < NEW: "new" > : DEFAULT
  | < RETURN: "return" > : DEFAULT
  | < SET: "set" > : DEFAULT
  | < SWITCH: "switch" > : DEFAULT
  | < SYNCHRONIZED: "synchronized" > : DEFAULT
  | < THIS: "this" > : NO_REGEX
  | < THROW: "throw" > : DEFAULT
  | < TRY: "try" > : DEFAULT
  | < TYPEOF: "typeof"> : DEFAULT
  | < VAR: "var"> : DEFAULT
  | < VOID: "void"> : DEFAULT
  | < WHILE: "while" > : DEFAULT
  | < WITH: "with" > : DEFAULT
  /* extra keyword */
  | < ASYNC: "async" > : DEFAULT
  | < AWAIT: "await" > : DEFAULT
  | < CLASS: "class" > : DEFAULT
  | < EXTENDS: "extends" > : DEFAULT
  | < ENUM: "enum" > : DEFAULT
  | < SUPER: "super" > : DEFAULT
  | < STATIC: "static" > : DEFAULT
  | < YIELD: "yield" > : DEFAULT
  | < USING: "using" > : DEFAULT
 }


/* Section 7.6: Identifiers */
/* Moved down to come after the literals so literals have the priority */
/* Ex: null, true, false, ... */


/* Section 7.7: Punctuators */
<DEFAULT, NO_REGEX>
TOKEN :
{
/*  
	< LBRACE: "{" > : DEFAULT
|	< RBRACE: "}" > : NO_REGEX 
*/
	< LBRACE: "{" > {
	  	if(template!=null) {
	  	    template.nestedBlocks++;
	 	}
	  } : DEFAULT
|   < RBRACE: "}" > { 
        if (template!=null) {
            if(template.nestedBlocks >0) { 
                template.nestedBlocks--;
                SwitchTo(NO_REGEX);
            } else {
               SwitchTo(IN_TEMPLATE);
          	}
        } else {
            SwitchTo(NO_REGEX);
        }
    }   
|   < LPAREN: "(" > : DEFAULT
|	< RPAREN: ")" > : NO_REGEX
|	< LBRACKET: "[" > : DEFAULT
|	< RBRACKET: "]" > : NO_REGEX
|	< DOT: "." > : DEFAULT
|	< HASH: "#" > : DEFAULT
|	< AT: "@" > : DEFAULT
|	< SEMICOLON: ";" > : DEFAULT
|	< COMMA: "," > : DEFAULT
|	< LT: "<" > : DEFAULT
|	< GT: ">" > : DEFAULT
|	< LE: "<=" > : DEFAULT
|	< GE: ">=" > : DEFAULT
|	< EQ: "==" > : DEFAULT
|	< NE: "!=" > : DEFAULT
|	< SEQ: "===" >  : DEFAULT /* Strict Equals Operator */
|	< SNEQ: "!==" >	 : DEFAULT /* Strict Does-not-equal Operator */
|	< PLUS: "+" > : DEFAULT
|	< MINUS: "-" > : DEFAULT
|	< STAR: "*" > : DEFAULT
|	< POWER: "**" > : DEFAULT
|	< REM: "%" > : DEFAULT
|	< INCR: "++" > : NO_REGEX
|	< DECR: "--" > : NO_REGEX
|	< LSHIFT: "<<" > : DEFAULT
|	< RSHIFT: ">>" > : DEFAULT
|	< RUNSHIFT: ">>>" >  : DEFAULT /* Unsigned Right Shift Operator */
|	< BIT_AND: "&" > : DEFAULT
|	< BIT_OR: "|" > : DEFAULT
|	< XOR: "^" > : DEFAULT
|	< BANG: "!" > : DEFAULT
|	< TILDE: "~" > : NO_REGEX
|	< SC_AND: "&&" > : DEFAULT
|	< SC_OR: "||" > : DEFAULT
|	< HOOK: "?" > : DEFAULT
|	< COLON: ":" > : DEFAULT
|	< ASSIGN: "=" > : DEFAULT
|	< PLUSASSIGN: "+=" > : DEFAULT
|	< MINUSASSIGN: "-=" > : DEFAULT
|	< STARASSIGN: "*=" > : DEFAULT
|	< POWERASSIGN: "**=" > : DEFAULT
|	< REMASSIGN: "%=" > : DEFAULT
|	< BITANDASSIGN: "&=" > : DEFAULT
|	< BITORASSIGN: "|=" > : DEFAULT
|	< XORASSIGN: "^=" > : DEFAULT
|	< ANDASSIGN: "&&=" > : DEFAULT
|	< ORASSIGN: "||=" > : DEFAULT
|	< LSHIFTASSIGN: "<<=" > : DEFAULT
|	< RSHIFTASSIGN: ">>=" > : DEFAULT
|	< RUNSHIFTASSIGN: ">>>=" > : DEFAULT
|	< NULLCOALESCINGASSIGN: "??=" > : DEFAULT

	/* Extended List comparison operators */
|	< LTALL: "*<" > : DEFAULT
|	< GTALL: "*>" > : DEFAULT
|	< LEALL: "*<=" > : DEFAULT
|	< GEALL: "*>=" > : DEFAULT
|	< EQALL: "*==" > : DEFAULT
|	< NEALL: "*!=" > : DEFAULT
|	< SEQALL: "*===" >  : DEFAULT /* Strict Equals Operator */
|	< SNEQALL: "*!==" >	 : DEFAULT /* Strict Does-not-equal Operator */
|	< INALL: "*in" > {
	  // "*in" is GaltaJS's broadcast "in" operator (sequence extension),
	  // written with NO space between "*" and "in" - but that's lexically
	  // ambiguous with an ordinary multiplication whose right operand
	  // identifier simply STARTS WITH "in" (e.g. "a*index", "n*insert"),
	  // also with no space. JavaCC's maximal munch always prefers this
	  // 3-char literal token over the 1-char STAR token, regardless of what
	  // identifier characters follow, silently splitting e.g. "a*index_n"
	  // into "*in" + a truncated "dex_n" identifier - confirmed via test262
	  // language/statements/for/S12.6.3_A11.1_T2.js and siblings (embedded
	  // "index"/"index_n" loop variables). If an identifier-part character
	  // immediately follows, this is ordinary multiplication instead - back
	  // up past "in" (and the peeked char) and re-report just "*" (STAR).
	  try {
		  char c = input_stream.readChar();
		  if (isBroadcastOpIdentifierPart(c)) {
			  input_stream.backup(3);
			  matchedToken.kind = STAR;
			  matchedToken.image = "*";
			  matchedToken.endLine = matchedToken.beginLine;
			  matchedToken.endColumn = matchedToken.beginColumn;
		  } else {
			  input_stream.backup(1);
		  }
	  } catch (java.io.IOException e) {
		  // EOF right after "*in" - nothing more to check.
	  }
  } : DEFAULT
	
	/* JSON Path Extensions */
| 	< DDOT: ".." > : DEFAULT
|	< FILTEROPEN: "[?" > : DEFAULT
|	< MAPEXPR: ".(" > : DEFAULT

	/* ES6, Typescript and beyond, Extensions */
| 	< SPREAD: "..." > : DEFAULT
| 	< FATARROW: "=>" > : DEFAULT
|	< NULLDOT: "?." > {
	  // "?." (optional chaining) must NOT match when immediately followed by
	  // a decimal digit (spec's OptionalChainingPunctuator lookahead
	  // exclusion) - that's ambiguous with a ternary's "?" followed by a
	  // ".NNN" decimal literal (e.g. "true ?.30 : false" must lex as "true"
	  // "?" ".30" ":" "false", not "true" "?." "30" ":" "false"). If a digit
	  // immediately follows, back up past both "?." and the peeked digit and
	  // re-report just "?" (HOOK) instead - mirrors the identical INALL/STAR
	  // backup pattern above (test262 language/expressions/optional-chaining/
	  // punctuator-decimal-lookahead.js).
	  try {
		  char c = input_stream.readChar();
		  if (c >= '0' && c <= '9') {
			  input_stream.backup(2);
			  matchedToken.kind = HOOK;
			  matchedToken.image = "?";
			  matchedToken.endLine = matchedToken.beginLine;
			  matchedToken.endColumn = matchedToken.beginColumn;
		  } else {
			  input_stream.backup(1);
		  }
	  } catch (java.io.IOException e) {
		  // EOF right after "?." - nothing more to check.
	  }
  } : DEFAULT
|	< NULLCOALESCING: "??" > : DEFAULT
| 	< PIPELINE: "|>" > : DEFAULT

	/* ECMA 2023 */
/* Done outside of the grammar
|   < SHEBANG: "#!" (~["\n","\r"])* ("\n"|"\r"|"\r\n")? > : DEFAULT
*/ 
	/* GaltaJS Extension */
| 	< ELVIS: "?:" > : DEFAULT
}

/* Very strange: if we use the literal "/=" in the grammar it fails */
/* we should use the label declared here - maybe because the lexical state is limited?*/
<NO_REGEX>
TOKEN: {
	<SLASHASSIGN: "/="> : DEFAULT
|	<SLASH:	"/"> : DEFAULT
}



/* Section 7.8: Literals */


/* Section 7.8.3: Numeric Literals */
<DEFAULT, NO_REGEX>
TOKEN: {
  	< DEC_INTEGER_LITERAL: <DECIMAL_DIGITS_SEP> (<INTEGER_SUFFIX>)?> : NO_REGEX
|   < HEX_INTEGER_LITERAL: ("0x"|"0X") (["0"-"9","a"-"f","A"-"F","_"])+ (<INTEGER_SUFFIX>)?> : NO_REGEX
|   < OCT_INTEGER_LITERAL: ("0o"|"0O") (["0"-"7","_"])+ (<INTEGER_SUFFIX>)?> : NO_REGEX
|   < BIN_INTEGER_LITERAL: ("0b"|"0B") (["0"-"1","_"])+ (<INTEGER_SUFFIX>)?> : NO_REGEX
/*|     < OCT_INTEGER_LITERAL: "0" (["0"-"7"])* (<INTEGER_SUFFIX>)?> : NO_REGEX*/
|  	< #INTEGER_SUFFIX: ["I","i","L","l","N","n"]>

| 	< DECIMAL_LITERAL :
		<DECIMAL_DIGITS_SEP> "." (<DECIMAL_DIGITS_SEP>)? (<EXPONENT_PART>)? (<DECIMAL_SUFFIX>)?
	|	"." <DECIMAL_DIGITS_SEP> (<EXPONENT_PART>)? (<DECIMAL_SUFFIX>)?
	|		<DECIMAL_DIGITS_SEP> (<EXPONENT_PART>)? (<DECIMAL_SUFFIX>)?
	> : NO_REGEX
|	< #EXPONENT_PART: ("e" | "E") (["+","-"])? <DECIMAL_DIGITS_SEP> >
|  	< #DECIMAL_SUFFIX: ["F","f","d","D","m","M"]> /* M is inspired by C# */
|  	< #DECIMAL_DIGITS_SEP: (<DECIMAL_DIGIT>) (<DECIMAL_DIGIT_SEP>)* >
|	< #DECIMAL_DIGIT: ["0"-"9"] >
|	< #DECIMAL_DIGIT_SEP: ["0"-"9","_"] >
}



/* Section 7.8.1: NULL Literals */
<DEFAULT, NO_REGEX>
TOKEN: { 
	< NULL_LITERAL: "null" > : NO_REGEX
}

/* Section 7.8.2: Boolean Literals */
<DEFAULT, NO_REGEX>
TOKEN: { 
	< BOOLEAN_LITERAL: "true" | "false" > : NO_REGEX
}


/* Section 7.8.4: String Literals */
<DEFAULT, NO_REGEX>
TOKEN: {
	< STRING_LITERAL:
		  "\"" (<DOUBLE_STRING_CHARACTER>)* "\""
		| "'" (<SINGLE_STRING_CHARACTER>)* "'"
	> : NO_REGEX
|	< #DOUBLE_STRING_CHARACTER:
		  <LINE_CONTINUATION> 
		| <ESCAPE_SEQUENCE>
		| (~["\"","\\","\n","\r"])* 
	>
|   < TEMPLATE_START: "`" > { this.template=new Template(template); } : IN_TEMPLATE
|	< #SINGLE_STRING_CHARACTER:
		  <LINE_CONTINUATION> 
		| <ESCAPE_SEQUENCE>
		| (~["'","\\","\n","\r"])
	> 
|	< #LINE_CONTINUATION:
		"\\" ( "\r\n" | "\n\r" | "\r" | "\n" | "\u2028" |"\u2029")
	>
|	< #ESCAPE_SEQUENCE: "\\" 
	  (	    
		  <CHARACTER_ESCAPE_SEQUENCE>
		| "0" 
		| <HEX_ESCAPE_SEQUENCE>
		| <UNICODE_ESCAPE_SEQUENCE>
	 )
	>
|	< #CHARACTER_ESCAPE_SEQUENCE:
		<SINGLE_ESCAPE_CHARACTER> | <NON_ESCAPE_CHARACTER>
	>
| 	< #HEX_ESCAPE_SEQUENCE: "x" <HEX_DIGIT> <HEX_DIGIT> >
| 	< #HEX_DIGIT: ["0"-"9","a"-"f","A"-"F"] >
| 	< #UNICODE_ESCAPE_SEQUENCE: "u" ( <HEX_DIGIT> <HEX_DIGIT> <HEX_DIGIT> <HEX_DIGIT> | "{" (<HEX_DIGIT>)+ "}" ) >
|	< #SINGLE_ESCAPE_CHARACTER: ["'" , "\"", "`" , "\\" , "b" , "f" , "n" , "r" , "t" , "v"] >
|	< #NON_ESCAPE_CHARACTER: 
		~["\n","\r","\u2028","\u2029"]
	| 
		~["'" , "\"" , "`" , "\\" , "b" , "f" , "n" , "r" , "t" , "v", "x", "u"]
	| 
		~["0"-"9"]
	>
}

<IN_TEMPLATE>
TOKEN: {
    < TEMPLATE_END: "`" > { this.template=template.prev; } : DEFAULT
|   < TEMPLATE_EXPR_START: "${" >  { this.template.nestedBlocks=0; } : DEFAULT
|   < TEMPLATE_DOLLAR_NOT_LBRACE: "$" >
|   < TEMPLATE_CHARS: ( ~["`", "$", "\\"] | <TEMPLATE_ESCAPE> )+ >
/* We could factor this with strings */
|	< #TEMPLATE_ESCAPE: "\\" 
	  (	    
		  <TEMPLATE_CHARACTER_ESCAPE_SEQUENCE>
		| "0" 
		| <TEMPLATE_HEX_ESCAPE_SEQUENCE>
		| <TEMPLATE_UNICODE_ESCAPE_SEQUENCE>
	 )
	>
|	< #TEMPLATE_CHARACTER_ESCAPE_SEQUENCE:
		<TEMPLATE_SINGLE_ESCAPE_CHARACTER> | <TEMPLATE_NON_ESCAPE_CHARACTER>
	>
| 	< #TEMPLATE_HEX_ESCAPE_SEQUENCE: "x" <TEMPLATE_HEX_DIGIT> <TEMPLATE_HEX_DIGIT> >
| 	< #TEMPLATE_HEX_DIGIT: ["0"-"9","a"-"f","A"-"F"] >
| 	< #TEMPLATE_UNICODE_ESCAPE_SEQUENCE: "u" <HEX_DIGIT> <HEX_DIGIT> <HEX_DIGIT> <HEX_DIGIT> >
|	< #TEMPLATE_SINGLE_ESCAPE_CHARACTER: ["'" , "\"", "`" , "\\" , "b" , "f" , "n" , "r" , "t" , "v"] >
|	< #TEMPLATE_NON_ESCAPE_CHARACTER: 
		~["\n","\r","\u2028","\u2029"]
	| 
		~["'" , "\"" , "`" , "\\" , "b" , "f" , "n" , "r" , "t" , "v", "x", "u"]
	| 
		~["0"-"9"]
	>

}


/* Section 7.8.5: Regular Expression Literals */

<DEFAULT>
TOKEN: {
	<REGULAR_EXPRESSION_LITERAL: "/" <REGULAR_EXPRESSION_BODY> "/" ( <IDENTIFIER_PART> ) *> : NO_REGEX
|	<#REGULAR_EXPRESSION_BODY: <REGULAR_EXPRESSION_FIRST_CHAR> ( <REGULAR_EXPRESSION_CHAR> ) *>
|	<#REGULAR_EXPRESSION_CHAR:
    	~[ "\r" , "\n" , "\u2028" , "\u2029", "\\", "/", "[" ]
	|	<REGULAR_EXPRESSION_BACKSLASH_SEQUENCE>
	|	<REGULAR_EXPRESSION_CLASS>
	>
|	<#REGULAR_EXPRESSION_FIRST_CHAR: 
		~[ "\r" , "\n" , "\u2028" , "\u2029", "*", "\\", "/", "[" ]
	|	<REGULAR_EXPRESSION_BACKSLASH_SEQUENCE>
	|	<REGULAR_EXPRESSION_CLASS>
	>
|	<#REGULAR_EXPRESSION_BACKSLASH_SEQUENCE:
		"\\" ~[ "\r" , "\n" , "\u2028" , "\u2029" ]
	>
|	<#REGULAR_EXPRESSION_CLASS:
		"["
		(
			<REGULAR_EXPRESSION_CLASS_CHAR>
		) *
		"]"
	>
|	<#REGULAR_EXPRESSION_CLASS_CHAR:
		~[ "\r" , "\n" , "\u2028" , "\u2029", "\\", "]" ]
	|	<REGULAR_EXPRESSION_BACKSLASH_SEQUENCE>
	>
}

/* Section 7.6: Identifiers */
/* Moved here after the literals */
<DEFAULT, NO_REGEX>
TOKEN:
{
	< IDENTIFIER_NAME: <IDENTIFIER_START> (<IDENTIFIER_PART>)* > : NO_REGEX
|	< #IDENTIFIER_START:
	  <UNICODE_LETTER>
	| "\\" <UNICODE_ESCAPE_SEQUENCE>
	| <DOLLAR_SIGN>
	| <UNDER_SCORE>
	| <SUPPLEMENTARY_IDENTIFIER_CHAR>
	>
| 	< #IDENTIFIER_PART:
	  <IDENTIFIER_START>
	| <UNICODE_DIGIT>
	| <UNICODE_COMBINING_MARK>
	| <UNICODE_CONNECTOR_PUNCTUATION>
	| <UNICODE_ID_CONTINUE_ONLY>
	| <ZWNJ>
	| <ZWJ>
	>
	// Astral-plane (beyond U+FFFF) ID_Start/ID_Continue characters are
	// surrogate pairs in UTF-16; not validated per-codepoint (unlike the
	// BMP ranges below, which are generated from
	// Character.isUnicodeIdentifierStart/Part), so this is permissive:
	// any well-formed surrogate pair is accepted as an identifier
	// character. Real code only uses assigned, letter-like astral
	// characters here, so this trades a small amount of over-acceptance
	// for avoiding an enormous per-codepoint surrogate-pair table.
|	< #SUPPLEMENTARY_IDENTIFIER_CHAR: ["\uD800"-"\uDBFF"] ["\uDC00"-"\uDFFF"] >
|	< #DOLLAR_SIGN: "$" > /* GaltaJS extension */
|  	< #UNDER_SCORE: "_" >
