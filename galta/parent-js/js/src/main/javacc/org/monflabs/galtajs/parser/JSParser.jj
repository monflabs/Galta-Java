/* Section 14: Program */

ASTProgram MainProgram(String text): {
	List <ASTNode > nodes;
}
{
    /*[<SHEBANG>]*/
    {
        // Gated on JSConfiguration.supportTopLevelObjectLiteral() (off by
        // default, on with enableGaltaJSExtensions()): a standard environment
        // reads a sole top-level "{...}" as the block/labeled statement
        // ECMA-262 specifies.
        isSoleObjectLiteralProgram = env.supportTopLevelObjectLiteral() && computeSoleObjectLiteralProgram(text);
    }
    nodes = MainSourceElements()  <EOF>
    	{
        	return nodeFactory.createProgram(text, nodes, false);
     	}
}

ASTProgram MainExpression(String text): {
	ASTNode node;
}
{
    node = Expression()  <EOF>
    	{
        	return nodeFactory.createProgram(text, Collections.singletonList(node), false);
     	}
}

ASTFunctionDecl MainFunction(String text): {
	ASTNode node;
}
{
    node = FunctionDeclaration()  <EOF>
    	{
        	ASTFunctionDecl fct = (ASTFunctionDecl)node;
        	fct.setSourceCode(text);
        	return fct;
     	}
}

List<ASTNode> MainSourceElements(): {
	ASTNode node;
	List<ASTNode> nodes = new ArrayList<ASTNode>();
}
{
  	(
    /* GaltaJS extension to support inline object definitions */
    /* We only do that in main statements to avoid ambiguities with labels for() { loop: xxx } */
    /* Restricted to a SOLE top-level "{...}" (immediately followed by EOF) - see
       isSoleTopLevelObjectLiteral() - so this doesn't shadow the ECMA-262-correct
       Block/LabeledStatement interpretation for any "{"-shaped occurrence that
       ISN'T the entire remaining program/eval'd text. */
      LOOKAHEAD({isSoleTopLevelObjectLiteral()}) node=ObjectLiteral()
    	{
     	  	// isSoleObjectLiteralProgram is a single flag precomputed ONCE for
     	  	// the whole MainProgram() call (see its own declaration/comment) -
     	  	// a bare semantic LOOKAHEAD re-evaluates it on EVERY iteration of
     	  	// this (...)* loop, so leaving it true after taking this branch
     	  	// once would wrongly re-enter ObjectLiteral() on a LATER
     	  	// iteration too (e.g. the trailing ";" in the decompiled-and-
     	  	// reparsed "{ ... };" form this tolerates - see
     	  	// computeSoleObjectLiteralProgram()'s own comment - has no "{"
     	  	// to start an object literal with, so ObjectLiteral() would
     	  	// immediately fail to parse it). Reset once the sole object
     	  	// literal has actually been consumed, so any leftover content
     	  	// (just that one tolerated ";", after this loop's FIRST and
     	  	// ONLY real iteration) falls through to ordinary Statement()
     	  	// dispatch instead.
     	  	isSoleObjectLiteralProgram = false;
     	  	// See ASTObjectLiteral.markBareTopLevelEmptyPromotion()'s own doc -
     	  	// only ever set for the genuinely EMPTY "{}" case, never a
     	  	// non-empty promoted object literal (e.g. "{a:1}"), which must
     	  	// keep evaluating to the object unconditionally, eval or not.
     	  	if(node instanceof org.monflabs.galtajs.node.literal.ASTObjectLiteral
     	  	    && ((org.monflabs.galtajs.node.literal.ASTObjectLiteral)node).isEmpty()) {
     	  	  ((org.monflabs.galtajs.node.literal.ASTObjectLiteral)node).markBareTopLevelEmptyPromotion();
     	  	}
     	  	if(debug) {
     	  	  node = nodeFactory.createDebugHookStatement(node);
     		}
        	nodes.add(node);
    	}
 	| LOOKAHEAD(1, {getToken(1).kind!=IMPORT || getToken(2).kind==LPAREN || getToken(2).kind==DOT}) node=Statement()
    	{
     	  	if(debug) {
     	  	  node = nodeFactory.createDebugHookStatement(node);
     		}
        	nodes.add(node);
    	}
  	| node=ExportStatement()
  		{
     	  	if(debug) {
     	  	  node = nodeFactory.createDebugHookStatement(node);
     		}
        	nodes.add(node);
  		}
    // Statement()'s own LOOKAHEAD above only claims a bare "import" token
    // when it's immediately followed by "(" (the dynamic ImportCall
    // expression) or "." (import.defer(...)/import.source(...), or an
    // unimplemented "import.meta" - either way, still MemberExpressionHead()
    // territory, not a static ImportDeclaration) - every other "import ..."
    // form (the static ImportDeclaration: "import x from", "import * as",
    // "import {", "import \"specifier\"") falls through to here instead.
    | node=ImportStatement()
    	{
     	  	if(debug) {
     	  	  node = nodeFactory.createDebugHookStatement(node);
     		}
        	nodes.add(node);
   		}  
 	)*
	 	{
	 	  return nodes;
		}
}

List<ASTNode> SourceElements(): {
	ASTNode node;
	List<ASTNode> nodes = new ArrayList<ASTNode>();
}
{
  	( LOOKAHEAD(1, {getToken(1).kind!=IMPORT || getToken(2).kind==LPAREN || getToken(2).kind==DOT}) node=Statement()
    	{
     	  	if(debug) {
     	  	  node = nodeFactory.createDebugHookStatement(node);
     		}
        	nodes.add(node);
    	}
  	| node=ExportStatement()
  		{
     	  	if(debug) {
     	  	  node = nodeFactory.createDebugHookStatement(node);
     		}
        	nodes.add(node);
  		}
    // See the identical guard's own comment on MainSourceElements()'s
    // Statement() alternative above.
    | node=ImportStatement()
    	{
     	  	if(debug) {
     	  	  node = nodeFactory.createDebugHookStatement(node);
     		}
        	nodes.add(node);
   		}
 	)*
	 	{
	 	  return nodes;
		}
}

ASTNode ImportStatement(): {
    Token t;
    ASTImport imp;
}
{
    t="import" {imp=nodeFactory.createImport(t);}
    // `import source x from '...'` (source-phase-imports proposal) -
    // "source" is contextual, exactly like "defer" below: `import source
    // from '...'` is an ordinary default import named "source", and
    // `import source from from '...'` a source-phase import whose binding
    // is named "from" (test262 import-source-binding-name*_FIXTURE.js). So
    // this commits only on the full "source <binding> from <string>"
    // shape; the binding is stored as the default import.
    [ LOOKAHEAD({getToken(1).kind==IDENTIFIER_NAME && getToken(1).image.equals("source")
                 && getToken(2).kind==IDENTIFIER_NAME
                 && getToken(3).kind==IDENTIFIER_NAME && getToken(3).image.equals("from")
                 && getToken(4).kind==STRING_LITERAL})
      Identifier_Name() { imp.setSourcePhase(true); } ]
    // `import defer * as ns from '...'` (import-defer proposal) - "defer"
    // is a CONTEXTUAL keyword (like "as"/"from" elsewhere in this same
    // grammar), not reserved: `import defer from '...'` (no asterisk) is
    // an ORDINARY default import whose local binding happens to be named
    // "defer" (test262 own valid-default-binding-named-defer.js) - so
    // this must commit to the deferred form ONLY when "defer" is
    // IMMEDIATELY followed by "*", never on "defer" alone. Every other
    // "defer ..." combination (default, named-list, defer+default,
    // default+defer) is intentionally left unhandled here - it falls
    // through to ImportFromBlock() below, which fails to match any of
    // its own alternatives for those shapes and naturally raises a
    // SyntaxError (spec: `import defer` only ever combines with a
    // NameSpaceImport, nothing else).
    [ LOOKAHEAD({getToken(1).kind==IDENTIFIER_NAME && getToken(1).image.equals("defer") && getToken(2).image.equals("*")})
      Identifier_Name() { imp.setDeferred(true); } ]
    ImportFromBlock(imp) insertSemiColon()
    	{
     		return imp;
    	}
}

void ImportFromBlock(ASTImport imp): {
  Token from, def=null;
}
{
	LOOKAHEAD(Identifier_Name() Identifier_From()) def=Identifier_Name() Identifier_From() from=<STRING_LITERAL> [LOOKAHEAD(2) WithClause(imp)]
		{ imp.setDefaultImport(bindingIdentifier(def)); imp.setFrom(ASTLiteral.parseString(from.image)); }
|   LOOKAHEAD(Identifier_Name() ",") def=Identifier_Name() "," (ImportNamespace(imp) | ModuleList(imp)) Identifier_From() from=<STRING_LITERAL> [LOOKAHEAD(2) WithClause(imp)]
		{ imp.setDefaultImport(bindingIdentifier(def)); imp.setFrom(ASTLiteral.parseString(from.image)); }
|   (ImportNamespace(imp) | ModuleList(imp)) Identifier_From() from=<STRING_LITERAL> [LOOKAHEAD(2) WithClause(imp)]
		{ imp.setFrom(ASTLiteral.parseString(from.image)); }
|   from=<STRING_LITERAL> [LOOKAHEAD(2) WithClause(imp)]
		{ imp.setFrom(ASTLiteral.parseString(from.image)); }
}

// WithClause (import/export attributes, e.g. `with { type: "json" }`) -
// AttributesKeyword is "with" (the same token as the with-STATEMENT's
// own reserved word - no separate lexer state needed, its use here is
// unambiguous since it can only appear right after a ModuleSpecifier).
// LOOKAHEAD(2) at each call site: a bare "with" alone is never valid
// here (always followed by "{"), so 2 tokens is enough to distinguish
// "this IS a WithClause" from "there is none" without misfiring on
// nothing (a normal StatementListItem can't immediately follow a module
// specifier's STRING_LITERAL at this exact grammar position anyway, but
// LOOKAHEAD keeps this production self-contained/order-independent).
void WithClause(ASTImpExp imp): {
}
{
	"with" "{" [ WithEntry(imp) ( LOOKAHEAD(2) "," WithEntry(imp) )* [","] ] "}"
	{
		// Distinguishes "no WithClause at all" (getAttributes()==null) from
		// an explicit-but-empty `with {}` (a real, non-null empty map) -
		// test262 import-attribute-empty.js's own idiom.
		imp.ensureAttributes();
	}
}

void WithEntry(ASTImpExp imp): {
	Token k=null, ks=null, v;
}
{
	(k=Property_Name()|ks=<STRING_LITERAL>) ":" v=<STRING_LITERAL>
	{
		String key = k!=null ? ASTLiteral.parseIdentifier(k.image) : ASTLiteral.parseString(ks.image);
		// Early error (spec WithClause static semantics): AttributeKeys
		// must be pairwise distinct.
		if(imp.getAttributes()!=null && imp.getAttributes().containsKey(key)) {
			throw generateParseException();
		}
		imp.addAttribute(key, ASTLiteral.parseString(v.image));
	}
}

void ImportNamespace(ASTImpExp imp): {
  Token t;
}
{
  	"*" Identifier_As() t=Identifier_Name()
  	{
  	  imp.setNamespace(bindingIdentifier(t));
 	}
}

void ModuleList(ASTImpExp imp): {
}
{
  	// NamedImports/NamedExports (spec): the entry list may be EMPTY
  	// (`import {} from '...'`/`export {}` - a common test262 idiom for "run
  	// this module for its side effects only") and may carry a trailing
  	// comma after the last entry (`import { x, } from '...'`) - both
  	// previously unhandled here, always requiring at least one entry with
  	// no trailing comma allowed. LOOKAHEAD(2) on the loop's "," is needed
  	// so a "," immediately followed by "}" (a trailing comma) falls
  	// through to the `[","]` alternative instead of the bare `(...)* `
  	// construct trying (and failing, no backtrack) to parse another
  	// ModuleEntry() right after it - JavaCC flagged this exact ambiguity
  	// as a choice-conflict warning without it.
  	"{" [ ModuleEntry(imp) ( LOOKAHEAD(2) "," ModuleEntry(imp) )* [","] ] "}"
}
void ModuleEntry(ASTImpExp imp): {
  Token ni=null, ns=null, a=null,as=null;
}
{
	(ni=Property_Name()|ns=< STRING_LITERAL>) (Identifier_As() (a=Property_Name()|as=< STRING_LITERAL>))?
	{
		// ni/a (from Property_Name(), an IdentifierName token) must be
		// DECODED the same way a plain Identifier() is (ASTLiteral.
		// parseIdentifier, not the raw .image) - an IdentifierName may
		// itself contain a Unicode escape sequence (backslash, letter u,
		// four hex digits) - test262 namespace/internals/own-property-
		// keys-sort.js's `export { x as ... };` (an escaped Greek mu) was
		// storing the literal escape-sequence source text as the export
		// name instead of the single decoded character.
		imp.addItem(ni!=null? ASTLiteral.parseIdentifier(ni.image)
							: ASTLiteral.parseString(ns!=null?ns.image:""),
							a!=null? ASTLiteral.parseIdentifier(a.image)
								   : (as!=null?ASTLiteral.parseString(as!=null?as.image:""):null),
							ns!=null
					);
	}
}

ASTNode ExportStatement(): {
    Token t;
    ASTExport exp;
    ASTNode expr=null;
}
{
   LOOKAHEAD("export" "default") t="export" {exp=nodeFactory.createExport(t);} "default" {Token first=getToken(1);} expr=AssignmentExpression()
   	{
   	  // export default [lookahead != function, async function, class]
   	  // AssignmentExpression - a default starting with one of those is the
   	  // declaration form, never an expression such as "function(){}()"
   	  if((first.kind==FUNCTION || first.kind==CLASS || (first.kind==ASYNC && first.next!=null && first.next.kind==FUNCTION))
   	      && !(expr instanceof ASTFunctionDecl) && !(expr instanceof ASTClassDecl)) {
   	    throw generateParseException();
   	  }
   	  // "export default function fn(){}"/"export default class Foo{}" parse
   	  // through the SAME PrimaryExpression()->FunctionDeclaration()/
   	  // ClassDeclaration() production a plain named function/class
   	  // EXPRESSION does (see PrimaryExpression()'s own "async function"
   	  // comment) - but per spec (ExportDeclaration : export default
   	  // HoistableDeclaration / export default ClassDeclaration) a NAMED one
   	  // here is a genuine DECLARATION, not a self-referencing expression:
   	  // its name binds an ordinary, MUTABLE module-scope binding (like the
   	  // plain "export function fn(){}" branch below already gets via this
   	  // same setStatement(true) call), not the immutable FUNCTION_SELF/
   	  // class-inner-self-reference binding a real expression form would.
   	  // Confirmed via test262's own eval-gtbndng-indirect-update-dflt.js
   	  // family: `export default function fn(){ fn = 2; ... }` must be able
   	  // to reassign its own name. An ANONYMOUS function/class is unaffected
   	  // either way (no name means no self-binding is ever created).
   	  if(expr instanceof ASTFunctionDecl) {
   	    ((ASTFunctionDecl)expr).setStatement(true);
   	  } else if(expr instanceof ASTClassDecl) {
   	    ((ASTClassDecl)expr).setStatement(true);
   	  } else {
   	    // `export default AssignmentExpression ;` - the only default form
   	    // that ends with a semicolon (subject to ASI)
   	    insertSemiColon();
   	  }
   	  exp.setDefaultExport(expr);
   	  return exp;
   	}
  | t="export" {exp=nodeFactory.createExport(t);} (ExportFromBlock(exp) insertSemiColon() | expr=Declaration())
  	{
  	  if(expr!=null) {
  	    if(expr instanceof ASTFunctionDecl) {
    	    ((ASTFunctionDecl)expr).setStatement(true);
  	  	} else if(expr instanceof ASTClassDecl) {
  	  	    // `export class C {}` (non-default) - same setStatement(true)
  	  	    // treatment as the plain "export function fn(){}" branch just
  	  	    // above (and as the "export default class Foo{}" branch two
  	  	    // productions up): without it, ASTClassDecl.init()'s own
  	  	    // isStatement()-gated check never registers C's outer,
  	  	    // ordinary LET binding at all (see that method's own doc
  	  	    // comment), so C's name never gets a module-hoist-pass TDZ
  	  	    // placeholder or a live-binding-eligible variable cell -
  	  	    // confirmed via instn-named-bndng-cls.js, a self-import of a
  	  	    // named class export.
  	  	    ((ASTClassDecl)expr).setStatement(true);
  	  	}
   	  	exp.setNamedExport(expr);
   	  }
   	  return exp;
 	}
}

void ExportFromBlock(ASTImpExp impExp): {
    Token from=null;
}
{
    ExportNamespace(impExp) Identifier_From() from=<STRING_LITERAL> [LOOKAHEAD(2) WithClause(impExp)]
    {
  	  	impExp.setFrom(ASTLiteral.parseString(from.image));
    }
  | ModuleList(impExp) (Identifier_From() from=<STRING_LITERAL> [LOOKAHEAD(2) WithClause(impExp)])?
  	{
  	  if(from!=null) {
  	  	impExp.setFrom(ASTLiteral.parseString(from.image));
  	  }
  	}
}


void ExportNamespace(ASTImpExp imp): {
  Token t=null, s=null;
}
{
  	// `export * as ns from '...'`/`export * as "ns" from '...'` - the
  	// string-literal alias form (arbitrary module namespace names
  	// proposal) mirrors ModuleEntry()'s own identical two-alternative
  	// handling for `export {a as "b"}`.
  	"*" (Identifier_As() (t=Property_Name()|s=<STRING_LITERAL>))?
  	{
  	  imp.setNamespace(t!=null ? ASTLiteral.parseIdentifier(t.image) : (s!=null ? ASTLiteral.parseString(s.image) : null));
 	}
}


ASTNode Declaration(): {
    ASTNode n;
}
{
    n=VariableStatement()
    	{return n; }
  | n=FunctionDeclaration()
    	{return n; }
  | n=ClassDeclaration()
    	{return n; }
}


/*
  See: Identifier_From()
  How do I deal with keywords that aren't reserved?
*/
void Identifier_As(): {
}
{
	LOOKAHEAD( {getToken(1).kind == IDENTIFIER_NAME && getToken(1).image.equals("as") } )
	Identifier_Name()
}
void Identifier_From(): {
}
{
	LOOKAHEAD( {getToken(1).kind == IDENTIFIER_NAME && getToken(1).image.equals("from") } )
	Identifier_Name()
}


Token Identifier_Name(): {
  Token t;
}
{
  (
      t=<IDENTIFIER_NAME>
  	| t=<GET>
  	| t=<SET>
  	| t=<ASYNC>
  	| t=<AWAIT>
  	| t=<SYNCHRONIZED>
  	/* "synchronized" was removed from the reserved word list in ES5 and is
  	   never reserved; unlike "static"/"yield" below it needs no strict-mode
  	   distinction. */
  	| t=<LET>
  	/* "let" is only reserved (a) in strict-mode code (not tracked - separate
  	   gap, see KnownGaps.md) or (b) where it actually starts a
  	   LexicalDeclaration - see isLetDeclaration(), which gates the literal
  	   "let" keyword alternatives in VariableStatement()/ForInitialization()/
  	   LoopVariable(). Everywhere else (reached here), it's a plain
  	   Identifier: "var let = 2;", "let: 1;" (label), "for (let in obj)". */
  	| LOOKAHEAD({!yieldReserved && getToken(1).kind==YIELD}) t=<YIELD>
  	/* "yield" is usable as an ordinary identifier everywhere except directly
  	   within a generator's own FormalParameters/FunctionBody (yieldReserved,
  	   maintained by FunctionDeclaration()). Strict-mode reserved-ness isn't
  	   enforced (see below).
  	   The extra "getToken(1).kind==YIELD" conjunct (beyond the semantic
  	   !yieldReserved check alone) matters because of how javacc compiles a
  	   LOOKAHEAD({semantic}) guarding a SINGLE-token alternative that's
  	   followed by further alternatives: it generates a plain
  	   "if(!yieldReserved) { consume YIELD } else { <try next alternative> }"
  	   - i.e. once yieldReserved is false it unconditionally commits to
  	   consuming YIELD without ever checking the actual next token, so any
  	   OTHER token (e.g. "using") reaching this point outside a generator
  	   body would fail to parse instead of falling through to the <USING>
  	   alternative below. Confirmed via test262 language/reserved-words/
  	   unreserved-words.js's "var using = 1;". */
  	| t=<USING>
  	/* "using" is a contextual keyword (explicit resource management) - only
  	   special right before an identifier with no line terminator, in a
  	   declaration-statement position (see VariableStatement()'s own
  	   lookahead); everywhere else, including "using = 1" or "using.foo()",
  	   it's an ordinary identifier. */
  	| t=<STATIC>
  	/* "static" is only reserved as an identifier in STRICT-mode code (Annex C
  	   FutureReservedWord); in sloppy code it's a plain Identifier ("var
  	   static = 1;" etc. - test262 language/future-reserved-words/static.js).
  	   The strict-mode restriction itself is enforced later, semantically, by
  	   checkStrictBindingName() (ASTNode.java), which already lists "static"
  	   in its isStrictFutureReservedWord() set and fires against the AST's
  	   genuine (init-time) strictness - no PARSE-time strict-mode tracking is
  	   needed here, unlike the still-unhandled "public"/"private"/"protected"/
  	   "interface"/"package"/"implements" siblings, which aren't reserved
  	   TOKENS at all (they lex as plain IDENTIFIER_NAME) so never reach this
  	   alternative in the first place; only the BINDING-name check
  	   (checkStrictBindingName) applies to them, not a grammar change. Class
  	   bodies still recognize "static" as the element modifier via
  	   ClassElement()'s own dedicated getToken().kind==STATIC lookahead
  	   (unaffected - that rule doesn't go through Identifier_Name() at all). */
  )
  { return t; }

}

Token Property_Name(): {
  Token t;
}
{
  (
      t=<IDENTIFIER_NAME>
  	| t=<ASYNC>
  	| t=<AWAIT>
  	| t=<BREAK>
  	| t=<CASE>
  	| t=<CATCH>
  	| t=<CLASS>
  	| t=<CONST>
  	| t=<CONTINUE>
  	| t=<DEBUGGER>
  	| t=<DELETE>
  	| t=<_DEFAULT>
  	| t=<DO>
  	| t=<ELSE>
  	| t=<ENUM>
  	| t=<EXPORT>
  	| t=<EXTENDS>
  	| t=<FINALLY>
  	| t=<FOR>
  	| t=<FUNCTION>
  	| t=<GET>
  	| t=<IF>
  	| t=<IN>
  	| t=<IMPORT>
  	| t=<INSTANCE_OF>
  	| t=<LET>
  	| t=<NEW>
  	| t=<RETURN>
  	| t=<SET>
  	| t=<STATIC>
  	| t=<SUPER>
  	| t=<SWITCH>
  	| t=<SYNCHRONIZED>
  	| t=<THIS>
  	| t=<THROW>
  	| t=<TRY>
  	| t=<TYPEOF>
  	| t=<USING>
  	| t=<VAR>
  	| t=<VOID>
  	| t=<WHILE>
  	| t=<WITH>
  	| t=<YIELD>
  	| t=<BOOLEAN_LITERAL>
  	| t=<NULL_LITERAL>
  )
  { return t; }

}

//
// Utility to insert a semi colon when needed
// This is changed to support multiple errors recovery
//
JAVACODE
void recoverFromError(boolean recoverError) {
  	for(;;) {
  	    if(checkSemiColon()) {
  	        return;
  	    }
	   	getNextToken();
	}
}
JAVACODE
void insertSemiColon() {
	if(!checkSemiColon()) {
	   	throw generateParseException();
  	}
}
JAVACODE
// Spec 14.7.2: the semicolon after `do Statement while ( Expression )` is
// always optional - unlike the generic ASI rule, this doesn't require a
// following LineTerminator/"}"/EOF; consume a ";" if present, otherwise
// just leave it for the next production to parse as a separate statement.
void insertSemiColonDoWhile() {
	Token inputToken = getToken(1);
	if(inputToken.kind == SEMICOLON) {
		getNextToken();
	}
}

//
// TypeScript-style type hints (JSConfiguration.supportTypeHints()): parsed
// for syntax only, then discarded - no AST node, no transpiler codegen.
// These four are ONLY ever called from the *IfAny() helpers in the
// PARSER_BEGIN block (themselves called from action blocks) - never
// referenced as a grammar expansion; see those helpers' own doc comment for
// why (javacc's force-success compilation of a JAVACODE reference inside a
// syntactic lookahead trial). With the flag off (the default) none of them
// ever consume anything, so parsing is byte-for-byte unchanged from before
// this feature existed.
//
JAVACODE
// Consumes a single type expression - see scanTypeEnd()'s own doc comment
// (near isArrowFunctionWithParens() above) for the full depth/continuation
// rules this implements. Callers always consume the type's own leading ":"
// themselves immediately before calling this.
void skipType() {
	int end = scanTypeEnd(1);
	Token stopAt = getToken(end);
	while (getToken(1) != stopAt) {
		// getToken(end) is a stable Token identity (JavaCC's own lookahead
		// buffer), so comparing against it (rather than an index that would
		// drift as getNextToken() shifts the buffer) is what actually stops
		// this at the right place.
		getNextToken();
	}
}
JAVACODE
// Consumes an optional "<...>" type-parameter/argument list - see
// scanTypeParametersEnd()'s own doc comment. The current token must be the
// leading "<" (callers gate entry with LOOKAHEAD("<")).
void skipTypeParameters() {
	int end = scanTypeParametersEnd(1);
	Token stopAt = getToken(end);
	while (getToken(1) != stopAt) {
		getNextToken();
	}
}
JAVACODE
// A light skip-loop for an "interface ... { ... }" body: brace-delimited
// member signatures, not a single type expression, so this is pure bracket
// balancing (like scanTypeParametersEnd()) rather than scanTypeEnd()'s
// continuation-operator logic - stops right before the interface's own
// closing "}", leaving it for the caller's own literal "}" to match.
void skipInterfaceBody() {
	int depth = 0;
	while (true) {
		Token t = getToken(1);
		int k = t.kind;
		if (k == EOF) {
			return;
		}
		if (depth == 0 && k == RBRACE) {
			return;
		}
		switch (k) {
			case LPAREN: case LBRACKET: case LBRACE: case LT: case TEMPLATE_EXPR_START:
				depth++; break;
			case RPAREN: case RBRACKET: case RBRACE: case GT: case GE:
				depth--; break;
			case RSHIFT: case RSHIFTASSIGN:
				depth -= 2; break;
			case RUNSHIFT: case RUNSHIFTASSIGN:
				depth -= 3; break;
		}
		if (depth < 0) {
			depth = 0;
		}
		getNextToken();
	}
}
JAVACODE
// Consumes a whole "declare"-wrapped statement (see DeclareStatement()'s
// own doc comment for why this is a flat skip rather than delegating to
// the real function/class/var/type/interface productions): stops right
// after a depth-0 ";" (consuming it, for the semicolon-terminated forms -
// function/var/let/const/type) or right after a depth-0 "}" (for the
// brace-bodied forms - class/interface), whichever comes first.
void skipDeclareSignature() {
	int depth = 0;
	while (true) {
		Token t = getToken(1);
		int k = t.kind;
		if (k == EOF) {
			return;
		}
		if (depth == 0 && k == SEMICOLON) {
			getNextToken();
			return;
		}
		switch (k) {
			case LPAREN: case LBRACKET: case LBRACE: case LT: case TEMPLATE_EXPR_START:
				depth++; break;
			case RPAREN: case RBRACKET: case RBRACE: case GT: case GE:
				depth--; break;
			case RSHIFT: case RSHIFTASSIGN:
				depth -= 2; break;
			case RUNSHIFT: case RUNSHIFTASSIGN:
				depth -= 3; break;
		}
		if (depth < 0) {
			depth = 0;
		}
		getNextToken();
		if (depth == 0 && k == RBRACE) {
			return;
		}
	}
}

JAVACODE
boolean checkSemiColon(){
	Token inputToken = getToken(1);
	if(inputToken.kind == SEMICOLON){
		inputToken = getNextToken();
	} else if((inputToken.kind != EOF) && (inputToken.kind != RBRACE)){
		if(inputToken.specialToken != null){
			boolean foundLineSeparator = false;
			Token specialT = inputToken.specialToken;	 

			while((specialT != null) && (! foundLineSeparator)){
				if((specialT.kind == LINE_TERMINATOR) || (specialT.kind == SINGLE_LINE_COMMENT)){
					foundLineSeparator = true;
				} else if(specialT.kind == MULTI_LINE_COMMENT && containsLineTerminator(specialT.image)){
					// A MultiLineComment containing a line terminator counts as a
					// LineTerminator for ASI purposes, even though "*/" itself doesn't.
					foundLineSeparator = true;
				}

				specialT = specialT.specialToken;
			}

			if(! foundLineSeparator){
				return false; 
			}
		} else {
			return false; 
		}
	}
	return true; 
}
