<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.monflabs.galta</groupId>
		<artifactId>parent-js</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>js-playground</artifactId>
	<name>GaltaJS Playground</name>
	<description>Interactive GaltaJS playground application.</description>

	<properties>
        <app.name>jsplayground</app.name>
        <!-- Main-Class of the executable jar built by the shade plugin (target/jsplayground.jar) -->
        <main.class>playground.GaltaJSPlayground</main.class>
        <app.version>1.0.0</app.version>
        <!-- Empty fallback for the surefire @{argLine} below: JaCoCo's prepare-agent
             appends its agent to it, and it stays defined when JaCoCo is skipped -->
        <argLine></argLine>
	</properties>


	<dependencies>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>playground-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>playground-ui-swing</artifactId>
			<exclusions>
				<!-- Rhino is only used by the RSyntaxTextArea JavaScript language
				     support (parser-based error marks), which the playground does
				     not install: Rhino flags the GaltaJS extensions as errors. The
				     JavaScript editors keep their syntax highlighting. Dropping it
				     removes 822 classes (12.4 MB -> 10.5 MB) from jsplayground.jar. -->
				<exclusion>
					<groupId>org.mozilla</groupId>
					<artifactId>rhino-all</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>js</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>js-debugger</artifactId>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Used directly by this module (was only present transitively) -->
		<dependency>
			<groupId>com.fifesoft</groupId>
			<artifactId>rsyntaxtextarea</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>filesystem</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>json-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>ui-commons</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>ui-swing</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>ui-swing-ide</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>utilities</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- The suite only: without includes every test class also runs on its own, twice in total -->
					<includes>
						<include>**/AllLangGaltaJSTests.class</include>
					</includes>
					<!-- Deep-recursion examples (e.g. es2015/Proper Tail Calls,
					     which deliberately recurses non-tail-call-optimized to
					     10000 levels to demonstrate the absence of proper tail
					     calls) can run the default JVM thread stack right down
					     to its limit. A genuine StackOverflowError that lands
					     while some unrelated JDK class is mid-<clinit> corrupts
					     that class for the rest of this forked JVM's life
					     (NoClassDefFoundError on every later use, even in
					     completely unrelated tests) - a real, if intermittent,
					     hazard confirmed via direct reproduction, not a
					     hypothetical. A larger stack gives normal recursion
					     depths (a few thousand levels) enough headroom to never
					     approach that danger zone in the first place.
					     @{argLine} keeps the JaCoCo agent set by prepare-agent. -->
					<argLine>@{argLine} -Xss64m</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.monflabs.galta.tools</groupId>
				<artifactId>filesystem-resources-manifest</artifactId>
				<executions>
					<execution>
						<id>generate</id>
						<goals>
							<goal>generate-sources</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<sourceDirectory>src/main/resources/snippets</sourceDirectory>
				</configuration>
			</plugin>
	       	<!--
            	Fat jar creation
            -->
            <!-- https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-shade-plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
<!--						<phase>package</phase> -->
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<finalName>${app.name}</finalName>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RS</exclude>
										<exclude>org/eclipse/**</exclude>
										<exclude>org/apache/commons/logging/**</exclude>
										<exclude>src/org/eclipse/jdt/**</exclude>
									</excludes>
								</filter>
								<!--
									The Galta jars all carry the same LICENSE and NOTICE: only the js
									jar contributes them, so the merged files hold one copy
								-->
								<filter>
									<artifact>org.monflabs.galta:json*</artifact>
									<excludes>
										<exclude>META-INF/LICENSE</exclude>
										<exclude>META-INF/NOTICE</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>org.monflabs.galta:utilities</artifact>
									<excludes>
										<exclude>META-INF/LICENSE</exclude>
										<exclude>META-INF/NOTICE</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>org.monflabs.galta:javacompiler</artifact>
									<excludes>
										<exclude>META-INF/LICENSE</exclude>
										<exclude>META-INF/NOTICE</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>org.monflabs.galta:filesystem</artifact>
									<excludes>
										<exclude>META-INF/LICENSE</exclude>
										<exclude>META-INF/NOTICE</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>org.monflabs.galta:test</artifact>
									<excludes>
										<exclude>META-INF/LICENSE</exclude>
										<exclude>META-INF/NOTICE</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>org.monflabs.galta:ui-*</artifact>
									<excludes>
										<exclude>META-INF/LICENSE</exclude>
										<exclude>META-INF/NOTICE</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>org.monflabs.galta:playground-*</artifact>
									<excludes>
										<exclude>META-INF/LICENSE</exclude>
										<exclude>META-INF/NOTICE</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>org.monflabs.galta:js-*</artifact>
									<excludes>
										<exclude>META-INF/LICENSE</exclude>
										<exclude>META-INF/NOTICE</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<!--
									The license files of the bundled jars (Galta's own LICENSE and
									NOTICE, and those of the libraries) are concatenated, not
									overwritten by the last jar
								-->
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/LICENSE</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/LICENSE.txt</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/NOTICE</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer">
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${main.class}</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>