<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.monflabs.galta</groupId>
		<artifactId>parent-json</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>json-config-test</artifactId>
	<name>Galta JSON Config Tests</name>
	<description>Test suites for Galta JSON Config. Not published.</description>

	<properties>
		<!-- Not published: excluded from the Maven Central bundle (see the root pom central profile) -->
		<maven.deploy.skip>true</maven.deploy.skip>
		<maven.javadoc.skip>true</maven.javadoc.skip>
		<gpg.skip>true</gpg.skip>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>json-config</artifactId>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>
	
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/AllJsonConfigTests.class</include>
					</includes>
				</configuration>
			</plugin>
			<!-- This module only has tests: its own JaCoCo report would be empty ("No class
			     files specified"). Report the coverage of the library modules it tests instead,
			     in target/site/jacoco-aggregate (needs them in the reactor: -am or a full build). -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>report</id>
						<phase>none</phase>
					</execution>
					<execution>
						<id>report-aggregate</id>
						<phase>verify</phase>
						<goals>
							<goal>report-aggregate</goal>
						</goals>
						<configuration>
							<includeCurrentProject>true</includeCurrentProject>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>