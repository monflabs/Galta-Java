<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.monflabs.galta</groupId>
		<artifactId>parent-playground</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>playground-ui-swing</artifactId>
	<name>Galta Playground Swing</name>
	<description>Swing user interface of the interactive scripting playground.</description>

	<properties>
	</properties>


	<dependencies>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>playground-core</artifactId>
		</dependency>

		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>ui-swing-ide</artifactId>
		</dependency>

		<!-- https://mvnrepository.com/artifact/com.fifesoft/languagesupport -->
		<dependency>
			<groupId>com.fifesoft</groupId>
			<artifactId>languagesupport</artifactId>
		</dependency>


		<!-- Used directly by this module (was only present transitively) -->
		<dependency>
			<groupId>com.fifesoft</groupId>
			<artifactId>rsyntaxtextarea</artifactId>
		</dependency>
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark</artifactId>
		</dependency>
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark-ext-gfm-tables</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>utilities</artifactId>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- The suite only: without includes every test class also runs on its own, twice in total -->
					<includes>
						<include>**/AllPlaygroundSwingTests.class</include>
					</includes>
					<!-- The tests use Swing components, never a window: no display needed -->
					<systemPropertyVariables>
						<java.awt.headless>true</java.awt.headless>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>


</project>