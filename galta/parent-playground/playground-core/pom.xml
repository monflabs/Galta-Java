<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.monflabs.galta</groupId>
		<artifactId>parent-playground</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>playground-core</artifactId>
	<name>Galta Playground Core</name>
	<description>Core of the interactive scripting playground: snippets, execution engines and markdown rendering.</description>

	<dependencies>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>utilities</artifactId>
			<version>${revision}</version>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>filesystem</artifactId>
			<version>${revision}</version>
		</dependency>

		<!-- Markdown to HTML -->
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark-ext-gfm-tables</artifactId>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>test</artifactId>
			<version>${revision}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- The suite only: without includes every test class also runs on its own, twice in total -->
					<includes>
						<include>**/AllSnippetTests.class</include>
					</includes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.monflabs.galta.tools</groupId>
				<artifactId>filesystem-resources-manifest</artifactId>
				<version>${revision}</version>
				<executions>
					<execution>
						<id>generate</id>
						<goals>
							<goal>generate-sources</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<sourceDirectory>src/test/resources/snippets</sourceDirectory>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>