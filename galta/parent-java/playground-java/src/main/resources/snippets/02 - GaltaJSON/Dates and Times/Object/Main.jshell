import org.monflabs.json.*;

var o = JsonObject.of(
  "local_date", "2020-02-20",
  "local_time", "13:44:18",
  "local_datetime", "2020-02-20T13:44:18",
  "offset_time", "13:44:18+02:00",
  "offset_datetime", "2020-02-20T13:44:18+02:00",
  "zoned_datetime", "2020-02-20T13:44:18-05:00[US/Eastern]"
);

// Read and parse the date/time objects
System.out.println( o.getLocalDate("local_date") );
System.out.println( o.getLocalTime("local_time") );
System.out.println( o.getLocalDateTime("local_datetime") );
System.out.println( o.getOffsetTime("offset_time") );
System.out.println( o.getOffsetDateTime("offset_datetime") );
System.out.println( o.getZonedDateTime("zoned_datetime") );

// Set the date time value
o = JsonObject.create();
o.put("ld",  java.time.LocalDate.of(2020, 2, 20) );
o.put("lt",  java.time.LocalTime.of(13, 44, 18) );
o.put("ldt", java.time.LocalDateTime.of(2020, 2, 20, 13, 44, 18) );
o.put("ot",  java.time.OffsetTime.of(13, 44, 18, 0, java.time.ZoneOffset.ofHours(2)) );
o.put("odt", java.time.OffsetDateTime.of(2020, 2, 20, 13, 44, 18, 0, java.time.ZoneOffset.ofHours(2)) );
o.put("zdt", java.time.ZonedDateTime.of(2020, 2, 20, 13, 44, 18, 0, java.time.ZoneId.of("US/Eastern")));


System.out.println(o.stringify());
