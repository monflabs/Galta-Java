import org.monflabs.json.*;

// Parse the date/time objects
System.out.println( JsonUtil.parseLocalDate("2020-02-20") );
System.out.println( JsonUtil.parseLocalTime("13:44:18") );
System.out.println( JsonUtil.parseLocalDateTime("2020-02-20T13:44:18") );
System.out.println( JsonUtil.parseOffsetTime("13:44:18+02:00") );
System.out.println( JsonUtil.parseOffsetDateTime("2020-02-20T13:44:18+02:00") );
System.out.println( JsonUtil.parseZonedDateTime("2020-02-20T13:44:18-05:00[US/Eastern]") );

// Serialize date/time object
System.out.println( JsonUtil.toString(java.time.LocalDate.of(2020, 2, 20)) );
System.out.println( JsonUtil.toString(java.time.LocalTime.of(13, 44, 18)) );
System.out.println( JsonUtil.toString(java.time.LocalDateTime.of(2020, 2, 20, 13, 44, 18) ) );
System.out.println( JsonUtil.toString(java.time.OffsetTime.of(13, 44, 18, 0, java.time.ZoneOffset.ofHours(2))) );
System.out.println( JsonUtil.toString(java.time.OffsetDateTime.of(2020, 2, 20, 13, 44, 18, 0, java.time.ZoneOffset.ofHours(2))) );
System.out.println( JsonUtil.toString(java.time.ZonedDateTime.of(2020, 2, 20, 13, 44, 18, 0, java.time.ZoneId.of("US/Eastern"))) );
