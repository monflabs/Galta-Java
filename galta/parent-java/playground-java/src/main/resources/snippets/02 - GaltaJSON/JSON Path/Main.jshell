import org.monflabs.json.*;
import org.monflabs.json.jsonpath.*;

var json = JsonObject.parse("""
	{ "store": {
	    "book": [
	      { "category": "reference", "author": "Nigel Rees", "title": "Sayings of the Century", "price": 8.95 },
	      { "category": "fiction", "author": "Evelyn Waugh", "title": "Sword of Honour", "price": 12.99 },
	      { "category": "fiction", "author": "Herman Melville", "title": "Moby Dick", "price": 8.99 },
	      { "category": "fiction", "author": "J. R. R. Tolkien", "title": "The Lord of the Rings", "price": 22.99 }
	    ],
	    "bicycle": { "color": "red", "price": 19.95 }
	} }
	""");

JsonPath authors = JsonPathFactory.get().getJsonPath("$.store.book[*].author");
System.out.println( authors.read(json).toJsonArray().stringify() );   // the 4 authors

// A small helper to try paths
String read(Object doc, String path) {
	return JsonPathFactory.get().getJsonPath(path).read(doc).toJsonArray().stringify();
}

System.out.println( read(json, "$..author") );                 // deep scan: the 4 authors
System.out.println( read(json, "$.store..price") );            // every price
System.out.println( read(json, "$..book[-1].title") );         // the last book
System.out.println( read(json, "$..book[:2].title") );         // a slice: the first two
System.out.println( read(json, "$..book[?@.price < 10].title") );   // a filter: the cheap books
