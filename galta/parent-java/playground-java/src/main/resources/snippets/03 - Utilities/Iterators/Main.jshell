import java.util.*;
import org.monflabs.util.iterators.*;

Iterator<Integer> numbers = Iterators.intSequence(0, 20).objectIterator();   // 0..19
Iterator<String> it = Iterators.map(
		Iterators.limit(Iterators.skip(Iterators.filter(numbers, n -> n % 2 == 0), 1), 3),
		n -> "#" + n);
System.out.println( Iterators.collect(it) );           // [#2, #4, #6]

List<String> names = List.of("ann", "bob", "cid", "dan");
System.out.println( Iterators.collect(Iterators.filter(names.iterator(), (s, index) -> index % 2 == 1)) );   // [bob, dan]
System.out.println( Iterators.last(names.iterator()) );   // dan

Iterable<Integer> both = Iterables.concat(List.of(1, 2), List.of(3));
System.out.println( Iterators.collect(both.iterator()) ); // [1, 2, 3]
