<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.monflabs.galta</groupId>
		<artifactId>parent-java</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>playground-java</artifactId>
	<name>Galta Java Playground</name>
	<description>Interactive playground running Java and JShell snippets, compiled in memory.</description>

	<dependencies>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>utilities</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>filesystem</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>ui-swing-ide</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>playground-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>javacompiler</artifactId>
		</dependency>
		<dependency>
		    <groupId>org.monflabs.galta</groupId>
		    <artifactId>playground-ui-swing</artifactId>
		</dependency>
		
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.monflabs.galta</groupId>
			<artifactId>test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	
	<build>
		<plugins>
			<plugin>
				<groupId>org.monflabs.galta.tools</groupId>
				<artifactId>filesystem-resources-manifest</artifactId>
				<!-- One manifest per snippet folder: only the test one used to be generated, so the
				     packaged playground listed 2 of its snippets -->
				<executions>
					<execution>
						<id>generate</id>
						<goals>
							<goal>generate-sources</goal>
						</goals>
						<configuration>
							<sourceDirectory>src/main/resources/snippets</sourceDirectory>
						</configuration>
					</execution>
					<execution>
						<id>generate-test</id>
						<goals>
							<goal>generate-sources</goal>
						</goals>
						<configuration>
							<sourceDirectory>src/test/resources/snippets</sourceDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/AllLangJavaTests.class</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>