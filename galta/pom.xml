<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.monflabs.galta</groupId>
		<artifactId>Galta-Java</artifactId>
		<version>${revision}</version>
	</parent>

	<artifactId>galta</artifactId>
	<packaging>pom</packaging>

	<name>Galta Libraries</name>
	<description>Parent of the Galta library modules: utilities, JSON, UI, playground and the GaltaJS scripting engine.</description>

	<!--
		Plugin versions and configuration, third-party dependency versions, the
		Java level and the release profiles all come from monflabs-parent (through
		the root pom). Galta's own artifacts come from galta-bom, imported below:
		declare them without a version.
	-->
	<modules>
		<module>galta-bom</module>
		<module>parent-demodata</module>
		<module>parent-json</module>
		<module>parent-js</module>
		<module>parent-playground</module>
		<module>parent-ui</module>
		<module>parent-utilities</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<!-- Resolved from this reactor: no prior install needed -->
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>galta-bom</artifactId>
				<version>${revision}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Modules used inside Galta but not published, so not in galta-bom -->
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-test-suite</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-test-suite</artifactId>
				<version>${revision}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-library-v8</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.monflabs.galta</groupId>
				<artifactId>js-regexp-joni-custom</artifactId>
				<version>${revision}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
