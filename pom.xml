<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
	child.project.url.inherit.append.path="false">
	<modelVersion>4.0.0</modelVersion>

	<!--
		monflabs-parent (tools/monflabs-parent) holds the Java level, the
		third-party dependency versions, the plugin versions and configuration,
		the build rules and the release profiles. It is found by relativePath,
		so a fresh clone builds without anything installed. Its version is a
		literal: keep it equal to ${revision} below.
	-->
	<parent>
		<groupId>org.monflabs.galta.tools</groupId>
		<artifactId>monflabs-parent</artifactId>
		<version>0.8.0</version>
		<relativePath>tools/monflabs-parent/pom.xml</relativePath>
	</parent>

	<groupId>org.monflabs.galta</groupId>
	<artifactId>Galta-Java</artifactId>
	<version>${revision}</version>
	<packaging>pom</packaging>

	<name>Galta</name>
	<description>Galta: a Java mono repo of reusable libraries - general-purpose utilities, a JSON library, Swing UI components, and GaltaJS, a JavaScript-inspired scripting engine for the JVM.</description>
	<url>https://github.com/monflabs/Galta-Java</url>

	<!--
		organization, licenses and developers come from monflabs-parent; url, scm
		and issueManagement are this repository's. The child.*.inherit.append.path
		attributes keep the url/scm values as they are instead of appending each
		module's artifactId.
	-->
	<scm child.scm.connection.inherit.append.path="false"
		child.scm.developerConnection.inherit.append.path="false"
		child.scm.url.inherit.append.path="false">
		<connection>scm:git:https://github.com/monflabs/Galta-Java.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/monflabs/Galta-Java.git</developerConnection>
		<url>https://github.com/monflabs/Galta-Java</url>
		<tag>HEAD</tag>
	</scm>

	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/monflabs/Galta-Java/issues</url>
	</issueManagement>

	<modules>
		<module>tools</module>
		<module>galta</module>
	</modules>

	<properties>
		<!-- The Galta version (Maven CI-friendly). When it changes, also update
		     monflabs-parent's literal version and this pom's parent version. -->
		<revision>0.8.0</revision>
	</properties>

	<profiles>
		<!--
			Maven Central release (mvn clean deploy -P central): the profile itself
			is defined in monflabs-parent; this adds the Galta specifics. Test,
			benchmark and sample modules are not published: they are listed here
			and set maven.deploy.skip themselves.
		-->
		<profile>
			<id>central</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<configuration>
							<deploymentName>Galta ${revision}</deploymentName>
							<excludeArtifacts>
								<!-- Keep in sync with the modules setting maven.deploy.skip -->
								<excludeArtifact>utilities-tests</excludeArtifact>
								<excludeArtifact>json-tests</excludeArtifact>
								<excludeArtifact>json-config-test</excludeArtifact>
								<excludeArtifact>json-performance</excludeArtifact>
								<excludeArtifact>utilities-performance</excludeArtifact>
								<excludeArtifact>js-performance</excludeArtifact>
								<excludeArtifact>js-all</excludeArtifact>
								<excludeArtifact>js-library-v8</excludeArtifact>
								<excludeArtifact>js-playground-cheerpj</excludeArtifact>
								<excludeArtifact>js-test-rhino</excludeArtifact>
								<excludeArtifact>js-test-suite</excludeArtifact>
								<excludeArtifact>js-test-test262</excludeArtifact>
								<excludeArtifact>js-transpiler-maven-tests</excludeArtifact>
							</excludeArtifacts>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
