	<artifactId>monflabs-parent</artifactId>
	<version>0.8.0</version>
	<packaging>pom</packaging>

	<name>Monflabs Parent</name>
	<description>Shared Maven parent of the Monflabs projects: Java level, third-party dependency versions, plugin versions and configuration, build rules and release profiles.</description>
