<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.monflabs.galta.tools</groupId>
		<artifactId>parent-tools-mixins</artifactId>
		<version>${revision}</version>
	</parent>

	<artifactId>mixin-javatools</artifactId>
	<name>Galta Java Tools Mixin</name>
	<description>Maven mixin carrying the Java compiler level and encoding used by every Galta module.</description>
	
	<packaging>pom</packaging>

	
	<!--
		https://github.com/odavid/maven-plugins/blob/master/mixin-maven-plugin/README.md
	-->

	<properties>
		<!--
			The DEFAULT Java version for Monflabs projects: Java 21. This mixin is injected by mixin-maven-plugin into each
			repository's root pom (Galta-Java, Galta-Java-Private, UbiGen,
			RestQL, DraftDB, Salesforce, Commerce, DeveloperToolbox), which is
			the only way to share PROPERTY values across poms that are
			aggregated rather than inherited - a BOM can share dependency
			versions but not properties (see monflabs-bom's own comment).

			A project's own root pom CAN override this by redeclaring
			maven.compiler in its own properties - a property inherited from a
			project's own parent beats a mixin-injected one (verified: with
			this set to 99 and a root pom's own override at 17, the whole tree
			under that root resolves 17). Galta-Java no longer does this; it
			takes this default directly.

			A project's own root pom is the ONLY place maven.compiler should
			ever be redeclared, if at all. Anywhere else, a local copy
			silently shadows this file and the value drifts - which is how 8
			poms once ended up each pinning their own.
		-->
		<maven.compiler>21</maven.compiler>
		<maven.compiler.source>${maven.compiler}</maven.compiler.source>
		<maven.compiler.target>${maven.compiler}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>
		
</project>
