# Root-level ignores only. Per-module ignores live in galta/.gitignore and
# tools/.gitignore - do not duplicate them here.

# Claude Code agent worktrees / session state.
# galta/.gitignore already covers galta/.claude/, but NOT this root one:
# gitignore patterns apply relative to the file that declares them.
# Worktree-isolated agents create a FULL repo copy per agent under
# .claude/worktrees/ (~1 GB each, including its own test262 checkout) and are
# not reliably cleaned up. Left untracked-but-unignored they also make
# Eclipse/m2e scan ~1000 duplicate pom.xml files on import and hang.
# If the IDE ever blocks importing this project, check `git worktree list`.
.claude/

# Eclipse metadata. galta/.gitignore and tools/.gitignore already ignore these
# one level down; the root copies were the sole exception and had been
# COMMITTED - a stale .project naming the root project "root", while m2e names
# it from the artifactId ("Galta-Java", which is what the workspace actually
# registers). Being tracked, it survived every clean and re-seeded a
# wrongly-named project on each fresh clone. Untracked 2026-08-30; the files
# stay on disk so the current Eclipse workspace keeps working.
.project
.classpath
.settings/

.DS_Store

# Generated by flatten-maven-plugin from the root pom (galta/ and tools/ ignore their own).
.flattened-pom.xml

# Generated into the documentation site by buildtools/build-site.sh, never committed
docs/api/
docs/playground/*.jar

# Build output of the standalone smoke-test project
smoke-test/target/
/target/
